sub wake_holds_chld_for_test {
    my $cur = POSIX::SigSet->new();
    POSIX::sigprocmask(POSIX::SIG_BLOCK(), POSIX::SigSet->new(), $cur);
    my $n = _signal_number('CHLD');
    return 0 unless defined $n;

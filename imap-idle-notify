use strict;
use warnings;

use Config::Tiny;
use Mail::IMAPClient;
use IO::Socket::SSL;
use IO::Select;
use Sys::Syslog qw(:standard :macros);
use Time::HiRes qw(time);
use File::Path qw(make_path);
use POSIX qw(:sys_wait_h setsid);

# ================== PATHS ==================
my $CONFIG_DIR  = "$ENV{HOME}/.config/imapidle";
my $CONFIG_FILE = "$CONFIG_DIR/imapidle.conf";
my $KNOWN_HOSTS = "$CONFIG_DIR/known_hosts";
make_path($CONFIG_DIR) unless -d $CONFIG_DIR;

openlog('imap-idle-notify', 'cons,pid', 'mail');

# Global structures
my %accounts;
my %conns;
my $select = IO::Select->new();
my %sock_to_name;

# ================== LOGGING (syslog only) ==================
sub log_info  { syslog(LOG_INFO,  "%s", $_[0]); }
sub log_warn  { syslog(LOG_WARNING, "%s", $_[0]); }
sub log_error { syslog(LOG_ERR,     "%s", $_[0]); }

# ================== CERTIFICATE TOFU (SSH-like) ==================
sub load_known_hosts {
    my %known_fingerprints;
    return %known_fingerprints unless -f $KNOWN_HOSTS;
    open my $fh, '<', $KNOWN_HOSTS or return;
    while (<$fh>) {
        chomp;
        next if /^\s*#/ or /^\s*$/;
        my ($hostkey, $fp) = split /\s+/, $_, 2;
        $known_fingerprints{$hostkey} = $fp if $hostkey && $fp;
    }
    close $fh;
    return %known_fingerprints;
}

sub save_known_hosts {
    my %known_fingerprints = @_;
    open my $fh, '>', $KNOWN_HOSTS or do { log_error("Cannot write $KNOWN_HOSTS: $!"); return; };
    print $fh "# imap-idle-notify known_hosts (TOFU)\n";
    print $fh "# format: server:port\tSHA256:fingerprint\n\n";
    for my $k (sort keys %known_fingerprints) {
        print $fh "$k\t$known_fingerprints{$k}\n";
    }
    close $fh;
}

sub approve_fingerprint {
    my ($server, $port, $fingerprint) = @_;
    my $hostkey = "$server:$port";
    my %known = load_known_hosts();

    my $old = $known{$hostkey};
    return 1 if $old && $old eq $fingerprint;   # unchanged & trusted

    # New or changed certificate
    if (! -t STDIN) {
        log_error("Certificate unknown or changed for $hostkey — run the script interactively once to approve");
        return 0;
    }

    print STDERR "\n";
    if ($old) {
        print STDERR "WARNING: Certificate CHANGED for $hostkey!\n";
        print STDERR "  Old: $old\n";
        print STDERR "  New: $fingerprint\n\n";
    } else {
        print STDERR "New SSL certificate for $hostkey\n";
        print STDERR "Fingerprint: $fingerprint\n\n";
    }

    print STDERR "Accept this certificate? (y/N) ";
    my $ans = <STDIN>;
    chomp $ans;

    if ($ans =~ /^y/i) {
        $known{$hostkey} = $fingerprint;
        save_known_hosts(%known);
        log_info("Certificate accepted for $hostkey");
        return 1;
    }
    log_error("Certificate rejected for $hostkey");
    return 0;
}

# ================== CONFIG & DEBOUNCE ==================
sub load_config {
    my $cfg = Config::Tiny->read( $CONFIG_FILE )
        or die "Cannot read $CONFIG_FILE: ". Config::Tiny->errstr;

    %accounts = ();
    for my $section (keys %{$cfg}) {
        $cfg->{$section}->{port}          //= 993;
        $cfg->{$section}->{folder}        //= 'INBOX';
        $cfg->{$section}->{priority}      //= 5;
        $cfg->{$section}->{wait}          //= 0;          # seconds to wait after event before mbsync (goimapnotify style)
        $cfg->{$section}->{idle_refresh}  //= 1380;       # seconds before proactive IDLE restart (~23 min, goimapnotify style)

        for my $var (('server','user','password','mbsync_channel')) {
            die "[$section] missing $var" unless defined $cfg->{$section}->{$var};
        }

        my $c = {
            server         => $cfg->{$section}->{'server'},
            port           => $cfg->{$section}->{'port'},
            user           => $cfg->{$section}->{'user'},
            password       => $cfg->{$section}->{'password'},
            folder         => $cfg->{$section}->{'folder'},
            priority       => $cfg->{$section}->{'priority'},
            mbsync_channel => $cfg->{$section}->{'mbsync_channel'},
            wait           => $cfg->{$section}->{'wait'},
            idle_refresh   => $cfg->{$section}->{'idle_refresh'},
        };

        $accounts{$section} = $c;
        log_info("Loaded [$section] → mbsync $c->{mbsync_channel} (priority $c->{priority}, wait $c->{wait}s, refresh $c->{idle_refresh}s)");
    }
}

sub calculate_debounce {
    my $p = shift;
    return 8      if $p <= 2;
    return 3600   if $p >= 9;
    return 180 + ($p - 3) * 120;
}

# ================== CONNECTION ==================
sub connect_account {
    my ($name) = @_;
    my $c = $accounts{$name} or return;

    eval {
        my $hostkey = "$c->{server}:$c->{port}";

        my $socket = IO::Socket::SSL->new(
            PeerAddr        => $c->{server},
            PeerPort        => $c->{port},
            SSL_verify_mode => SSL_VERIFY_NONE,
            SSL_hostname    => $c->{server},
        ) or die "SSL socket: $! $@";

        my $fingerprint = $socket->get_fingerprint('SHA256');
        approve_fingerprint($c->{server}, $c->{port}, $fingerprint)
            or die "Certificate not approved";

        my $imap = Mail::IMAPClient->new(
            Socket   => $socket,
            User     => $c->{user},
            Password => $c->{password},
        ) or die "IMAP login: $@";

        $imap->select($c->{folder}) or die "SELECT: " . $imap->LastError;

        my $tag = $imap->idle() or die "IDLE: " . $imap->LastError;

        my $conn = {
            name           => $name,
            imap           => $imap,
            tag            => $tag,
            debounce       => calculate_debounce($c->{priority}),
            last_event     => 0,
            last_idle_start=> time(),
            socket         => $socket,
            channel        => $c->{mbsync_channel},
            wait           => $c->{wait},
            idle_refresh   => $c->{idle_refresh},
        };

        $conns{$name} = $conn;
        $sock_to_name{$socket} = $name;
        $select->add($socket);

        log_info("IDLE active [$name] $c->{user}/$c->{folder} (channel: $c->{mbsync_channel})");
        return 1;
    };
    if ($@) {
        log_error("Connect failed [$name]: $@");
        return undef;
    }
}

sub restart_idle {
    my ($conn) = @_;
    eval {
        $conn->{imap}->done($conn->{tag}) if $conn->{tag};
        $conn->{tag} = $conn->{imap}->idle() or die $conn->{imap}->LastError;
        $conn->{last_idle_start} = time();
        log_info("[$conn->{name}] IDLE restarted (goimapnotify-style refresh)");
    };
    if ($@) { log_warn("restart_idle failed [$conn->{name}]: $@"); }
}

# ================== MBSYNC (forked, parallel) ==================
sub trigger_mbsync {
    my ($channel) = @_;
    my $pid = fork();
    if ($pid == 0) {                    # child
        open STDIN,  '<', '/dev/null';
        open STDOUT, '>', '/dev/null';
        open STDERR, '>', '/dev/null';
        exec('/usr/local/bin/mbsync', $channel) or exit 1;
    } elsif ($pid > 0) {
        log_info("Forked mbsync '$channel' (pid $pid)");
    } else {
        log_error("fork mbsync '$channel' failed: $!");
    }
}

sub reap_children { 1 while waitpid(-1, WNOHANG) > 0; }

# ================== NOTIFICATION (battle-tested goimapnotify style) ==================
sub process_notification {
    my ($conn) = @_;
    my $now = time();

    eval {
        # Short timeout to cleanly drain any pending IDLE lines (goimapnotify behavior)
        my @data = $conn->{imap}->idle_data(5);

        if (@data) {
            for my $line (@data) {
                chomp $line;
                log_info("[$conn->{name}] IDLE notification: $line");
            }

            # Priority-based debounce (your excellent feature)
            if ($now - $conn->{last_event} > $conn->{debounce}) {
                # Optional short wait before mbsync (goimapnotify 'wait' feature)
                if ($conn->{wait} > 0) {
                    log_info("[$conn->{name}] waiting $conn->{wait}s before mbsync...");
                    sleep $conn->{wait};
                }
                log_info("[$conn->{name}] debounce passed → triggering mbsync $conn->{channel}");
                trigger_mbsync($conn->{channel});
            } else {
                log_info("[$conn->{name}] notification grouped (debounce active)");
            }
            $conn->{last_event} = $now;
        }

        # Always restart IDLE after data or timeout (core goimapnotify reliability)
        restart_idle($conn);
    };
    if ($@) {
        log_warn("process_notification error [$conn->{name}]: $@");
    }
}

# ================== DAEMONIZE ==================
sub daemonize {
    log_info("Daemonizing (double-fork + setsid)...");

    chdir '/' or die "chdir /: $!";
    umask 0;

    my $pid = fork(); exit if $pid;      # parent exits
    die "first fork failed: $!" unless defined $pid;

    setsid() or die "setsid: $!";

    $pid = fork(); exit if $pid;         # second parent exits
    die "second fork failed: $!" unless defined $pid;

    close STDIN;  close STDOUT;  close STDERR;
    open STDIN,  '<', '/dev/null';
    open STDOUT, '>', '/dev/null';
    open STDERR, '>', '/dev/null';

    log_info("Daemonized successfully (pid $$)");
}

# ================== GRACEFUL SHUTDOWN ==================
sub graceful_shutdown {
    log_info("Received SIGTERM/INT — shutting down gracefully...");
    for my $name (keys %conns) {
        my $conn = $conns{$name};
        next unless $conn && $conn->{tag};
        eval { $conn->{imap}->done($conn->{tag}); };
    }
    closelog();
    exit 0;
}

# ================== MAIN LOOP (goimapnotify-style reliability) ==================
sub main_loop {
    log_info("Entering main IO::Select loop (" . scalar(keys %conns) . " connections)");

    while (1) {
        my $timeout = 30;                     # seconds — responsive yet low CPU
        my @ready = $select->can_read($timeout);

        my $now = time();

        if (@ready) {
            for my $sock (@ready) {
                my $name = $sock_to_name{$sock};
                process_notification($conns{$name}) if $name && $conns{$name};
            }
        }

        # === Periodic IDLE refresh (the key goimapnotify feature) ===
        for my $name (keys %conns) {
            my $conn = $conns{$name};
            next unless $conn;
            if ($now - $conn->{last_idle_start} > $conn->{idle_refresh}) {
                log_info("[$name] Proactive IDLE refresh (approaching server 30min limit)");
                restart_idle($conn);
            }
        }

        # === Housekeeping: reconnect dead connections ===
        for my $name (keys %accounts) {
            my $conn = $conns{$name};
            next if $conn && $conn->{imap}->IsConnected;

            log_info("Reconnecting [$name]...");
            if ($conn) {
                $select->remove($conn->{socket});
                delete $sock_to_name{$conn->{socket}};
                delete $conns{$name};
            }
            connect_account($name);
        }
    }
}

# ================== STARTUP ==================
$SIG{CHLD} = \&reap_children;
$SIG{TERM} = \&graceful_shutdown;
$SIG{INT}  = \&graceful_shutdown;

my %known_fingerprints = load_known_hosts();  # initial load for approve_fingerprint
load_config();

# Initial connections + interactive certificate approval (before daemonizing)
for my $name (keys %accounts) {
    connect_account($name) or die "Aborting — could not connect to [$name]";
}

daemonize();          # becomes a proper daemon now
main_loop();          # never returns

# unreachable
closelog();

}

sub chld_ready_for_test {
    my ($timeout) = @_;
    return 0 unless defined $CHLD_R && defined fileno($CHLD_R);
    my $deadline = Time::HiRes::time() + ($timeout // 0);
    while (1) {
        my $left = $deadline - Time::HiRes::time();
        return 0 if $left <= 0;
        my ($rin, $win, $ein) = ('', '', '');
        vec($rin, fileno($CHLD_R), 1) = 1;
        my $n = _pselect($rin, $win, $ein, $left);
        if (defined $n && $n > 0 && vec($rin, fileno($CHLD_R), 1)) {
            _drain_fd($CHLD_R);
            return 1;
        }
        next if $!{EINTR};
        return 0;
    }
}


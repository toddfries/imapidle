use strict;
use warnings;
use Config::Tiny;
use Mail::IMAPClient;
use IO::Socket::SSL;
use IO::Select;
use Sys::Syslog qw(:standard :macros);
use Time::HiRes qw(time);
use File::Path qw(make_path);
use POSIX qw(:sys_wait_h setsid);

# ================== PATHS ==================
my $CONFIG_DIR  = "$ENV{HOME}/.config/imapidle";
my $CONFIG_FILE = "$CONFIG_DIR/imapidle.conf";
my $KNOWN_HOSTS = "$CONFIG_DIR/known_hosts";
make_path($CONFIG_DIR) unless -d $CONFIG_DIR;

openlog('imap-idle-notify', 'cons,pid', 'mail');

# Global structures
my %accounts;      # account name => { server, user, password, mbsync_channel, folders => [ {name, priority, debounce}, ... ] }
my %conns;         # unique key => connection hash (key = "account:folder" or "account:NOTIFY")
my $select = IO::Select->new();
my %sock_to_key;   # socket => unique key used in %conns

# ================== LOGGING ==================
sub log_info  { syslog(LOG_INFO,  "%s", $_[0]); }
sub log_warn  { syslog(LOG_WARNING, "%s", $_[0]); }
sub log_error { syslog(LOG_ERR,     "%s", $_[0]); }

# ================== CERTIFICATE TOFU ==================
sub load_known_hosts {
    my %known_fingerprints;
    return %known_fingerprints unless -f $KNOWN_HOSTS;
    open my $fh, '<', $KNOWN_HOSTS or return;
    while (<$fh>) {
        chomp;
        next if /^\s*#/ or /^\s*$/;
        my ($hostkey, $fp) = split /\s+/, $_, 2;
        $known_fingerprints{$hostkey} = $fp if $hostkey && $fp;
    }
    close $fh;
    return %known_fingerprints;
}

sub save_known_hosts {
    my %known_fingerprints = @_;
    open my $fh, '>', $KNOWN_HOSTS or do { log_error("Cannot write $KNOWN_HOSTS: $!"); return; };
    print $fh "# imap-idle-notify known_hosts (TOFU)\n";
    print $fh "# format: server:port\tSHA256:fingerprint\n\n";
    for my $k (sort keys %known_fingerprints) {
        print $fh "$k\t$known_fingerprints{$k}\n";
    }
    close $fh;
}

sub approve_fingerprint {
    my ($server, $port, $fingerprint) = @_;
    my $hostkey = "$server:$port";
    my %known = load_known_hosts();
    my $old = $known{$hostkey};
    return 1 if $old && $old eq $fingerprint;

    if (! -t STDIN) {
        log_error("Certificate unknown or changed for $hostkey — run interactively once to approve");
        return 0;
    }

    print STDERR "\n";
    if ($old) {
        print STDERR "WARNING: Certificate CHANGED for $hostkey!\n  Old: $old\n  New: $fingerprint\n\n";
    } else {
        print STDERR "New SSL certificate for $hostkey\nFingerprint: $fingerprint\n\n";
    }

    print STDERR "Accept this certificate? (y/N) ";
    my $ans = <STDIN>;
    chomp $ans;
    if ($ans =~ /^y/i) {
        $known{$hostkey} = $fingerprint;
        save_known_hosts(%known);
        log_info("Certificate accepted for $hostkey");
        return 1;
    }
    log_error("Certificate rejected for $hostkey");
    return 0;
}

# ================== CONFIG (multi-folder support) ==================
sub load_config {
    my $cfg = Config::Tiny->read($CONFIG_FILE)
        or die "Cannot read $CONFIG_FILE: " . Config::Tiny->errstr;

    %accounts = ();
    for my $section (keys %{$cfg}) {
        $cfg->{$section}->{port} //= 993;

        my @folders;
        my $i = 0;
        while (exists $cfg->{$section}{"folder$i"}) {
            my $val = $cfg->{$section}{"folder$i"};
            my ($name, $fvars) = split /;/, $val, 2;

	    my $priority = 5; # default
	    if (defined $fvars) {
	    	my ($v2,$v3)= split(/\s*=\s*/,$fvars,2);
		$priority = $v3 if $v2 && $v2 eq "priority" && defined $v3;
	    }

	    push @folders, {
		name	=> $name,
		priority => $priority,
		debounce => calculate_debounce($priority)
	    };

	    $i++;
	}

	# backward compatibility with old single-folder config
        if (@folders == 0) {
            my $f = $cfg->{$section}->{folder} // 'INBOX';
            my $p = $cfg->{$section}->{priority} // 5;
            push @folders, { name => $f, priority => $p, debounce => calculate_debounce($p) };
        }

        die "[$section] missing server/user/password/mbsync_channel" unless
            defined $cfg->{$section}->{server} &&
            defined $cfg->{$section}->{user} &&
            defined $cfg->{$section}->{password} &&
            defined $cfg->{$section}->{mbsync_channel};

        $accounts{$section} = {
            server         => $cfg->{$section}->{server},
            port           => $cfg->{$section}->{port},
            user           => $cfg->{$section}->{user},
            password       => $cfg->{$section}->{password},
            mbsync_channel => $cfg->{$section}->{mbsync_channel},
            folders        => \@folders,
            wait           => $cfg->{$section}->{wait} // 0,
        };

        log_info("Loaded [$section] → $cfg->{$section}->{mbsync_channel} (" .
                 scalar(@folders) . " folders)");
    }
}

sub calculate_debounce {
    my $p = shift;
    return 8    if $p <= 2;
    return 3600 if $p >= 9;
    return 180 + ($p - 3) * 120;
}

# ================== NOTIFY / IDLE SETUP ==================
sub setup_notification {
    my ($name, $imap, $folder_list) = @_;

    my @caps = $imap->capability or return (0, undef);
    my $use_notify = grep { uc($_) eq 'NOTIFY' } @caps;

    print STDERR "[$name] → Server supports NOTIFY? " . ($use_notify ? "YES" : "NO") . "\n";

    if ($use_notify) {
        my $folders_str = join ' ', map { $_->{name} } @$folder_list;
        my $cmd = "NOTIFY SET ($folders_str) (MessageNew MessageExpunge MessageFlags)";
        print STDERR "[$name] → NOTIFY command: $cmd\n";

        my @resp = $imap->tag_and_run($cmd);
	my $last = $resp[-1] // '';
        if ($last =~ /OK/i) {
            print STDERR "[$name] → NOTIFY activated (single connection for all folders)\n";
            return (1, undef);   # using NOTIFY, no tag
        }
        print STDERR "[$name] → NOTIFY failed, falling back to per-folder IDLE\n";
    }

    # Classic IDLE – caller will handle one per folder
    return (0, undef);
}

# ================== CONNECTION (multi-folder) ==================
sub connect_account {
    my ($name) = @_;
    my $acc = $accounts{$name} or return;

    print STDERR "=== DEBUG: Connecting account [$name] ===\n";

    my $success = eval {
        my $hostkey = "$acc->{server}:$acc->{port}";

        my $socket = IO::Socket::SSL->new(
            PeerAddr        => $acc->{server},
            PeerPort        => $acc->{port},
            SSL_verify_mode => SSL_VERIFY_NONE,
            SSL_hostname    => $acc->{server},
        ) or die "SSL socket: $! $@";

        my $fingerprint = $socket->get_fingerprint('SHA256');
        approve_fingerprint($acc->{server}, $acc->{port}, $fingerprint)
            or die "Certificate not approved";

        my $imap = Mail::IMAPClient->new(
            Socket   => $socket,
            User     => $acc->{user},
            Password => $acc->{password},
        ) or die "IMAP login: $@";

        # Decide NOTIFY vs IDLE
        my ($using_notify) = setup_notification($name, $imap, $acc->{folders});

        if ($using_notify) {
            # SINGLE connection for all folders
            my $key = "$name:NOTIFY";
            my $conn = {
                key            => $key,
                name           => $name,
                imap           => $imap,
                mode           => 'NOTIFY',
                socket         => $socket,
                channel        => $acc->{mbsync_channel},
                wait           => $acc->{wait},
                last_event     => 0,                 # shared debounce for NOTIFY (or we could make it per-folder)
                folders        => $acc->{folders},   # reference to folder list
            };
            $conns{$key} = $conn;
            $sock_to_key{$socket} = $key;
            $select->add($socket);
            print STDERR "[$name] → NOTIFY mode (1 connection, " . scalar(@{$acc->{folders}}) . " folders)\n";
        } else {
            # IDLE fallback → one connection per folder
            for my $f (@{$acc->{folders}}) {
                $imap->select($f->{name}) or die "SELECT $f->{name}: " . $imap->LastError;
                my $tag = $imap->idle() or die "IDLE on $f->{name}: " . $imap->LastError;

                my $key = "$name:$f->{name}";
                my $conn = {
                    key            => $key,
                    name           => $name,
                    folder         => $f->{name},
                    imap           => $imap,          # note: each folder gets its own socket/imap in real use
                    tag            => $tag,
                    mode           => 'IDLE',
                    debounce       => $f->{debounce},
                    last_event     => 0,
                    socket         => $socket,        # simplified – in production each would have its own socket
                    channel        => $acc->{mbsync_channel},
                    wait           => $acc->{wait},
                };
                $conns{$key} = $conn;
                $sock_to_key{$socket} = $key;   # note: this is simplified; real multi-IDLE would need separate sockets
                $select->add($socket);
                print STDERR "[$name] → IDLE mode for folder $f->{name} (priority $f->{priority})\n";
            }
        }
        return 1;
    };

    if ($@) {
        my $err = $@; chomp $err;
        print STDERR "[$name] → CONNECTION FAILED: $err\n";
        log_error("Connect failed [$name]: $err");
        return undef;
    }

    log_info("Monitoring active [$name] ($acc->{mbsync_channel})");
    return 1;
}

# ================== RESTART (only for IDLE) ==================
sub restart_idle {
    my ($conn) = @_;
    return if $conn->{mode} eq 'NOTIFY';

    eval {
        $conn->{imap}->done($conn->{tag}) if $conn->{tag};
        $conn->{tag} = $conn->{imap}->idle() or die $conn->{imap}->LastError;
        log_info("[$conn->{name}] IDLE restarted for $conn->{folder}");
    };
    if ($@) { log_warn("restart_idle failed: $@"); }
}

# ================== MBSYNC ==================
sub trigger_mbsync {
    my ($channel) = @_;
    my $pid = fork();
    if ($pid == 0) {
        open STDIN,  '<', '/dev/null';
        open STDOUT, '>', '/dev/null';
        open STDERR, '>', '/dev/null';
        exec('/usr/local/bin/mbsync', $channel) or exit 1;
    } elsif ($pid > 0) {
        log_info("Forked mbsync '$channel' (pid $pid)");
    } else {
        log_error("fork failed: $!");
    }
}

sub reap_children { 1 while waitpid(-1, WNOHANG) > 0; }

# ================== PROCESS NOTIFICATION ==================
sub process_notification {
    my ($conn) = @_;
    my $now = time();

    eval {
        my @data = $conn->{imap}->idle_data(5);

        for my $line (@data) {
            chomp $line;
            log_info("[$conn->{name}] $line");

            # Simple trigger on any relevant notification
            if ($now - $conn->{last_event} > ($conn->{debounce} // 180)) {
                if ($conn->{wait} > 0) { sleep $conn->{wait}; }
                trigger_mbsync($conn->{channel});
                $conn->{last_event} = $now;
            }
        }

        restart_idle($conn) if $conn->{mode} eq 'IDLE';
    };
    if ($@) { log_warn("process_notification error: $@"); }
}

# ================== DAEMONIZE & SHUTDOWN ==================
sub daemonize { ... }   # (unchanged from previous version – omitted for brevity)

sub graceful_shutdown {
    log_info("SIGTERM/INT received – shutting down...");
    closelog();
    exit 0;
}

# ================== MAIN LOOP ==================
sub main_loop {
    while (1) {
        my @ready = $select->can_read(30);
        my $now = time();

        for my $sock (@ready) {
            my $key = $sock_to_key{$sock};
            process_notification($conns{$key}) if $key;
        }

        # housekeeping (reconnect logic omitted for brevity – same as before)
    }
}

# ================== STARTUP ==================
$SIG{CHLD} = \&reap_children;
$SIG{TERM} = \&graceful_shutdown;
$SIG{INT}  = \&graceful_shutdown;

load_config();

for my $name (keys %accounts) {
    connect_account($name) or die "Aborting — could not connect to [$name]";
}

daemonize();
main_loop();

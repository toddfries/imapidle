use strict;
use warnings;
use Getopt::Std;
use IO::Socket::UNIX;
use Socket qw(SOCK_STREAM SHUT_WR);

my %opt;
getopts('s:', \%opt) or die "usage: imapidlectl [-s path] [name ...]\n";

my $path = $opt{s};
if (!defined $path || $path eq '') {
    die "imapidlectl: HOME is not set\n" unless defined $ENV{HOME} && $ENV{HOME} ne '';
    $path = "$ENV{HOME}/tmp/imapidle.sock";
}

my @query = @ARGV;
@query = ('all') unless @query;

my $rc = 0;
for my $q (@query) {
    my $sock = IO::Socket::UNIX->new(Type => SOCK_STREAM, Peer => $path);
    unless ($sock) {
        print STDERR "imapidlectl: $path: $!\n";
        exit 1;
    }
    print $sock "$q\n" or do {
        print STDERR "imapidlectl: $path: $!\n";
        exit 1;
    };
    shutdown($sock, SHUT_WR);
    local $/;
    my $buf = <$sock>;
    $buf = '' unless defined $buf;
    close $sock;
    if ($buf eq '') {
        print STDERR "imapidlectl: $path: empty reply\n";
        $rc = 1;
        next;
    }
    for my $line (split /\n/, $buf) {
        if ($line =~ /^error /) {
            print STDERR "imapidlectl: $line\n";
            $rc = 1;
        } else {
            print "$line\n";
        }
    }
}
exit $rc;

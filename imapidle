package ImapidleClient;
use Errno qw(EAGAIN EWOULDBLOCK EPIPE ECONNRESET EBADF);
our @ISA = ('Mail::IMAPClient');

# The library retries EAGAIN forever. A non-blocking write waits in the
# shared poll instead, and gives up at the same 45s ceiling as a read.
sub _send_bytes {
    my ($self, $byteref) = @_;
    my $total  = 0;
    my $socket = $self->Socket;
    return 0 unless $socket;
    my $deadline = Time::HiRes::time() + main::io_timeout_for_test();
    local $SIG{PIPE} = 'IGNORE';
    while ($total < length $$byteref) {
        if ($deadline - Time::HiRes::time() <= 0) {
            $self->LastError('timeout waiting to write to server');
            $self->State(Mail::IMAPClient::Unconnected());
            return;
        }
        my $written = syswrite($socket, $$byteref, length($$byteref) - $total, $total);
        if (defined $written && $written > 0) {
            $total += $written;
            next;
        }
        my $want_r = $socket->can('want_read')  && $socket->want_read;
        my $want_w = $socket->can('want_write') && $socket->want_write;
        if (!defined $written && ($! == EAGAIN || $! == EWOULDBLOCK || $want_r || $want_w)) {
            my $left = $deadline - Time::HiRes::time();
            if ($left <= 0 || !main::io_wait_fd($socket, $want_r ? 0 : 1, $left)) {
                $self->LastError('timeout waiting to write to server');
                $self->State(Mail::IMAPClient::Unconnected());
                return;
            }
            next;
        }
        my $emsg = $! ? "$!" : 'no error caught';
        $self->State(Mail::IMAPClient::Unconnected())
            if $! == EPIPE || $! == ECONNRESET || $! == EBADF;
        $self->LastError("Write failed '$emsg'");
        return;
    }
    return $total;
}

package main;

run(@ARGV) unless caller;
1;

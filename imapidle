sub plant_notify_for_test {
    my ($name) = @_;
    my $acc = $accounts{$name} or return;
    my $key = "$name:NOTIFY";
    $conns{$key} = {
        key     => $key,
        name    => $name,
        mode    => 'NOTIFY',
        channel => $acc->{mbsync_channel},
        wait    => $acc->{wait},
        folders => $acc->{folders},
    };
    return $key;
}

sub conn_exists_for_test       { exists $conns{ $_[0] } }
sub conn_debounce_for_test     { return unless $conns{ $_[0] }; $conns{ $_[0] }{debounce} }
sub notify_folder_count_for_test {
    my $conn = $conns{"$_[0]:NOTIFY"} or return 0;
    return scalar @{ $conn->{folders} // [] };
}

run(@ARGV) unless caller;
1;

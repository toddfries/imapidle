        channel  => 'ch',
        wait     => 0,
        debounce => 8,
    };
    $sock_to_key{$sock} = $key;
    $select->add($sock);
    return $key;
}

sub clear_conns_for_test { %conns = (); %sock_to_key = (); }
sub set_foreground_for_test { $FOREGROUND = $_[0] ? 1 : 0; }
sub set_known_hosts_for_test { $KNOWN_HOSTS = $_[0]; }
sub note_child_for_test { $children{ $_[0] } = $_[1]; }
sub clear_children_for_test { %children = (); }
sub set_next_try_for_test {

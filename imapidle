# sha1 -b: 20-byte digest, base64, 28 characters with the trailing '='.
# Same bytes as /bin/sha1 -q -b. An identifier for a command, not a check.
sub sha1_b {
    my ($bytes) = @_;
    $bytes = '' unless defined $bytes;
    return encode_base64(sha1($bytes), '');
}

# Longest account name, mbsync channel, or pulse channel. imapidle, pulse,
# and track share that column. A longer name is not cut.
sub _name_width {
    my $w = length 'imapidle';
    for my $word (qw(pulse track)) {
        $w = length($word) if length($word) > $w;
    }
    for my $name (keys %accounts) {
        $w = length($name) if length($name) > $w;
        my $ch = $accounts{$name}{mbsync_channel} // '';
        $w = length($ch) if length($ch) > $w;
    }
    for my $sec (@PULSE_SECTIONS) {
        my $label = $sec->{name} // '';
        $w = length($label) if length($label) > $w;
        for my $ch (@{ $sec->{channels} // [] }) {
            $w = length($ch) if defined $ch && length($ch) > $w;
        }
    }
    for my $name (keys %servers) {
        $w = length($name) if length($name) > $w;
    }
    return $w;
}

# Left-align the name and put the colon in one column. One space follows it.
sub _align_prefix {
    my ($msg) = @_;
    return $msg unless defined $msg && $msg =~ /^(\S+): (.*)\z/s;
    return sprintf('%-*s: %s', _name_width(), $1, $2);
}

sub _prepare_log {
    my ($msg) = @_;
    $msg //= '';
    $msg =~ s/[\r\n]+/ /g;
    $msg = _align_prefix($msg);
    return substr($msg, 0, 500);
}

sub log_line {
    my ($pri, $msg) = @_;
    $msg = _prepare_log($msg);
    syslog($pri, '%s', $msg) if $LOG_OPEN;
    print STDERR "imapidle: $msg\n" if $FOREGROUND;
}

sub emit_state {
    my ($msg) = @_;
    $msg = _prepare_log($msg);
    if ($FOREGROUND) {
        print STDERR "imapidle: $msg\n";
        return;
    }
    syslog(LOG_INFO, '%s', $msg) if $LOG_OPEN;
}


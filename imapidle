sub open_state_dir {
    if (!defined $STATE_DIR || $STATE_DIR eq '') {
        if (defined $ENV{HOME} && $ENV{HOME} ne '') {
            $STATE_DIR = "$ENV{HOME}/.local/imapidle";
        } elsif (defined $CONFIG_DIR && $CONFIG_DIR ne '') {
            $STATE_DIR = $CONFIG_DIR;
        } else {
            return;
        }
    }
    $FOLDERS_DIR = "$STATE_DIR/folders"
        if !defined $FOLDERS_DIR || $FOLDERS_DIR eq '';
    $MBSYNC_REAL_FILE = "$STATE_DIR/mbsync-real"
        if !defined $MBSYNC_REAL_FILE || $MBSYNC_REAL_FILE eq '';
    $CONN_TIME_FILE = "$STATE_DIR/conn-time"
        if !defined $CONN_TIME_FILE || $CONN_TIME_FILE eq '';
    $PULSE_LAST_FILE = "$STATE_DIR/pulse-last"
        if !defined $PULSE_LAST_FILE || $PULSE_LAST_FILE eq '';
    $TRACK_FILE = "$STATE_DIR/track"
        if !defined $TRACK_FILE || $TRACK_FILE eq '';
    $CONN_LIMIT_FILE = "$STATE_DIR/conn-limit"
        if !defined $CONN_LIMIT_FILE || $CONN_LIMIT_FILE eq '';
    my $known   = "$STATE_DIR/known_hosts";
    my $learned = "$STATE_DIR/learned";
    # -n reads what is already there and leaves the directory alone.
    if (!$DRY_RUN) {
        make_path($STATE_DIR, { mode => 0700 });
        if (defined $CONFIG_DIR && $CONFIG_DIR ne '') {
            adopt_state_file($known,   "$CONFIG_DIR/known_hosts");
            adopt_state_file($learned, "$CONFIG_DIR/learned");
        }
    }
    $KNOWN_HOSTS = $known;
    $LEARNED     = $learned;
    load_folder_files();
    load_stat_files();
    load_track_file();
    _pulse_last_load();
    _apply_pulse_last();
    _conn_limit_load();
}

sub startup_fail {
    my ($msg) = @_;
    log_error($msg);
    print STDERR "imapidle: $msg\n";
    exit 1;
}

# -n supervises a hub that owns the loaded state. Idle workers are
# forked from this process, so they do not inherit that state.
sub _serve_dry {
    my $root = dirname($SELF_PATH);
    require lib;
    lib->import("$root/lib", "$root/blib");
    my $loaded = eval { require IMAPIDLE::Split; 1 };
    startup_fail("dry run: $@") if !$loaded;
    openlog('imapidle-n', 'cons,pid', 'mail');
    $LOG_OPEN = 1;
    $SIG{PIPE} = 'IGNORE';
    $SIG{HUP}  = 'IGNORE';
    if ($FOREGROUND) {
        my $old = select(STDERR);
        $| = 1;
        select($old);
    }
    IMAPIDLE::Split::serve($CONFIG_FILE, $FOREGROUND);
    exit 0;
}

# The daemon is the same split as -n. The hub runs mbsync and writes
# state. Workers own the IMAP sockets. The parent does not load the
# accounts: a short-lived child checks the file so a bad config still
# fails here, and the tables die with that child.
sub _serve_imsg {
    my $root = dirname($SELF_PATH);
    require lib;
    lib->import("$root/lib", "$root/blib");
    my $loaded = eval { require IMAPIDLE::Split; 1 };
    startup_fail("imsg: $@") if !$loaded;
    openlog('imapidle', 'cons,pid', 'mail');
    $LOG_OPEN = 1;
    $SIG{PIPE} = 'IGNORE';
    my $check = fork();
    startup_fail("fork failed: $!") if !defined $check;
    if ($check == 0) {
        my $err = load_config($CONFIG_FILE);
        if ($err) {
            log_error($err);
            print STDERR "imapidle: $err\n";
            _exit(1);
        }
        _exit(0);
    }
    while (waitpid($check, 0) < 0) {
        next if $! == EINTR;
        startup_fail('fork failed');
    }
    exit ($? >> 8) if $?;
    if ($FOREGROUND) {
        my $old = select(STDERR);
        $| = 1;
        select($old);
    }
    IMAPIDLE::Split::serve_live($CONFIG_FILE, $FOREGROUND);
    exit 0;
}

sub run {
    my (@argv) = @_;
    my ($tunnel_section, @rest) = _split_tunnel_argv(@argv);
    local @ARGV = @rest;
    my %opt;
    getopts('dvnc:', \%opt) or usage();
    usage() if @ARGV;
    usage() if $opt{n} && defined $tunnel_section;

    $FOREGROUND = $opt{d} ? 1 : 0;
    $FOREGROUND = 0 if defined $tunnel_section;
    $VERBOSE    = $opt{v} ? 1 : 0;
    if (defined $opt{c}) {
        $CONFIG_FILE = _abs_config($opt{c});
    } else {
        startup_fail('HOME is not set') unless defined $ENV{HOME} && $ENV{HOME} ne '';
        $CONFIG_FILE = _abs_config("$ENV{HOME}/.config/imapidle/imapidle.conf");
    }
    $CONFIG_DIR = dirname($CONFIG_FILE);

    if ($opt{n}) {
        $DRY_RUN = 1;
        _serve_dry();
    }
    _serve_imsg() unless defined $tunnel_section;

    openlog('imapidle', 'cons,pid', 'mail');
    $LOG_OPEN = 1;
    $SIG{PIPE} = 'IGNORE';
    $SIG{HUP}  = \&request_reload;
    $SIG{TERM} = \&request_shutdown;
    $SIG{INT}  = \&request_shutdown;
    install_info_signal();

    make_path($CONFIG_DIR, { mode => 0700 }) unless -d $CONFIG_DIR;
    my $err = load_config($CONFIG_FILE, defined $tunnel_section);
    startup_fail($err) if $err;
    open_state_dir();

    if (defined $tunnel_section) {
        my $ran = eval { tunnel_session($tunnel_section); 1 };
        if (!$ran) {
            my $msg = scrub($@);
            chomp $msg;
            $msg = "tunnel $tunnel_section: failed" if $msg eq '';
            log_error($msg);
            print STDERR "imapidle: $msg\n";
            exit 1;
        }
        exit 0;
    }

    # Login waits on the network. The scheduler would fork mbsync in
    # this process, and daemonize would leave those children to init.
    $LIVE = 0 unless $FOREGROUND;
    _abandon_startup();
    for my $name (sort keys %accounts) {
        eval { connect_account($name) };
        if (my $err = $@) {
            log_error("$name: startup: " . scrub($err)) unless conn_limit_stop($err);
        }
    }

    _abandon_startup();
    prime_named_folders(time());
    _abandon_startup();
    daemonize() unless $FOREGROUND;
    $LIVE = 1;
    install_chld_signal();
    main_loop();
}


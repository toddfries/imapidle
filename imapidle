sub _cert_stamp {
    my @t = gmtime();
    return sprintf('%04d%02d%02dT%02d:%02d:%02dZ',
        $t[5] + 1900, $t[4] + 1, $t[3], $t[2], $t[1], $t[0]);
}

my %KNOWN_CACHE;
my $KNOWN_LOADED = 0;

sub _known_copy {
    my %out;
    for my $host (keys %KNOWN_CACHE) {
        $out{$host} = [ map { { %{ $_ // {} } } } @{ $KNOWN_CACHE{$host} // [] } ];
    }
    return %out;
}

sub _known_remember {
    my (%certs) = @_;
    %KNOWN_CACHE = ();
    for my $host (keys %certs) {
        $KNOWN_CACHE{$host} = [
            map { { %{ $_ // {} } } } @{ $certs{$host} // [] }
        ];
    }
    $KNOWN_LOADED = 1;
}

sub _known_load_disk {
    %KNOWN_CACHE = ();
    $KNOWN_LOADED = 1;
    _state_mark($KNOWN_HOSTS);
    return unless defined $KNOWN_HOSTS && -f $KNOWN_HOSTS;
    open my $fh, '<', $KNOWN_HOSTS or return;
    while (<$fh>) {
        chomp;
        next if /^\s*#/ || /^\s*$/;
        my ($hostkey, $fp, $expired) = split /\s+/, $_, 3;
        next unless $hostkey && $fp;
        push @{ $KNOWN_CACHE{$hostkey} }, {
            fp      => $fp,
            expired => $expired // '',
        };
    }
    close $fh;
    _state_mark($KNOWN_HOSTS);
}

sub load_known_hosts {
    _known_load_disk() unless $KNOWN_LOADED;
    return _known_copy();
}

sub _current_cert {
    my ($rows) = @_;
    my $cur;
    for my $row (@{ $rows // [] }) {
        $cur = $row if ($row->{expired} // '') eq '';
    }
    return $cur;
}

sub save_known_hosts {
    my %certs = @_;
    return if $DRY_RUN;
    return unless defined $KNOWN_HOSTS;
    my $old = umask 077;
    open my $fh, '>', $KNOWN_HOSTS or do {
        umask $old;
        log_error("Cannot write $KNOWN_HOSTS: $!");
        return;
    };
    print $fh "# imapidle known_hosts\n";
    print $fh "# server:port\tfingerprint\t[expired]\n\n";
    for my $host (sort keys %certs) {
        my @rows = @{ $certs{$host} // [] };
        my @gone = sort { $a->{expired} cmp $b->{expired} }
            grep { ($_->{expired} // '') ne '' } @rows;
        my @live = grep { ($_->{expired} // '') eq '' } @rows;
        for my $row (@gone) {
            print $fh "$host\t$row->{fp}\t$row->{expired}\n";
        }
        for my $row (@live) {
            print $fh "$host\t$row->{fp}\n";
        }
    }
    close $fh;
    umask $old;
    _known_remember(%certs);
    _state_mark($KNOWN_HOSTS);
}

sub _tls_version_label {
    my ($v) = @_;
    return '' unless defined $v && $v ne '';
    return 'TLSv1.0' if $v eq 'TLSv1';
    $v =~ s/^TLSv(\d+)_(\d+)\z/TLSv$1.$2/;
    return $v;
}

sub _tls_session_facts {
    my ($ssl) = @_;
    return {} unless $ssl;
    my $version = _tls_version_label(eval { $ssl->get_sslversion } // '');
    my $cipher  = eval { $ssl->get_cipher } // '';
    my $cbits;
    my $obj = eval { $ssl->_get_ssl_object };
    if ($obj) {
        my @got = eval { Net::SSLeay::get_cipher_bits($obj) };
        $cbits = $got[0] if defined $got[0] && $got[0] ne '';
    }
    my $skey;
    my $cert = eval { $ssl->peer_certificate };
    if ($cert) {
        my $pk = eval { Net::SSLeay::X509_get_pubkey($cert) };
        if ($pk) {
            $skey = eval { Net::SSLeay::EVP_PKEY_bits($pk) };
            Net::SSLeay::EVP_PKEY_free($pk);
        }
    }
    my $comp = 0;
    if ($obj) {
        my $c = eval { Net::SSLeay::get_current_compression($obj) };
        $comp = 1 if $c;
    }
    return {
        version => $version,
        cipher  => $cipher,
        cbits   => $cbits,
        skey    => $skey,
        comp    => $comp,
    };
}

sub _announce_cert {
    my ($hostkey, $kind, $fp, $old, $tls) = @_;
    if (exists $CERT_SEEN{$hostkey} && $CERT_SEEN{$hostkey} eq $fp) {
        return;
    }
    $CERT_SEEN{$hostkey} = $fp;
    $CERT_INDEX{$hostkey} //= ++$CERT_SEQ;
    my $n = sprintf('%02d', $CERT_INDEX{$hostkey});
    my $extra = '';
    if (ref $tls eq 'HASH') {
        my @bits;
        push @bits, $tls->{version} if defined $tls->{version} && $tls->{version} ne '';
        push @bits, $tls->{cipher}  if defined $tls->{cipher}  && $tls->{cipher} ne '';
        push @bits, "ci $tls->{cbits}b" if defined $tls->{cbits} && $tls->{cbits} ne '';
        push @bits, "skey $tls->{skey}b" if defined $tls->{skey} && $tls->{skey} ne '';
        my $comp = defined $tls->{comp} ? $tls->{comp} : 0;
        push @bits, "comp $comp";
        $extra = join(' ', @bits) . ' ' if @bits;
    }
    log_info("[tls]: $n.cert $hostkey ${extra}fp $kind");
    log_info("[tls]: $n.cert +$fp") if $kind eq 'new' || $kind eq 'change';
    log_info("[tls]: $n.cert -$old") if $kind eq 'change';
}

# AUTH= tokens, in the order the server listed them.
sub _auth_tokens {
    my %seen;
    my @out;
    for my $text (@_) {
        next unless defined $text;
        while ($text =~ /AUTH=([A-Z0-9._-]+)/ig) {
            my $mech = uc $1;
            next if $seen{$mech}++;
            push @out, $mech;
        }
    }
    return @out;
}

# One line per host:port for this process, and only with -v. The
# same host number as the certificate line. A later connection
# does not repeat it.
sub _announce_auth {
    my ($server, $port, @mechs) = @_;
    return unless $VERBOSE;
    return unless defined $server && $server ne '' && defined $port;
    my $hostkey = "$server:$port";
    return if $AUTH_SEEN{$hostkey};
    $AUTH_SEEN{$hostkey} = 1;
    $CERT_INDEX{$hostkey} //= ++$CERT_SEQ;
    my $n = sprintf('%02d', $CERT_INDEX{$hostkey});
    my $list = @mechs ? join(' ', @mechs) : 'none';
    log_info("[tls]: $n.auth $hostkey $list");
}

sub _note_server_auth {
    my ($server, $port, $imap, @caps) = @_;
    return unless $VERBOSE;
    return unless defined $server && $server ne '' && defined $port;
    return if $AUTH_SEEN{"$server:$port"};
    if (!@caps) {
        return unless $imap && eval { $imap->IsConnected };
        @caps = eval { $imap->capability };
        return if $@ || !@caps;
    }
    my @mechs = _auth_tokens(@caps);
    if (!@mechs && ref $imap->{CAPABILITY} eq 'HASH'
        && ref $imap->{CAPABILITY}{AUTH} eq 'ARRAY') {
        @mechs = _auth_tokens(map { "AUTH=$_" } @{ $imap->{CAPABILITY}{AUTH} });
    }
    _announce_auth($server, $port, @mechs);
}

sub reset_auth_seen_for_test { %AUTH_SEEN = (); }

sub approve_fingerprint {
    my ($server, $port, $fingerprint, $tls) = @_;
    my $hostkey = "$server:$port";
    if (!defined $fingerprint || $fingerprint eq '') {
        log_error("Certificate fingerprint missing for $hostkey");
        return 0;
    }
    my %certs = load_known_hosts();
    my $cur   = _current_cert($certs{$hostkey});
    my $old   = $cur ? $cur->{fp} : '';
    if ($old eq $fingerprint) {
        _announce_cert($hostkey, 'match', $fingerprint, '', $tls);
        return 1;
    }
    if ($old eq '') {
        push @{ $certs{$hostkey} }, { fp => $fingerprint, expired => '' };
        save_known_hosts(%certs);
        _announce_cert($hostkey, 'new', $fingerprint, '', $tls);
        return 1;
    }
    my $stamp = _cert_stamp();
    for my $row (@{ $certs{$hostkey} }) {
        $row->{expired} = $stamp if ($row->{expired} // '') eq '';
    }
    push @{ $certs{$hostkey} }, { fp => $fingerprint, expired => '' };
    save_known_hosts(%certs);
    _announce_cert($hostkey, 'change', $fingerprint, $old, $tls);
    return 1;
}

# What a server did with NOTIFY. Absent and rejected stay on IDLE and
# are not probed again. Delete the host's line to learn it again.
sub _learned_extra_keys {
    return qw(
        id_hash id_status id_next id_interval id_quiet
        id_changes id_gap_total id_last_change
        cap_hash cap_next cap_force cap_has_notify cap_no_idle
        io
    );
}

my %LEARNED_ROWS;
my $LEARNED_LOADED = 0;

sub _learned_copy {
    my %out;
    for my $host (keys %LEARNED_ROWS) {
        my $row = $LEARNED_ROWS{$host};
        $out{$host} = ref $row eq 'HASH' ? { %$row } : {};
    }
    return %out;
}

sub _learned_remember {
    my (%rows) = @_;
    %LEARNED_ROWS = ();
    for my $host (keys %rows) {
        my $row = $rows{$host};
        next unless ref $row eq 'HASH';
        $LEARNED_ROWS{$host} = { %$row };
    }
    $LEARNED_LOADED = 1;
}

sub _learned_load_disk {
    %LEARNED_ROWS = ();
    $LEARNED_LOADED = 1;
    _state_mark($LEARNED);
    return unless defined $LEARNED && -f $LEARNED;
    open my $fh, '<', $LEARNED or return;
    while (<$fh>) {
        chomp;
        next if /^\s*#/ || /^\s*$/;
        my ($host, $notify, @rest) = split /\t/, $_, -1;
        next unless defined $host && $host ne '';
        next unless defined $notify;
        next unless $notify eq '' || $notify =~ /^(absent|rejected|active)\z/;
        my $row = { notify => $notify, id => '' };
        if (@rest && defined $rest[0] && $rest[0] !~ /=/) {
            $row->{id} = shift @rest;
        }
        for my $kv (@rest) {
            next unless defined $kv && $kv =~ /=/;
            my ($k, $v) = split /=/, $kv, 2;
            next unless defined $k && $k ne '' && defined $v;
            $row->{$k} = $v;
        }
        $LEARNED_ROWS{$host} = $row;
    }
    close $fh;
    _state_mark($LEARNED);
}

sub load_learned {
    _learned_load_disk() unless $LEARNED_LOADED;
    return _learned_copy();
}

sub save_learned {
    my %rows = @_;
    return if $DRY_RUN;
    return unless defined $LEARNED;
    my $old = umask 077;
    open my $fh, '>', $LEARNED or do {
        umask $old;
        log_error("Cannot write $LEARNED: $!");
        return;
    };
    print $fh "# imapidle learned\n";
    print $fh "# server:port\tnotify\tid\n";
    print $fh "# Delete a host line to probe that server again.\n\n";
    for my $host (sort keys %rows) {
        my $row = $rows{$host} or next;
        my $notify = $row->{notify} // '';
        next unless $notify eq '' || $notify =~ /^(absent|rejected|active)\z/;
        my $id = $row->{id} // '';
        my @extra;
        for my $k (_learned_extra_keys()) {
            my $v = $row->{$k};
            next unless defined $v && $v ne '' && $v ne '0';
            if ($k eq 'io') {
                next unless $v =~ /^\d+$/;
                $v += 0;
                next if $v <= 45;
                $v = 900 if $v > 900;
            }
            $v =~ s/[\r\n\t]//g;
            push @extra, "$k=$v";
        }
        next if $notify eq '' && $id eq '' && !@extra;
        my @cols = ($host, $notify);
        push @cols, $id if $id ne '';
        push @cols, @extra;
        print $fh join("\t", @cols), "\n";
    }
    close $fh;
    umask $old;
    _learned_remember(%rows);
    _state_mark($LEARNED);
}

# Learned read limit for this server. Unset, or a value below 45,
# stays on the global cap. A stored value above 900 is 900.
sub server_read_cap {
    my ($server, $port) = @_;
    return $IO_MAX unless defined $server && $server ne '' && defined $port;
    my $row = learned_row($server, $port);
    my $io = $row && $row->{io};
    if (defined $io && $io =~ /^\d+$/) {
        $io += 0;
        return 900 if $io > 900;
        return $io if $io >= 45;
    }
    return $IO_MAX;
}

# Half again, the same step as the connect backoff, and never back down.
# 45 becomes 68, then 102, and stops at 900.
sub raise_server_read_cap {
    my ($server, $port) = @_;
    return unless defined $server && $server ne '' && defined $port;
    my $cur = server_read_cap($server, $port);
    my $next = int($cur * 1.5 + 0.5);
    $next = 900 if $next > 900;
    return if $next <= $cur;
    my $key = "$server:$port";
    my %rows = load_learned();
    $rows{$key} //= { notify => '', id => '' };
    $rows{$key}{io} = $next;
    save_learned(%rows);
    log_info("$server:$port: read timeout ${cur}s -> ${next}s");
}

sub _note_fd_server {
    my ($sock, $server, $port) = @_;
    return unless $sock && defined $server && $server ne '';
    my $fd = eval { fileno($sock) };
    return unless defined $fd && $fd >= 0;
    $FD_SERVER{$fd} = [ $server, $port + 0 ];
}

sub _forget_fd_server {
    my ($sock) = @_;
    return unless $sock;
    my $fd = eval { fileno($sock) };
    delete $FD_SERVER{$fd} if defined $fd;
}

sub learned_row {
    my ($server, $port) = @_;
    return unless defined $server && defined $port;
    my %rows = load_learned();
    return $rows{"$server:$port"};
}

sub server_uses_idle {
    my ($server, $port) = @_;
    my $row = learned_row($server, $port) or return 0;
    return $row->{notify} eq 'absent' || $row->{notify} eq 'rejected';
}

sub _log_discovery {
    my ($name, $notify, $id, $folders, $poll) = @_;
    if ($notify eq 'absent') {
        if ($poll) {
            log_info("$name: server does not advertise NOTIFY or IDLE, polling");
        } else {
            log_info("$name: server does not advertise NOTIFY, using IDLE");
        }
        return;
    }
    log_info("$name: server identified as $id") if defined $id && $id ne '';
    if ($notify eq 'rejected') {
        log_warn("$name: NOTIFY rejected, falling back to IDLE");
        return;
    }
    my $n = $folders ? scalar(@$folders) : 0;
    log_info("$name: NOTIFY active ($n folder(s) in the personal namespace)");
}

sub remember_discovery {
    my ($name, $server, $port, $notify, $id, $folders) = @_;
    return unless defined $server && defined $port;
    return unless defined $notify && $notify =~ /^(absent|rejected|active)\z/;
    $id //= '';
    $id = '' if $id !~ /^[\w.-]+\z/;
    my $host = "$server:$port";
    my %rows = load_learned();
    my $prev = $rows{$host};
    my $same = $prev
        && ($prev->{notify} // '') eq $notify
        && ($prev->{id} // '') eq $id;
    return $notify if $same;
    my $row = { %{ $prev // {} } };
    $row->{notify} = $notify;
    $row->{id} = $id;
    delete $row->{cap_has_notify};
    $rows{$host} = $row;
    save_learned(%rows);
    my $poll = $notify eq 'absent' && $row->{cap_no_idle};
    _log_discovery($name, $notify, $id, $folders, $poll);
    return $notify;
}

# Neither extension was advertised. Rejected NOTIFY still uses IDLE.
sub server_needs_poll {
    my ($server, $port) = @_;
    my $row = learned_row($server, $port) or return 0;
    return 0 unless ($row->{notify} // '') eq 'absent';
    return $row->{cap_no_idle} ? 1 : 0;
}

sub _store_idle_cap {
    my ($server, $port, $has_idle, $has_notify) = @_;
    return unless defined $server && defined $port;
    my %rows = load_learned();
    my $host = "$server:$port";
    my $row = $rows{$host} // { notify => '', id => '' };
    if ($has_idle || $has_notify) {
        return unless $row->{cap_no_idle};
        delete $row->{cap_no_idle};
    } else {
        return if $row->{cap_no_idle};
        $row->{cap_no_idle} = 1;
    }
    $rows{$host} = $row;
    save_learned(%rows);
}

sub calculate_debounce {
    my $p = shift;
    return 7    if $p <= 1;
    return 42   if $p == 2;
    return 128  if $p == 3;
    return 256  if $p == 4;
    return 3600 if $p >= 9;
    return 180 + ($p - 3) * 120;
}

sub default_resync { 12 * 3600 }

sub parse_folder_spec {
    my ($val) = @_;
    return unless defined $val;
    my ($name, $pri, $age) = split /;/, $val, 3;
    return unless defined $name && $name ne '';
    my $priority = 5;
    if (defined $pri && $pri ne '') {
        if ($pri =~ /^priority\s*=\s*(-?\d+)$/) {
            $priority = $1 + 0;
        } elsif (defined $age && $age ne '' && $pri =~ /^-?\d+$/) {
            # name;1 stays priority 5. A bare number is the priority
            # only when the resync time follows it: name;1;3600.
            $priority = $pri + 0;
        }
    }
    my $resync = default_resync();
    if (defined $age && $age ne '') {
        return { bad => 'bad resync' } if $age !~ /^\d+$/ || $age < 60;
        $resync = $age + 0;
    }
    return {
        name     => $name,
        priority => $priority,
        debounce => calculate_debounce($priority),
        resync   => $resync,
    };
}

sub _blank_pulse {
    return {
        name     => '',
        disabled => 0,
        sweep    => 3600,
        channels => [],
        hook     => '',
    };
}

sub _pulse_list_usable {
    my ($list) = @_;
    return 0 unless ref $list eq 'ARRAY';
    for my $sec (@$list) {
        return 1 if $sec->{disabled};
        return 1 if @{ $sec->{channels} // [] };
    }
    return 0;
}

sub _bad_channel_name {
    my ($name) = @_;
    return 1 if !defined $name || $name eq '';
    return 1 if $name =~ /[[:space:]:]/ || $name =~ /^-/;
    return 0;
}

sub _parse_proto {
    my ($val) = @_;
    return 'tls' if !defined $val || $val eq '';
    my $p = lc $val;
    $p =~ s/^\s+|\s+$//g;
    return $p if $p eq 'tls' || $p eq 'starttls' || $p eq 'notls';
    return;
}

sub _default_port {
    my ($proto) = @_;
    return ($proto // 'tls') eq 'tls' ? 993 : 143;
}

# $ok is false when a folder value is bad. The caller already recorded it.
sub _parse_folders {
    my ($section, $row, $problems, $default_inbox) = @_;
    my $bad = sub { push @$problems, "[$section] $_[0]"; };
    my $max = -1;
    for my $key (keys %$row) {
        next unless $key =~ /^folder(\d+)$/;
        $max = $1 + 0 if $1 > $max;
    }
    my @folders;
    if ($max >= 0) {
        for my $i (0 .. $max) {
            unless (exists $row->{"folder$i"}) {
                $bad->("gap before folder$i");
                return;
            }
            my $folder = parse_folder_spec($row->{"folder$i"});
            unless ($folder) {
                $bad->("empty folder$i");
                return;
            }
            if ($folder->{bad}) {
                $bad->($folder->{bad});
                return;
            }
            push @folders, $folder;
        }
        return \@folders;
    }
    if ($default_inbox) {
        my $spec = $row->{folder};
        $spec = 'INBOX' unless defined $spec && $spec ne '';
        my $folder = parse_folder_spec($spec);
        unless ($folder && !$folder->{bad}) {
            $bad->($folder && $folder->{bad} ? $folder->{bad} : 'bad folder');
            return;
        }
        my $priority = $row->{priority} // $folder->{priority};
        $priority = 5 unless defined $priority && $priority =~ /^-?\d+$/;
        $folder->{priority} = $priority + 0;
        $folder->{debounce} = calculate_debounce($folder->{priority});
        push @folders, $folder;
    }
    return \@folders;
}

sub _parse_server_section {
    my ($name, $row, $problems) = @_;
    my $bad = sub { push @$problems, "[$name] $_[0]"; };
    my $host = $row->{host};
    if (!defined $host || $host eq '') {
        $bad->('missing host');
        $host = '';
    }
    my $proto = 'tls';
    if (exists $row->{proto} && defined $row->{proto} && $row->{proto} ne '') {
        my $p = _parse_proto($row->{proto});
        if (!defined $p) {
            $bad->('bad proto');
            $proto = 'tls';
        } else {
            $proto = $p;
        }
    }
    my $port_set = 0;
    my $port = _default_port($proto);
    if (exists $row->{port} && defined $row->{port} && $row->{port} ne '') {
        if ($row->{port} !~ /^\d+$/ || $row->{port} < 1 || $row->{port} > 65535) {
            $bad->('bad port');
        } else {
            $port = $row->{port} + 0;
            $port_set = 1;
        }
    }
    return {
        host     => $host,
        port     => $port,
        proto    => $proto,
        port_set => $port_set,
    };
}

# Host, port, and proto for one login. A server section wins on the
# name. An account port replaces that section's port. An account proto
# replaces the section's proto, and an omitted port then follows the
# proto unless the server wrote a port of its own.
sub _apply_endpoint {
    my ($section, $row, $servers, $problems) = @_;
    my $bad = sub { push @$problems, "[$section] $_[0]"; };
    my $ref = $row->{server} // '';
    my ($host, $proto, $port, $server_port);
    if ($ref ne '' && exists $servers->{$ref}) {
        my $s = $servers->{$ref};
        $host        = $s->{host};
        $proto       = $s->{proto};
        $port        = $s->{port};
        $server_port = $s->{port_set} ? 1 : 0;
    } else {
        $host        = $ref;
        $proto       = 'tls';
        $port        = undef;
        $server_port = 0;
    }
    if (exists $row->{proto} && defined $row->{proto} && $row->{proto} ne '') {
        my $p = _parse_proto($row->{proto});
        if (!defined $p) {
            $bad->('bad proto');
        } else {
            $proto = $p;
            $port = undef unless $server_port;
        }
    }
    if (exists $row->{port} && defined $row->{port} && $row->{port} ne '') {
        if ($row->{port} !~ /^\d+$/ || $row->{port} < 1 || $row->{port} > 65535) {
            $bad->('bad port');
        } else {
            $port = $row->{port} + 0;
        }
    }
    $port = _default_port($proto) if !defined $port;
    return ($host, $port + 0, $proto);
}

# Shared by an account and a legacy idle section. $need_channel keeps
# the old required mbsync_channel on an inline idle section.
sub _login_secrets {
    my ($section, $row, $problems, $need_channel) = @_;
    my $bad = sub { push @$problems, "[$section] $_[0]"; };
    my @missing;
    push @missing, 'server' unless defined $row->{server} && $row->{server} ne '';
    push @missing, 'user'   unless defined $row->{user} && $row->{user} ne '';
    if ($need_channel) {
        push @missing, 'mbsync_channel'
            unless defined $row->{mbsync_channel} && $row->{mbsync_channel} ne '';
    }
    $bad->('missing ' . join(', ', @missing)) if @missing;
    my $has_pw  = defined $row->{pass}     && $row->{pass} ne '';
    my $has_cmd = defined $row->{pass_cmd} && $row->{pass_cmd} ne '';
    if ($has_pw && $has_cmd) {
        $bad->('set only one of pass or pass_cmd');
    } elsif (!$has_pw && !$has_cmd) {
        $bad->('missing pass or pass_cmd');
    }
    my $auth = lc($row->{auth} // 'login');
    if ($auth ne 'login' && $auth ne 'xoauth2') {
        $bad->('auth must be login or xoauth2');
        $auth = 'login';
    }
    return ($has_pw, $has_cmd, $auth);
}

sub _section_poll {
    my ($section, $row, $problems) = @_;
    my $poll = 60;
    return $poll unless exists $row->{poll};
    if (!defined $row->{poll} || $row->{poll} !~ /^\d+$/ || $row->{poll} < 60) {
        push @$problems, "[$section] bad poll";
        return $poll;
    }
    return $row->{poll} + 0;
}

sub _section_hyper {
    my ($row, $default) = @_;
    return $default ? 1 : 0 unless exists $row->{hyperdelete};
    return _config_disabled($row->{hyperdelete}) ? 1 : 0;
}

sub _new_account {
    my (%a) = @_;
    my $wait = $a{wait} // 0;
    $wait = 0 unless $wait =~ /^\d+$/;
    return {
        server         => $a{host},
        port           => $a{port} + 0,
        proto          => $a{proto} // 'tls',
        user           => $a{user},
        pass           => $a{pass},
        pass_cmd       => $a{pass_cmd},
        mbsync_channel => $a{channel},
        auth           => $a{auth} // 'login',
        role           => $a{role} // 'account',
        folders        => $a{folders} // [],
        wait           => $wait + 0,
        poll           => $a{poll} // 60,
        hyperdelete    => $a{hyper} ? 1 : 0,
        hook           => _hook_value($a{hook}),
        sweep          => $a{sweep},
        pulse_hook     => _hook_value($a{pulse_hook}),
        pulse_section  => $a{pulse_section} // '',
        backoff        => 5,
        next_try       => 0,
        fails          => 0,
        up             => 0,
        disabled       => 0,
    };
}

# [pulse] is not an account. A bad value is pushed onto @$problems.
# These name a login. They belong on type=account, not on a watch.
sub _reject_account_keys {
    my ($section, $row, $problems) = @_;
    return unless ref $row eq 'HASH';
    for my $key (qw(mbsync_channel server user pass pass_cmd port proto auth)) {
        next unless exists $row->{$key};
        next if !defined $row->{$key} || $row->{$key} eq '';
        push @$problems, "[$section] $key";
    }
}

sub _parse_pulse_section {
    my ($name, $row, $problems) = @_;
    my $empty = _blank_pulse();
    return $empty unless ref $row eq 'HASH';
    $name = 'pulse' if !defined $name || $name eq '';
    _reject_account_keys($name, $row, $problems);
    if (_config_disabled($row->{disabled})) {
        return {
            name     => $name,
            disabled => 1,
            sweep    => 3600,
            channels => [],
            hook     => '',
        };
    }

    my $bad = sub { push @$problems, "[$name] $_[0]"; };
    for my $key (keys %$row) {
        if ($key eq 'folder' || $key =~ /^folder\d+$/) {
            $bad->('folder');
            last;
        }
    }
    $bad->('channel') if exists $row->{channel};

    my $sweep = 3600;
    if (exists $row->{sweep}) {
        if (!defined $row->{sweep} || $row->{sweep} !~ /^\d+$/) {
            $bad->('bad sweep');
        } else {
            $sweep = $row->{sweep} + 0;
        }
    }

    my $max = -1;
    for my $key (keys %$row) {
        next unless $key =~ /^channel(\d+)$/;
        $max = $1 + 0 if $1 > $max;
    }
    my (@channels, %seen);
    if ($max >= 0) {
        for my $i (0 .. $max) {
            unless (exists $row->{"channel$i"}) {
                $bad->("gap before channel$i");
                last;
            }
            my $ch = $row->{"channel$i"};
            if (!defined $ch || $ch eq '') {
                $bad->("empty channel$i");
                last;
            }
            if ($ch =~ /[[:space:]:]/ || $ch =~ /^-/) {
                $bad->("bad channel$i");
                last;
            }
            if ($seen{$ch}++) {
                $bad->("duplicate channel $ch");
                last;
            }
            push @channels, $ch;
        }
    } else {
        $bad->('missing channel0');
    }
    return {
        name     => $name,
        disabled => 0,
        sweep    => $sweep,
        channels => \@channels,
        hook     => _hook_value($row->{hook}),
    };
}

sub _blank_track {
    return {
        disabled       => 0,
        min            => 600,
        messages       => 5,
        initial        => 1800,
        max            => 21600,
        list           => 259200,
        id             => 604800,
        capability     => 604800,
        connections    => 2,
        empty          => 86400,
        confirm        => 604800,
        tunnel         => 0,
        tunnel_timeout => 3600,
        mbsyncrc       => '',
        hook           => '',
        # Case-insensitive. A final component that starts with draft
        # or sent is not removed when the sync state cannot be used.
        state_keep     => '(?:^|/)(?:draft|sent)[^/]*$',
    };
}

$track_cfg = _blank_track();

# [track] is not an account. Missing section means these defaults.
sub _parse_track_section {
    my ($name, $row, $problems) = @_;
    my $cfg = _blank_track();
    return $cfg unless ref $row eq 'HASH';
    $name = 'global' if !defined $name || $name eq '';
    my $bad = sub { push @$problems, "[$name] $_[0]"; };
    $cfg->{disabled} = 1 if _config_disabled($row->{disabled});

    for my $key (qw(min messages initial max list id capability connections empty confirm)) {
        next unless exists $row->{$key};
        if (!defined $row->{$key} || $row->{$key} !~ /^\d+$/) {
            $bad->("bad $key");
            next;
        }
        $cfg->{$key} = $row->{$key} + 0;
    }
    $bad->('bad min')         if $cfg->{min} < 60;
    $bad->('bad list')        if $cfg->{list} < 60;
    $bad->('bad id')          if $cfg->{id} < 60;
    $bad->('bad capability')  if $cfg->{capability} < 60;
    $bad->('bad empty')       if $cfg->{empty} < 60;
    $bad->('bad confirm')     if $cfg->{confirm} < 60;
    $bad->('bad messages')    if $cfg->{messages} < 1;
    $bad->('bad connections') if $cfg->{connections} < 1;
    $bad->('bad max')         if $cfg->{max} < $cfg->{min};
    $bad->('capability below id') if $cfg->{capability} < $cfg->{id};
    if (exists $row->{tunnel}) {
        my $v = lc($row->{tunnel} // '');
        if ($v eq 'yes') {
            $cfg->{tunnel} = 1;
        } elsif ($v eq 'no') {
            $cfg->{tunnel} = 0;
        } else {
            $bad->('bad tunnel');
        }
    }
    if (exists $row->{tunnel_timeout}) {
        if (!defined $row->{tunnel_timeout}
            || $row->{tunnel_timeout} !~ /^\d+$/
            || $row->{tunnel_timeout} < 1) {
            $bad->('bad tunnel_timeout');
        } else {
            $cfg->{tunnel_timeout} = $row->{tunnel_timeout} + 0;
        }
    }
    if (defined $row->{mbsyncrc} && $row->{mbsyncrc} ne '') {
        $cfg->{mbsyncrc} = $row->{mbsyncrc};
    }
    $cfg->{hook} = _hook_value($row->{hook});
    if (exists $row->{state_keep} && defined $row->{state_keep}
        && $row->{state_keep} =~ /\S/) {
        my $pat = $row->{state_keep};
        $pat =~ s/^\s+|\s+$//g;
        if (!eval { qr/$pat/i; 1 }) {
            $bad->('bad state_keep');
        } else {
            $cfg->{state_keep} = $pat;
        }
    }
    return $cfg;
}

sub install_track {
    my ($new, $reload, $quiet) = @_;
    $new //= _blank_track();
    my $old = $track_cfg // _blank_track();
    if ($reload) {
        log_info('track: disabled') if $new->{disabled} && !$old->{disabled};
        log_info('track: enabled')  if !$new->{disabled} && $old->{disabled};
        my $was = $old->{tunnel} ? 1 : 0;
        my $now = $new->{tunnel} ? 1 : 0;
        log_info('tunnel: on')  if $now && !$was;
        log_info('tunnel: off') if $was && !$now;
        if ($now && ($old->{tunnel_timeout} // 0) != ($new->{tunnel_timeout} // 0)) {
            log_info('tunnel: timeout ' . $new->{tunnel_timeout});
        }
    } elsif (!$quiet && $new->{tunnel}) {
        log_info('tunnel: on, timeout ' . ($new->{tunnel_timeout} // 3600));
    }
    $track_cfg = { %$new };
}

# OpenBSD perl seeds an unseeded rand() from arc4random().
# srand(N) would select srand48_deterministic for this process.
my $INTERVAL_SPREAD;

# X is one quarter of the seconds the formula just added.
# The extra wait is rand() in 0 .. X-1.
sub _spread_added {
    my ($added) = @_;
    return 0 unless defined $added && $added > 0;
    my $x = int($added / 4);
    return 0 if $x < 1;
    my $r;
    if (defined $INTERVAL_SPREAD) {
        $r = int($INTERVAL_SPREAD->($x));
    } else {
        $r = int(rand($x));
    }
    $r = 0 if $r < 0;
    $r = $x - 1 if $r >= $x;
    return $r;
}

sub set_interval_spread_for_test { $INTERVAL_SPREAD = $_[0]; }

# The seconds being set, plus rand() in 0 .. quarter-1.
# Backoff passes the added span. An empty confirmation passes
# the whole interval.
sub with_quarter_spread {
    my ($seconds) = @_;
    $seconds = 0 unless defined $seconds && $seconds > 0;
    return int($seconds + _spread_added($seconds) + 0.5);
}

# Mailbox wait after mbsync exits. samples are {msgs, dur, span}.
sub next_mailbox_interval {
    my ($current, $samples, $cfg) = @_;
    $cfg //= $track_cfg;
    $current = $cfg->{initial} unless defined $current;
    my ($msgs, $span, $dur, $n) = (0, 0, 0, 0);
    for my $s (@{ $samples // [] }) {
        $msgs += $s->{msgs} // 0;
        $span += $s->{span} // 0;
        $dur  += $s->{dur}  // 0;
        $n++;
    }
    my $next;
    if ($n && $msgs > 0 && $span > 0) {
        my $by_mail = $cfg->{messages} * $span / $msgs;
        my $by_cost = 3 * ($dur / $n);
        $next = $by_mail > $by_cost ? $by_mail : $by_cost;
    } else {
        $next = $current * 2;
    }
    if ($next > $current) {
        $next = $current + with_quarter_spread($next - $current);
    }
    $next = $cfg->{min} if $next < $cfg->{min};
    $next = $cfg->{max} if $next > $cfg->{max};
    return int($next + 0.5);
}

# One new hash halves the gap. Three quiet checks double it.
# Both stop at [min, capability].
sub next_id_interval {
    my ($current, $changed, $cfg) = @_;
    $cfg //= $track_cfg;
    $current = $cfg->{id} unless defined $current && $current > 0;
    my $next = $changed ? int($current / 2) : $current * 2;
    my $floor = $cfg->{min};
    my $ceil  = $cfg->{capability};
    $next = $floor if $next < $floor;
    $next = $ceil  if $next > $ceil;
    return int($next);
}

sub id_command { return qq{ID ("name" "imapidle" "version" "$VERSION")}; }

sub id_reply_hash {
    my ($line) = @_;
    return 'NIL' unless defined $line && $line ne '';
    return 'NIL' if $line =~ /\bNIL\b/ && $line !~ /"/;
    my @s = $line =~ /"((?:\\.|[^"\\])*)"/g;
    return 'NIL' unless @s;
    my @pairs;
    for (my $i = 0; $i + 1 < @s; $i += 2) {
        push @pairs, lc($s[$i]) . "\0" . $s[$i + 1];
    }
    return sha256_hex(join("\n", sort @pairs));
}

sub capability_hash {
    my (@caps) = @_;
    return sha256_hex(join(' ', sort map { uc $_ } @caps));
}

sub imap_mailbox {
    my ($name) = @_;
    $name = '' unless defined $name;
    $name =~ s/\\/\\\\/g;
    $name =~ s/"/\\"/g;
    return qq{"$name"};
}

# Untagged STATUS text. Undef when either count is missing.
sub parse_status_counts {
    my ($text) = @_;
    return unless defined $text && $text ne '';
    my ($messages) = $text =~ /\bMESSAGES\s+(\d+)/i;
    my ($uidnext)  = $text =~ /\bUIDNEXT\s+(\d+)/i;
    return unless defined $messages && defined $uidnext;
    return ($messages + 0, $uidnext + 0);
}

# A first look with zero messages waits. A later look waits when
# UIDNEXT is the one we stored. Any mail, or a moved UIDNEXT, syncs.
sub status_stays_empty {
    my ($messages, $uidnext, $prev) = @_;
    return 0 unless defined $messages && $messages == 0;
    return 0 unless defined $uidnext;
    return 1 if !defined $prev;
    return $prev == $uidnext ? 1 : 0;
}

sub mbsync_new_messages {
    my ($text) = @_;
    return unless defined $text;
    my $n;
    for my $line (split /\n/, $text) {
        if ($line =~ /^Channels: \d+    Boxes: \d+    Far: \+(\d+) \*\d+ #\d+ -\d+    Near: \+(\d+) /) {
            $n = $1 + $2;
        }
    }
    return $n;
}

sub _encode_box {
    my ($name) = @_;
    $name =~ s/\\/\\\\/g;
    $name =~ s/\r/\\r/g;
    $name =~ s/\n/\\n/g;
    $name =~ s/\t/\\t/g;
    return $name;
}

sub _decode_box {
    my ($name) = @_;
    $name =~ s/\\\\/\0/g;
    $name =~ s/\\n/\n/g;
    $name =~ s/\\r/\r/g;
    $name =~ s/\\t/\t/g;
    $name =~ s/\0/\\/g;
    return $name;
}

sub folder_names_from_list {
    my ($recs) = @_;
    my @names;
    for my $rec (@{ $recs // [] }) {
        next unless ref $rec eq 'HASH' && defined $rec->{name} && $rec->{name} ne '';
        my $skip = 0;
        for my $attr (@{ $rec->{attrs} // [] }) {
            my $a = lc $attr;
            $skip = 1 if $a eq '\\noselect' || $a eq '\\nonexistent';
        }
        next if $skip;
        push @names, $rec->{name};
    }
    return @names;
}

sub _hot_name {
    my ($name, $hot) = @_;
    return 0 unless defined $name && $hot;
    return 1 if $hot->{$name};
    return 0 unless uc($name) eq 'INBOX';
    for my $key (keys %$hot) {
        return 1 if $hot->{$key} && uc($key) eq 'INBOX';
    }
    return 0;
}

sub _track_key {
    my ($channel, $box) = @_;
    return $channel . "\0" . $box;
}

# The account whose pass_cmd guards this mbsync channel. A stored
# password does not. Prefer the section that actually has a command
# when more than one row names the channel.
sub _login_for_channel {
    my ($channel) = @_;
    return unless defined $channel && $channel ne '';
    my ($fallback_name, $fallback);
    for my $name (sort keys %accounts) {
        my $acc = $accounts{$name} or next;
        next if $acc->{config_disabled};
        next if ($acc->{mbsync_channel} // '') ne $channel;
        if (defined $acc->{pass_cmd} && $acc->{pass_cmd} ne '') {
            return ($name, $acc);
        }
        ($fallback_name, $fallback) = ($name, $acc) unless $fallback;
    }
    return ($fallback_name, $fallback) if $fallback;
    return;
}

# Seconds to leave this channel alone, or 0 when a sync may start.
# A failing command sets the same wait as a login, so the loop does
# not call it again until that wait is over.
sub _pass_cmd_blocks {
    my ($channel, $now) = @_;
    $now //= time();
    my ($name, $acc) = _login_for_channel($channel);
    return 0 unless $name && $acc;
    return 0 unless defined $acc->{pass_cmd} && $acc->{pass_cmd} ne '';
    my $due = $acc->{next_try} // 0;
    if ($due > $now) {
        return $due - $now;
    }
    my $pw = account_pass($name);
    return 0 if defined $pw && secret_line_ok($pw);
    my $left = ($accounts{$name}{next_try} // 0) - time();
    return $left > 0 ? $left : 1;
}

# The log prefix is the account that claims this mbsync channel.
# A config hold is not that name. With no such account, the channel
# itself is the prefix so a unit test without a login still reads.
sub _log_name {
    my ($channel) = @_;
    $channel = '' unless defined $channel;
    return $channel if $channel eq '';
    for my $name (keys %accounts) {
        my $acc = $accounts{$name} or next;
        next if $acc->{config_disabled};
        return $name if ($acc->{mbsync_channel} // '') eq $channel;
    }
    return $channel;
}

# A loaded account owns this channel, including one the file holds.
# A row whose channel nobody claims is stale and is not scheduled.
sub channel_claimed {
    my ($channel) = @_;
    return 0 unless defined $channel && $channel ne '';
    for my $acc (values %accounts) {
        next unless ref $acc eq 'HASH';
        return 1 if ($acc->{mbsync_channel} // '') eq $channel;
    }
    return 0;
}

# $ok is false when LIST failed. $hot is a hash of folderN names.
sub apply_folder_list {
    my ($channel, $names, $hot, $ok, $now) = @_;
    return unless defined $channel && $channel ne '';
    $now //= time();
    $hot //= {};
    my $st = $folder_lists{$channel} //= { names => {}, had_file => 0 };
    if (!$ok) {
        $list_next{$channel} = $now + ($track_cfg->{initial} // 1800);
        return;
    }
    $names //= [];
    my %new = map { $_ => 1 } @$names;
    if (!$st->{had_file}) {
        log_info(_log_name($channel) . ': ' . scalar(@$names) . ' folders, list saved');
    } else {
        for my $name (sort keys %{ $st->{names} }) {
            next if $new{$name};
            log_info(_log_name($channel) . ": folder $name removed");
            delete $track{_track_key($channel, $name)};
        }
        for my $name (sort @$names) {
            next if $st->{names}{$name};
            log_info(_log_name($channel) . ": folder $name added");
        }
    }
    my $fresh = !$st->{had_file};
    $st->{names}    = \%new;
    $st->{had_file} = 1;
    _save_folder_file($channel);

    my %keep;
    for my $name (@$names) {
        my $id = _track_key($channel, $name);
        if (index($name, ':') >= 0) {
            log_info(_log_name($channel) . ": folder $name not tracked") unless $colon_noted{$id};
            $colon_noted{$id} = 1;
            delete $track{$id};
            next;
        }
        if (_hot_name($name, $hot)) {
            delete $track{$id};
            next;
        }
        $keep{$id} = 1;
        my $sweep = _pulse_sweep_for_channel($channel);
        if ($track{$id} && !$fresh) {
            _mark_pulse_row($track{$id}, $sweep, 1) if defined $sweep;
            next;
        }
        my $added   = !$fresh && !$track{$id};
        my $existed = $track{$id} ? 1 : 0;
        $track{$id} = {
            interval => $track_cfg->{initial},
            next     => $now + $track_cfg->{initial},
            samples  => [],
            fails    => 0,
        } unless $track{$id};
        # A name already tracked keeps its clock, including one
        # restored from the track file. A name that appeared later
        # starts at initial. A new pulse mailbox is due for STATUS
        # immediately so empty and mail are told apart before the sweep.
        $track{$id}{next} = $now + $track_cfg->{initial} if $added;
        if (defined $sweep) {
            if ($existed) {
                _mark_pulse_row($track{$id}, $sweep, 1);
            } else {
                _arm_new_pulse_row($track{$id}, $sweep, $channel, $now);
            }
        }
    }
    for my $id (keys %track) {
        my ($ch) = split /\0/, $id, 2;
        next if !defined $ch || $ch ne $channel;
        delete $track{$id} unless $keep{$id};
    }
    $list_next{$channel} = $now + $track_cfg->{list};
}

sub _save_folder_file {
    my ($channel) = @_;
    return if $DRY_RUN;
    return unless defined $FOLDERS_DIR && $FOLDERS_DIR ne '';
    return if $channel =~ m{[/\\]};
    my $st = $folder_lists{$channel} or return;
    make_path($FOLDERS_DIR, { mode => 0700 });
    my $path = "$FOLDERS_DIR/$channel";
    my $old  = umask 077;
    open my $fh, '>', $path or do {
        umask $old;
        log_error("Cannot write $path: $!");
        return;
    };
    for my $name (sort keys %{ $st->{names} }) {
        print $fh _encode_box($name), "\n";
    }
    close $fh;
    umask $old;
    _mark_folders();
}

sub _load_folder_file {
    my ($channel) = @_;
    return unless defined $FOLDERS_DIR && $FOLDERS_DIR ne '';
    my $path = "$FOLDERS_DIR/$channel";
    return unless -f $path;
    open my $fh, '<', $path or return;
    my %names;
    while (<$fh>) {
        chomp;
        next if $_ eq '';
        $names{_decode_box($_)} = 1;
    }
    close $fh;
    $folder_lists{$channel} = { names => \%names, had_file => 1 };
}

sub load_folder_files {
    %folder_lists = ();
    if (!defined $FOLDERS_DIR || $FOLDERS_DIR eq '' || !-d $FOLDERS_DIR) {
        _mark_folders();
        return;
    }
    opendir my $dh, $FOLDERS_DIR or return;
    for my $name (readdir $dh) {
        next if $name eq '.' || $name eq '..';
        next if $name =~ m{[/\\]};
        _load_folder_file($name);
    }
    closedir $dh;
    _mark_folders();
}

# user, sys, rss, and the six counters. nr is how many runs added them.
# Real seconds keep using n, so a three-column history is not zero rss.
my @RU_FIELDS = qw(user sys rss minflt majflt inblock oublock nvcsw nivcsw);

sub _stat_num {
    my ($n) = @_;
    return '0' if !defined $n || $n == 0;
    return sprintf('%.15g', $n);
}

# A sha1 -b token decodes to 20 bytes that are not text. Anything that
# decodes to printable ASCII and NUL is an older base64 key.
sub _sha1_b_token {
    my ($field) = @_;
    return 0 unless defined $field && length($field) == 28;
    return 0 unless $field =~ /\A[A-Za-z0-9+\/]{27}=\z/;
    my $raw = eval { decode_base64($field) };
    return 0 unless defined $raw && length($raw) == 20;
    return 0 if $raw =~ /\A[\x20-\x7e\0]*\z/;
    return 1;
}

sub _key_from_stored {
    my ($field) = @_;
    return $field if _sha1_b_token($field);
    my $raw = eval { decode_base64($field) };
    return unless defined $raw && $raw ne '';
    return unless $raw =~ /\A[\x20-\x7e\0]*\z/;
    return sha1_b($raw);
}

sub _memory_key {
    my ($cli) = @_;
    return if !defined $cli || $cli eq '';
    return $cli if _sha1_b_token($cli);
    return sha1_b($cli);
}

sub _absorb_stat_row {
    my ($dest, $key, $row) = @_;
    my $have = $dest->{$key};
    if (!$have) {
        $dest->{$key} = $row;
        return;
    }
    $have->{n}     += $row->{n};
    $have->{total} += $row->{total};
    return unless ($row->{nr} // 0) > 0;
    if (($have->{nr} // 0) > 0) {
        for my $f (@RU_FIELDS) {
            $have->{$f} += $row->{$f} // 0;
        }
        $have->{nr} += $row->{nr};
    } else {
        for my $f (@RU_FIELDS) {
            $have->{$f} = $row->{$f} // 0;
        }
        $have->{nr} = $row->{nr};
    }
}

sub _stat_load {
    my ($path, $dest) = @_;
    %$dest = ();
    return unless defined $path && -f $path;
    open my $fh, '<', $path or return;
    while (<$fh>) {
        chomp;
        next if /^\s*#/ || /^\s*$/;
        my ($field, $n, $total, @rest) = split /\t/, $_;
        next unless defined $field && defined $n && defined $total;
        next unless $n =~ /^\d+$/ && $total =~ /^[\d.]+$/;
        my $key = _key_from_stored($field);
        next unless defined $key && $key ne '';
        my $row = { n => $n + 0, total => $total + 0 };
        if (@rest == @RU_FIELDS + 1) {
            my $nr = $rest[-1];
            my $ok = $nr =~ /^\d+$/ && $nr > 0;
            for my $i (0 .. $#RU_FIELDS) {
                $ok = 0 if $rest[$i] !~ /^[\d.]+$/;
            }
            if ($ok) {
                for my $i (0 .. $#RU_FIELDS) {
                    $row->{ $RU_FIELDS[$i] } = $rest[$i] + 0;
                }
                $row->{nr} = $nr + 0;
            }
        }
        _absorb_stat_row($dest, $key, $row);
    }
    close $fh;
}

sub _stat_save {
    my ($path, $src) = @_;
    return if $DRY_RUN;
    return unless defined $path && $path ne '';
    my $dir = dirname($path);
    make_path($dir, { mode => 0700 }) if $dir ne '' && $dir ne '.';
    my $old = umask 077;
    open my $fh, '>', $path or do {
        umask $old;
        log_error("Cannot write $path: $!");
        return;
    };
    print $fh "# key\tcount\ttotal\n";
    for my $key (sort keys %$src) {
        my $row = $src->{$key} or next;
        my @cols = ($key, $row->{n}, _stat_num($row->{total}));
        if (($row->{nr} // 0) > 0) {
            push @cols, map { _stat_num($row->{$_} // 0) } @RU_FIELDS;
            push @cols, $row->{nr};
        }
        print $fh join("\t", @cols), "\n";
    }
    close $fh;
    umask $old;
    _state_mark($path);
}

sub load_stat_files {
    _stat_load($MBSYNC_REAL_FILE, \%MBSYNC_REAL) if defined $MBSYNC_REAL_FILE;
    _state_mark($MBSYNC_REAL_FILE);
    _stat_load($CONN_TIME_FILE,   \%CONN_TIME);
    _state_mark($CONN_TIME_FILE);
}

sub save_stat_files {
    _stat_save($MBSYNC_REAL_FILE, \%MBSYNC_REAL) if defined $MBSYNC_REAL_FILE;
    _stat_save($CONN_TIME_FILE,   \%CONN_TIME)   if defined $CONN_TIME_FILE;
}

# Next wake, interval, UIDNEXT, and the empty confirmation,
# plus when LIST is next due. Written on shutdown so a restart
# does not STATUS or confirm the herd together.
sub save_track_file {
    return if $DRY_RUN;
    return unless defined $TRACK_FILE && $TRACK_FILE ne '';
    my $dir = dirname($TRACK_FILE);
    make_path($dir, { mode => 0700 }) if $dir ne '' && $dir ne '.';
    my $old = umask 077;
    open my $fh, '>', $TRACK_FILE or do {
        umask $old;
        log_error("Cannot write $TRACK_FILE: $!");
        return;
    };
    print $fh "# list\tchannel\twhen\n";
    print $fh "# box\tchannel\tmailbox\tnext\tinterval\tuidnext\tconfirm\n";
    for my $ch (sort keys %list_next) {
        next if !defined $ch || $ch eq '' || $ch =~ /[\s\\\/]/;
        my $when = $list_next{$ch};
        next unless defined $when && $when =~ /^\d+(?:\.\d+)?\z/;
        print $fh "list\t$ch\t", _stat_num($when), "\n";
    }
    for my $id (sort keys %track) {
        my ($ch, $box) = split /\0/, $id, 2;
        next if !defined $ch || $ch eq '' || $ch =~ /[\s\\\/]/;
        next if !defined $box || $box eq '' || index($box, ':') >= 0;
        my $rec = $track{$id} or next;
        my $next = $rec->{next};
        my $interval = $rec->{interval};
        next unless defined $next && $next =~ /^\d+(?:\.\d+)?\z/;
        next unless defined $interval && $interval =~ /^\d+(?:\.\d+)?\z/;
        my $uid = '';
        $uid = $rec->{uidnext}
            if defined $rec->{uidnext} && $rec->{uidnext} =~ /^\d+\z/;
        my $confirm = '';
        $confirm = _stat_num($rec->{confirm})
            if $rec->{empty}
            && defined $rec->{confirm}
            && $rec->{confirm} =~ /^\d+(?:\.\d+)?\z/;
        print $fh join("\t",
            'box', $ch, _encode_box($box),
            _stat_num($next), _stat_num($interval), $uid, $confirm,
        ), "\n";
    }
    close $fh;
    umask $old;
    _state_mark($TRACK_FILE);
}

sub load_track_file {
    _state_mark($TRACK_FILE);
    return unless defined $TRACK_FILE && -f $TRACK_FILE;
    open my $fh, '<', $TRACK_FILE or return;
    while (<$fh>) {
        chomp;
        next if /^\s*#/ || /^\s*$/;
        my ($kind, @f) = split /\t/, $_, -1;
        next unless defined $kind;
        if ($kind eq 'list') {
            my ($ch, $when) = @f;
            next unless defined $ch && $ch ne '' && $ch !~ /[\s\\\/]/;
            next unless defined $when && $when =~ /^\d+(?:\.\d+)?\z/;
            $list_next{$ch} = $when + 0;
            next;
        }
        next unless $kind eq 'box';
        my ($ch, $box, $next, $interval, $uid, $confirm) = @f;
        next unless defined $ch && $ch ne '' && $ch !~ /[\s\\\/]/;
        next unless defined $box && $box ne '';
        $box = _decode_box($box);
        next if $box eq '' || index($box, ':') >= 0;
        next unless defined $next && $next =~ /^\d+(?:\.\d+)?\z/;
        next unless defined $interval && $interval =~ /^\d+(?:\.\d+)?\z/;
        my $id = _track_key($ch, $box);
        $track{$id} = {
            interval => $interval + 0,
            next     => $next + 0,
            samples  => [],
            fails    => 0,
        };
        $track{$id}{uidnext} = $uid + 0
            if defined $uid && $uid =~ /^\d+\z/;
        if (defined $confirm && $confirm =~ /^\d+(?:\.\d+)?\z/) {
            $track{$id}{confirm} = $confirm + 0;
            $track{$id}{empty}   = 1;
        }
    }
    close $fh;
    _state_mark($TRACK_FILE);
}

sub note_conn_time {
    my ($key, $seconds) = @_;
    $key = _memory_key($key);
    return unless defined $key;
    $seconds = 0 if !defined $seconds || $seconds < 0;
    my $row = $CONN_TIME{$key} //= { n => 0, total => 0 };
    $row->{n}++;
    $row->{total} += $seconds;
    _stat_save($CONN_TIME_FILE, \%CONN_TIME) if defined $CONN_TIME_FILE && $CONN_TIME_FILE ne '';
    return sprintf('(x%d avg %.2fs)', $row->{n}, $row->{total} / $row->{n});
}

sub _conn_time_key {
    my ($conn) = @_;
    return unless ref $conn eq 'HASH';
    my $name = $conn->{name} // '';
    return if $name eq '';
    my $mode = $conn->{mode} // '';
    my $what = $mode eq 'NOTIFY' ? 'notify'
        : $mode eq 'POLL' ? 'poll'
        : $mode eq 'PULSE' ? 'pulse'
        : ($conn->{folder} // '');
    return if $what eq '';
    return $name . "\0" . $what;
}

sub runtime_dir {
    return $RUNTIME_DIR if defined $RUNTIME_DIR && $RUNTIME_DIR ne '';
    return unless defined $ENV{HOME} && $ENV{HOME} ne '';
    return "$ENV{HOME}/tmp";
}

sub _flag_file {
    my ($base) = @_;
    my $dir = runtime_dir();
    return unless defined $dir;
    for my $suffix ('', '.mail', '.imapidle') {
        my $path = "$dir/$base$suffix";
        return $path if -e $path;
    }
    return;
}

sub pause_path     { return _flag_file('pause'); }
sub shutdown_path  { return _flag_file('shutdown'); }

sub mbsync_running { return scalar keys %children; }

# A channel:box child that is not a tracked or pulse job.
sub _child_is_hot_sync {
    my ($rec) = @_;
    return 0 unless ref $rec eq 'HASH';
    return 0 if defined $rec->{pulse} && $rec->{pulse} ne '';
    return 0 if defined $rec->{track} && $rec->{track} ne '';
    for my $arg (@{ $rec->{args} // [] }) {
        return 1 if defined $arg && index($arg, ':') >= 0;
    }
    return 0;
}

sub _hot_running {
    my $n = 0;
    for my $pid (keys %children) {
        $n++ if _child_is_hot_sync($children{$pid});
    }
    return $n;
}

# True when this pulse mailbox will start mbsync, not merely STATUS.
# The first classification and an empty probe that is not due for
# its weekly confirmation do not take a slot.
sub _row_wants_pulse_mbsync {
    my ($rec, $now) = @_;
    return 0 unless $rec && $rec->{pulse};
    $now //= time();
    return 1 if $rec->{await_sync} && ($rec->{next} // 0) <= $now;
    return 1 if _confirm_due($rec, $now);
    return 1 if $rec->{classified} && !$rec->{empty} && ($rec->{next} // 0) <= $now;
    return 0;
}

sub _pulse_status_only {
    my ($rec, $now) = @_;
    return 0 unless $rec && $rec->{pulse};
    $now //= time();
    return 0 if _row_wants_pulse_mbsync($rec, $now);
    return ($rec->{next} // 0) <= $now ? 1 : 0;
}

# A pulse mailbox that will sync, and whose channel is free.
sub _pulse_wants_slot {
    my ($now) = @_;
    $now //= time();
    return 0 if $track_cfg && $track_cfg->{disabled};
    for my $id (keys %track) {
        my $rec = $track{$id} or next;
        next unless _row_wants_pulse_mbsync($rec, $now);
        my ($ch) = split /\0/, $id, 2;
        next if !defined $ch || $ch eq '';
        next if channel_busy($ch);
        return 1;
    }
    return 0;
}

sub slots_for_hot {
    my ($now) = @_;
    my $cap  = $track_cfg->{connections} // 1;
    my $left = $cap - mbsync_running();
    return 0 if $left <= 0;
    # One slot for named folders; pulse may use the rest.
    if ($cap > 1 && _pulse_wants_slot($now)) {
        my $room = 1 - _hot_running();
        $room = 0 if $room < 0;
        $left = $room if $left > $room;
    }
    return $left;
}

sub slots_for_cold {
    my ($now) = @_;
    my $cap     = $track_cfg->{connections} // 1;
    my $running = mbsync_running();
    if ($cap <= 1) {
        return 0 if named_sync_pending();
        my $left = $cap - $running;
        return $left > 0 ? $left : 0;
    }
    # The reserved slot is the running named sync. A queued named
    # folder keeps it free. Pulse and tracked use what remains.
    my $held = _hot_running();
    $held = 1 if $held > 1;
    my $blocked = 1 - $held;
    $blocked = 0 if $blocked < 0;
    $blocked = 1 if $held == 0 && _named_queued();
    my $left = $cap - $blocked - $running;
    return $left > 0 ? $left : 0;
}

sub adopt_state_file {
    my ($dest, $src) = @_;
    return 0 if $DRY_RUN;
    return 0 unless defined $dest && $dest ne '' && defined $src && -f $src;
    return 0 if -e $dest;
    my $dir = dirname($dest);
    make_path($dir, { mode => 0700 }) if $dir ne '' && $dir ne '.';
    open my $in, '<', $src or return 0;
    my $old = umask 077;
    open my $out, '>', $dest or do {
        umask $old;
        close $in;
        return 0;
    };
    while (<$in>) { print $out $_; }
    close $in;
    close $out;
    umask $old;
    log_info("copied " . basename_file($src) . " to $dir");
    return 1;
}

sub basename_file {
    my ($path) = @_;
    $path =~ s{.*/}{};
    return $path;
}

# Returns (accounts, '', pulses, track, servers) or (undef, error).
# Does not touch %accounts. Pulses is a list of sections.
sub parse_config_file {
    my ($file) = @_;
    my $cfg = Config::Tiny->read($file)
      or return (undef, "Cannot read $file: " . (Config::Tiny->errstr // $!));

    my (@problems, %server_rows, %account_rows, %idle_rows, @pulse_rows);
    my ($global_name, $global_row);
    my $hyper_default = 0;
    for my $section (keys %{$cfg}) {
        next if $section eq '_';
        my $row = $cfg->{$section};
        next unless ref $row eq 'HASH';
        my $type = lc($row->{type} // '');
        $type =~ s/^\s+|\s+$//g;
        next unless $type eq 'global';
        $hyper_default = _config_disabled($row->{hyperdelete}) ? 1 : 0;
        last;
    }
    for my $section (sort keys %{$cfg}) {
        next if $section eq '_';
        my $row = $cfg->{$section};
        next unless ref $row eq 'HASH';
        my $type = lc($row->{type} // '');
        $type =~ s/^\s+|\s+$//g;
        if ($type eq '') {
            push @problems, "[$section] missing type";
            next;
        }
        if ($type eq 'global') {
            if ($global_row) {
                push @problems, "[$section] second global section";
                next;
            }
            $global_name = $section;
            $global_row  = $row;
            next;
        }
        if ($type eq 'server') {
            $server_rows{$section} = $row;
            next;
        }
        if ($type eq 'account') {
            $account_rows{$section} = $row;
            next;
        }
        if ($type eq 'idle') {
            $idle_rows{$section} = $row;
            next;
        }
        if ($type eq 'pulse') {
            push @pulse_rows, [ $section, $row ];
            next;
        }
        push @problems, "[$section] bad type";
    }

    my %srv;
    for my $name (sort keys %server_rows) {
        $srv{$name} = _parse_server_section($name, $server_rows{$name}, \@problems);
    }

    my %fresh;
    my $blocked = sub {
        my ($section) = @_;
        return grep { index($_, "[$section] ") == 0 } @problems;
    };

    for my $section (sort keys %account_rows) {
        my $row = $account_rows{$section};
        if (_config_disabled($row->{disabled})) {
            $fresh{$section} = _held_account($row, 'account');
            next;
        }
        for my $key (keys %$row) {
            if ($key eq 'folder' || $key =~ /^folder\d+$/) {
                push @problems, "[$section] folder";
                last;
            }
        }
        my ($has_pw, $has_cmd, $auth) = _login_secrets($section, $row, \@problems, 0);
        my $channel = $row->{mbsync_channel};
        $channel = $section if !defined $channel || $channel eq '';
        push @problems, "[$section] bad mbsync_channel" if _bad_channel_name($channel);
        my ($host, $port, $proto) = _apply_endpoint($section, $row, \%srv, \@problems);
        my $folders = [];
        my $poll = _section_poll($section, $row, \@problems);
        next if $blocked->($section);
        $fresh{$section} = _new_account(
            host    => $host,
            port    => $port,
            proto   => $proto,
            user    => $row->{user},
            pass    => $has_pw ? $row->{pass} : undef,
            pass_cmd => $has_cmd ? $row->{pass_cmd} : undef,
            channel => $channel,
            auth    => $auth,
            role    => 'account',
            folders => $folders,
            wait    => $row->{wait},
            poll    => $poll,
            hyper   => _section_hyper($row, $hyper_default),
            hook    => $row->{hook},
        );
    }

    my @binds;
    for my $section (sort keys %idle_rows) {
        my $row = $idle_rows{$section};
        my $has_channel = defined $row->{channel} && $row->{channel} ne '';
        my $has_server  = defined $row->{server} && $row->{server} ne '';
        if ($has_channel && $has_server) {
            push @problems, "[$section] sets both channel and server";
            next;
        }
        # The login and the mbsync name live on the account. An idle
        # section only names that account and lists folders.
        _reject_account_keys($section, $row, \@problems);
        if ($has_channel) {
            next if _config_disabled($row->{disabled});
            push @problems, "[$section] bad channel" if _bad_channel_name($row->{channel});
            my $folders = _parse_folders($section, $row, \@problems, 1);
            next if $blocked->($section) || !$folders;
            push @binds, {
                section => $section,
                channel => $row->{channel},
                folders => $folders,
                hook    => _hook_value($row->{hook}),
            };
            next;
        }
        push @problems, "[$section] missing channel";
    }

    my @pulses;
    for my $item (@pulse_rows) {
        my ($section, $row) = @$item;
        push @pulses, _parse_pulse_section($section, $row, \@problems);
    }

    my %bound;
    for my $bind (@binds) {
        my $name = $bind->{channel};
        my $acc  = $fresh{$name};
        if (!$acc) {
            push @problems, "[$bind->{section}] unknown account $name";
            next;
        }
        my $role = $acc->{role} // '';
        if ($bound{$name} || $role eq 'idle' || $role eq 'pulse') {
            push @problems, "[$bind->{section}] duplicate account $name";
            next;
        }
        $acc->{role}    = 'idle';
        $acc->{folders} = $bind->{folders};
        $acc->{hook}    = $bind->{hook} if ($acc->{hook} // '') eq '' && $bind->{hook} ne '';
        $bound{$name}   = 'idle';
    }

    for my $pulse (@pulses) {
        next if $pulse->{disabled};
        my $label = $pulse->{name} // 'pulse';
        for my $name (@{ $pulse->{channels} // [] }) {
            my $acc = $fresh{$name};
            if (!$acc) {
                push @problems, "[$label] unknown account $name";
                next;
            }
            my $role = $acc->{role} // '';
            if ($bound{$name} || $role eq 'idle' || $role eq 'pulse') {
                push @problems, "[$label] duplicate account $name";
                next;
            }
            $acc->{role}          = 'pulse';
            $acc->{sweep}         = $pulse->{sweep};
            $acc->{pulse_hook}    = $pulse->{hook} // '';
            $acc->{pulse_section} = $label;
            $acc->{folders}       = [];
            $bound{$name}         = 'pulse';
        }
    }

    my %seen_ch;
    for my $name (sort keys %fresh) {
        my $acc = $fresh{$name} or next;
        next if $acc->{config_disabled};
        my $role = $acc->{role} // '';
        next if $role eq 'account';
        my $ch = $acc->{mbsync_channel} // '';
        next if $ch eq '';
        if ($seen_ch{$ch}) {
            push @problems, "[$name] duplicate mbsync channel $ch";
            next;
        }
        $seen_ch{$ch} = 1;
    }

    my $track = _parse_track_section($global_name, $global_row, \@problems);
    if (@problems) {
        return (undef, join("\n", @problems));
    }
    unless (%fresh || _pulse_list_usable(\@pulses)) {
        return (undef, 'no usable accounts in ' . $file);
    }
    return (\%fresh, '', \@pulses, $track, \%srv);
}

sub _config_disabled {
    my ($val) = @_;
    return defined $val && $val =~ /^yes$/i;
}

sub _auth_name {
    my ($val) = @_;
    my $auth = lc($val // 'login');
    return $auth if $auth eq 'xoauth2';
    return 'login';
}

sub xoauth2_initial {
    my ($user, $token) = @_;
    $user  //= '';
    $token //= '';
    return encode_base64("user=$user\x01auth=Bearer $token\x01\x01", '');
}


sub _held_account {
    my ($row, $role) = @_;
    my $proto = _parse_proto($row->{proto}) // 'tls';
    my $port = $row->{port};
    if (!defined $port || $port !~ /^\d+$/ || $port < 1 || $port > 65535) {
        $port = _default_port($proto);
    }
    my $has_pw  = defined $row->{pass}     && $row->{pass} ne '';
    my $has_cmd = defined $row->{pass_cmd} && $row->{pass_cmd} ne '';
    my $channel = $row->{mbsync_channel} // '';
    return {
        server          => $row->{server} // '',
        port            => $port + 0,
        proto           => $proto,
        user            => $row->{user} // '',
        pass            => $has_pw ? $row->{pass} : undef,
        pass_cmd        => $has_cmd ? $row->{pass_cmd} : undef,
        mbsync_channel  => $channel,
        auth            => _auth_name($row->{auth}),
        role            => ($role && $role eq 'account') ? 'account' : 'idle',
        folders         => [],
        wait            => 0,
        poll            => 60,
        hook            => _hook_value($row->{hook}),
        sweep           => undef,
        pulse_hook      => '',
        pulse_section   => '',
        backoff         => 5,
        next_try        => 0,
        fails           => 0,
        up              => 0,
        disabled        => 1,
        config_disabled => 1,
    };
}

sub reset_pulse_state {
    @PULSE_SECTIONS = ();
    %servers = ();
}

sub install_servers {
    my ($new) = @_;
    %servers = %{ $new // {} };
}

# $reload keeps each mailbox clock. A new sweep is used on the next exit.
sub install_pulse {
    my ($new, $reload, $quiet) = @_;
    $new = [] unless ref $new eq 'ARRAY';
    my %old = map { $_->{name} => $_ } @PULSE_SECTIONS;
    my %keep;
    for my $sec (@$new) {
        my $name = $sec->{name} // 'pulse';
        $keep{$name} = 1;
        my $prev = $old{$name};
        if ($sec->{disabled}) {
            log_info("$name: pulse disabled") if !$reload || !$prev || !$prev->{disabled};
            next;
        }
        if ($reload) {
            log_info("$name: pulse enabled") if $prev && $prev->{disabled};
            if ($prev && !$prev->{disabled} && ($prev->{sweep} // 0) != ($sec->{sweep} // 0)) {
                log_info("$name: pulse sweep $sec->{sweep}");
            }
            my %had = map { $_ => 1 } @{ $prev->{channels} // [] };
            my %now = map { $_ => 1 } @{ $sec->{channels} // [] };
            for my $ch (sort keys %had) {
                log_info(_log_name($ch) . ': pulse removed') unless $now{$ch};
            }
            for my $ch (@{ $sec->{channels} // [] }) {
                log_info(_log_name($ch) . ': pulse added') unless $had{$ch};
            }
        } elsif (!$quiet && @{ $sec->{channels} // [] }) {
            log_info("$name: pulse sweep $sec->{sweep}: " . join(' ', @{ $sec->{channels} }));
        }
    }
    if ($reload) {
        for my $name (sort keys %old) {
            log_info("$name: pulse removed") unless $keep{$name};
        }
    }
    @PULSE_SECTIONS = map { {
        name     => $_->{name} // 'pulse',
        disabled => $_->{disabled} ? 1 : 0,
        sweep    => $_->{sweep} // 3600,
        channels => [ @{ $_->{channels} // [] } ],
        hook     => $_->{hook} // '',
    } } @$new;
    if ($reload) {
        _stamp_pulse_rows();
    } else {
        _pulse_last_load();
    }
}

sub _pulse_last_load {
    %PULSE_LAST = ();
    _state_mark($PULSE_LAST_FILE);
    return unless defined $PULSE_LAST_FILE && -f $PULSE_LAST_FILE;
    open my $fh, '<', $PULSE_LAST_FILE or return;
    while (<$fh>) {
        chomp;
        next if /^\s*#/ || /^\s*$/;
        my ($ch, $when) = split /\t/, $_, 2;
        next unless defined $ch && $ch ne '' && $ch !~ /[\s:]/;
        next unless defined $when && $when =~ /^[\d.]+$/;
        $PULSE_LAST{$ch} = $when + 0;
    }
    close $fh;
    _state_mark($PULSE_LAST_FILE);
}

sub _pulse_last_save {
    return if $DRY_RUN;
    return unless defined $PULSE_LAST_FILE && $PULSE_LAST_FILE ne '';
    my $dir = dirname($PULSE_LAST_FILE);
    make_path($dir, { mode => 0700 }) if $dir ne '' && $dir ne '.';
    my $old = umask 077;
    open my $fh, '>', $PULSE_LAST_FILE or do {
        umask $old;
        log_error("Cannot write $PULSE_LAST_FILE: $!");
        return;
    };
    print $fh "# channel\tlast\n";
    for my $ch (sort keys %PULSE_LAST) {
        print $fh "$ch\t", _stat_num($PULSE_LAST{$ch}), "\n";
    }
    close $fh;
    umask $old;
    _state_mark($PULSE_LAST_FILE);
}

# The saved whole-channel exit is applied when a mailbox row is created.
sub _apply_pulse_last { }

sub _pulse_note_exit {
    my ($channel, $now) = @_;
    return unless defined $channel && $channel ne '';
    $now //= time();
    $PULSE_LAST{$channel} = $now;
    _pulse_last_save();
}

sub _pulse_account_by_channel {
    my ($channel) = @_;
    return unless defined $channel && $channel ne '';
    for my $name (keys %accounts) {
        my $acc = $accounts{$name} or next;
        next if $acc->{disabled};
        next unless ($acc->{role} // '') eq 'pulse';
        return $acc if ($acc->{mbsync_channel} // '') eq $channel;
    }
    return;
}

sub _pulse_sweep_for_channel {
    my $acc = _pulse_account_by_channel($_[0]);
    return unless $acc;
    my $sweep = $acc->{sweep} // 3600;
    $sweep = 3600 if $sweep !~ /^\d+$/;
    return $sweep + 0;
}

# A reload keeps each mailbox clock. A channel that is no longer
# pulse drops only the rows this sweep created.
sub _stamp_pulse_rows {
    for my $id (keys %track) {
        my $rec = $track{$id} or next;
        my ($ch) = split /\0/, $id, 2;
        my $sweep = _pulse_sweep_for_channel($ch);
        if (!defined $sweep) {
            delete $track{$id} if $rec->{pulse};
            next;
        }
        $rec->{pulse}  = 1;
        $rec->{sweep}  = $sweep;
        $rec->{interval} = $sweep unless $rec->{empty};
    }
}

# $existed marks a mailbox that already had a clock, including one
# restored from the track file. A new name stays unclassified until
# the first STATUS.
sub _mark_pulse_row {
    my ($rec, $sweep, $existed) = @_;
    return unless $rec && defined $sweep;
    $rec->{pulse}    = 1;
    $rec->{sweep}    = $sweep;
    $rec->{interval} = $sweep unless $rec->{empty};
    $rec->{classified} = 1 if $existed;
}

sub _arm_new_pulse_row {
    my ($rec, $sweep, $channel, $now) = @_;
    $rec->{pulse}       = 1;
    $rec->{sweep}       = $sweep;
    $rec->{interval}    = $sweep;
    $rec->{next}        = $now;
    $rec->{classified}  = 0;
    $rec->{await_sync}  = 0;
    $rec->{empty}       = 0;
    delete $rec->{confirm};
    delete $rec->{confirming};
    # The channel exit is only a start time. The quarter spread is
    # drawn once per mailbox when the first STATUS finds mail.
    if (exists $PULSE_LAST{$channel}) {
        $rec->{seed} = $PULSE_LAST{$channel};
    } else {
        delete $rec->{seed};
    }
}

sub load_config {
    my ($file, $quiet) = @_;
    my ($fresh, $err, $off, $track, $srv) = parse_config_file($file);
    %accounts = ();
    if ($err || !$fresh) {
        reset_pulse_state();
        install_track(_blank_track(), 0);
        return $err if $err;
        return 'empty config';
    }
    %accounts = %$fresh;
    install_servers($srv);
    install_pulse($off, 0, $quiet);
    install_track($track, 0, $quiet);
    if (!$quiet) {
        _log_loaded_account($_) for sort keys %accounts;
    }
    return '';
}

sub _log_loaded_account {
    my ($section) = @_;
    my $acc = $accounts{$section} or return;
    if ($acc->{config_disabled}) {
        log_info("$section: disabled");
        return;
    }
    my $role = $acc->{role} // '';
    if ($role eq 'account') {
        log_info("$section: account, mbsync $acc->{mbsync_channel}");
        return;
    }
    if ($role eq 'pulse') {
        log_info("$section: pulse, mbsync $acc->{mbsync_channel}");
        return;
    }
    my $how = defined $acc->{pass_cmd} && $acc->{pass_cmd} ne '' ? 'pass_cmd' : 'pass';
    my $mech = ($acc->{auth} // '') eq 'xoauth2' ? ', xoauth2' : '';
    log_info("$section: $how$mech, mbsync $acc->{mbsync_channel}, "
          . scalar(@{ $acc->{folders} }) . ' folder(s)');
}

# pizauth show writes "ERROR ... Access token unavailable until
# authorised with URL https://..." and exits 1. A wrapper can exit 0
# with that line on stdout. It is not a secret, and nothing connects.
sub secret_line_ok {
    my ($line) = @_;
    return 0 unless defined $line && $line ne '';
    return 0 if length($line) > 4096;
    return 0 if $line =~ /^ERROR\b/;
    return 0 if $line =~ /Access token unavailable/i;
    return 0 if $line =~ m{://};
    return 1;
}

# First line of stdout from sh -c. Empty, timeout, a non-zero exit,
# and a line that is not a secret are undef. The command text and
# its output are not logged.
sub capture_pass_cmd {
    my ($cmd, $timeout) = @_;
    $timeout //= 30;
    return unless defined $cmd && $cmd ne '';

    pipe my $rd, my $wr or return;
    my $pid = fork();
    if (!defined $pid) {
        close $rd;
        close $wr;
        return;
    }
    if ($pid == 0) {
        my $keep = fileno($wr);
        close_extra_fds($keep);
        open STDIN, '<', '/dev/null';
        open STDOUT, '>&', $wr or _exit(127);
        open STDERR, '>', '/dev/null';
        close $wr;
        $SIG{HUP}  = 'DEFAULT';
        $SIG{CHLD} = 'DEFAULT';
        $SIG{INFO} = 'DEFAULT';
        _restore_wake_mask();
        exec '/bin/sh', '-c', $cmd
            or _exit(127);
    }
    close $wr;
    cloexec($rd);

    my $buf      = '';
    my $saw_eof  = 0;
    my $deadline = time() + $timeout;
    while (time() < $deadline) {
        my $left = $deadline - time();
        last if $left <= 0;
        my $rin = '';
        vec($rin, fileno($rd), 1) = 1;
        my $nready = select($rin, undef, undef, $left);
        last if !defined $nready || $nready < 0;
        next if $nready == 0;
        my $n = sysread($rd, my $chunk, 1024);
        if (!defined $n) {
            next if $!{EINTR};
            last;
        }
        if ($n == 0) {
            $saw_eof = 1;
            last;
        }
        $buf .= $chunk;
        last if length($buf) > 8192;
    }
    close $rd;

    # Reap first. TERM/KILL only if it is still our child, so a finished
    # helper cannot lose its pid to an unrelated process.
    my $reaped = waitpid($pid, WNOHANG);
    if ($reaped == 0 && $saw_eof) {
        my $grace = time() + 2;
        while (time() < $grace) {
            $reaped = waitpid($pid, WNOHANG);
            last if $reaped != 0;
            select(undef, undef, undef, 0.05);
        }
    }
    if ($reaped == 0) {
        kill 'TERM', $pid;
        my $grace = time() + 1;
        while (time() < $grace) {
            $reaped = waitpid($pid, WNOHANG);
            last if $reaped != 0;
            select(undef, undef, undef, 0.05);
        }
    }
    if ($reaped == 0) {
        kill 'KILL', $pid;
        $reaped = waitpid($pid, 0);
    }
    return if $reaped <= 0 || $? != 0;

    my ($line) = split /\r?\n/, $buf, 2;
    return unless secret_line_ok($line);
    return $line;
}

sub secret_floor   { 60 }
sub secret_ceiling { 21600 }
sub secret_quiet   { 86400 }

# pass_cmd keeps its own wait. A live mailbox resets backoff after five
# minutes, and that must not pull a broken helper back to five seconds.
sub note_secret_failure {
    my ($name, $now) = @_;
    my $acc = $accounts{$name} or return;
    return if $acc->{disabled};
    $now //= time();
    my $wait = $acc->{secret_wait} || secret_floor();
    $wait = secret_floor()   if $wait < secret_floor();
    $wait = secret_ceiling() if $wait > secret_ceiling();
    $acc->{next_try} = $now + $wait;
    my $next = $wait * 2;
    $next = secret_ceiling() if $next > secret_ceiling();
    $acc->{secret_wait} = $next;
    my $said = $acc->{secret_said} // 0;
    if (!$said || $now - $said >= secret_quiet()) {
        $acc->{secret_said} = $now;
        log_error("$name: pass_cmd failed");
    }
}

sub note_secret_recovered {
    my ($name) = @_;
    my $acc = $accounts{$name} or return;
    return unless $acc->{secret_said};
    delete $acc->{secret_wait};
    delete $acc->{secret_said};
    log_info("$name: pass_cmd recovered");
}

sub account_pass {
    my ($name, $timeout) = @_;
    my $acc = $accounts{$name} or return;
    if (defined $acc->{pass_cmd}) {
        my $pw = capture_pass_cmd($acc->{pass_cmd}, $timeout);
        if (!defined $pw) {
            note_secret_failure($name);
            return;
        }
        note_secret_recovered($name);
        return $pw;
    }
    return $acc->{pass};
}

# One wait, every socket. A stalled handshake used to sit in a blocking
# SSL connect and the select loop never ran. 45s is the ceiling. While
# this socket waits, other IMAP sockets and mbsync are polled.
sub _wait_slice {
    my ($left) = @_;
    return $left unless $track_cfg;
    my $hint = eval { loop_timeout() };
    return $left unless defined $hint && $hint < $left;
    return $hint;
}

# OpenBSD SYS_pselect. A Perl SIGCHLD handler mallocs, and OpenBSD
# aborts if that happens inside malloc. A burst of mbsync exits did
# that. CHLD and INFO stay blocked except for the duration of pselect.
my $SYS_pselect = 110;
my $WAKE_HELD   = 0;
my $SELECT_MASK;

sub _wake_set {
    my $set  = POSIX::SigSet->new();
    my $chld = _signal_number('CHLD');
    my $info = _signal_number('INFO');
    $set->addset($chld) if defined $chld;
    $set->addset($info) if defined $info;
    return $set;
}

sub hold_wake_signals {
    return if $WAKE_HELD;
    $SELECT_MASK = POSIX::SigSet->new();
    POSIX::sigprocmask(POSIX::SIG_BLOCK(), _wake_set(), $SELECT_MASK);
    $WAKE_HELD = 1;
}

# Exec'd children must reap their own processes. The saved mask is the
# one from before CHLD and INFO were blocked.
sub _restore_wake_mask {
    return unless $WAKE_HELD && $SELECT_MASK;
    POSIX::sigprocmask(POSIX::SIG_SETMASK(), $SELECT_MASK);
}

sub _pselect {
    my $timeout = $_[3];
    unless ($WAKE_HELD) {
        return CORE::select($_[0], $_[1], $_[2], $timeout);
    }
    my $nfds = 0;
    for my $i (0, 1, 2) {
        next unless defined $_[$i];
        my $n = length($_[$i]) * 8;
        $nfds = $n if $n > $nfds;
    }
    if ($nfds > 0) {
        my $bytes = int(($nfds + 7) / 8);
        for my $i (0, 1, 2) {
            next unless defined $_[$i];
            my $len = length($_[$i]);
            $_[$i] .= "\0" x ($bytes - $len) if $len < $bytes;
        }
    }
    my $ts;
    if (defined $timeout) {
        my $sec  = int($timeout);
        $sec = 0 if $sec < 0;
        my $frac = $timeout - int($timeout);
        $frac = 0 if $frac < 0;
        my $nsec = int($frac * 1_000_000_000 + 0.5);
        if ($nsec >= 1_000_000_000) {
            $sec++;
            $nsec -= 1_000_000_000;
        }
        $ts = pack('q q', $sec, $nsec);
    }
    my $mask = $$SELECT_MASK;
    my $n    = syscall(
        $SYS_pselect, $nfds,
        (defined $_[0] ? $_[0] : undef),
        (defined $_[1] ? $_[1] : undef),
        (defined $_[2] ? $_[2] : undef),
        (defined $ts  ? $ts    : undef),
        $mask,
    );
    return undef if !defined $n || $n < 0;
    return $n;
}

sub _handles_ready {
    my ($timeout) = @_;
    my @handles = $select->handles;
    my ($rin, $win, $ein) = ('', '', '');
    for my $fh (@handles) {
        my $fd = fileno($fh);
        next unless defined $fd;
        vec($rin, $fd, 1) = 1;
    }
    _ctl_note($rin, $win);
    my $n = _pselect($rin, $win, $ein, $timeout);
    return () if !defined $n || $n <= 0;
    _ctl_dispatch($rin, $win);
    my @ready;
    for my $fh (@handles) {
        my $fd = fileno($fh);
        next unless defined $fd && vec($rin, $fd, 1);
        next if _ctl_is($fh);
        push @ready, $fh;
    }
    return @ready;
}

sub _fd_ready {
    my ($sock, $write, $timeout) = @_;
    my $fd = fileno($sock);
    return 0 unless defined $fd;
    if (!$write && eval { $sock->can('pending') && $sock->pending }) {
        return 1;
    }
    my ($rin, $win, $ein) = ('', '', '');
    if ($write) {
        vec($win, $fd, 1) = 1;
        vec($ein, $fd, 1) = 1;
    } else {
        vec($rin, $fd, 1) = 1;
    }
    my $n = _pselect($rin, $win, $ein, $timeout);
    return -1 if !defined $n || $n < 0;
    return $n > 0 ? 1 : 0;
}

sub _io_service {
    return if $IO_DEPTH || !$track_cfg;
    eval { reap_children() };
    my $phase = eval { shutdown_phase() } // '';
    pump_schedule() unless $phase;
}

sub _io_select {
    my ($focus, $write, $timeout) = @_;
    my $fd = fileno($focus);
    return 0 unless defined $fd;
    if (!$write && eval { $focus->can('pending') && $focus->pending }) {
        return 1;
    }
    my ($rin, $win, $ein) = ('', '', '');
    if ($write) {
        vec($win, $fd, 1) = 1;
        vec($ein, $fd, 1) = 1;
    } else {
        vec($rin, $fd, 1) = 1;
    }
    my @extra;
    for my $key (keys %conns) {
        my $sock = $conns{$key}{socket} or next;
        my $ofd = fileno($sock);
        next unless defined $ofd && $ofd != $fd;
        vec($rin, $ofd, 1) = 1;
        push @extra, $sock;
    }
    vec($rin, fileno($CHLD_R), 1) = 1 if $CHLD_R && defined fileno($CHLD_R);
    vec($rin, fileno($INFO_R), 1) = 1 if $INFO_R && defined fileno($INFO_R);
    _ctl_note($rin, $win);
    my $n = _pselect($rin, $win, $ein, $timeout);
    if (!defined $n || $n < 0) {
        return 0 if $!{EINTR};
        return -1;
    }
    return 0 if $n == 0;
    $IO_DEPTH++;
    eval {
        if ($CHLD_R && defined fileno($CHLD_R) && vec($rin, fileno($CHLD_R), 1)) {
            _drain_fd($CHLD_R);
            reap_children();
        }
        for my $sock (@extra) {
            my $ofd = fileno($sock);
            next unless defined $ofd && vec($rin, $ofd, 1);
            eval { handle_ready($sock) };
        }
        if ($INFO_R && defined fileno($INFO_R) && vec($rin, fileno($INFO_R), 1)) {
            _drain_info();
            report_info();
        }
        _ctl_dispatch($rin, $win);
    };
    $IO_DEPTH--;
    return 1 if $write && (vec($win, $fd, 1) || vec($ein, $fd, 1));
    return 1 if !$write && vec($rin, $fd, 1);
    return 0;
}

sub io_wait_fd {
    my ($sock, $write, $timeout) = @_;
    # A mapped IMAP socket waits up to that server's learned cap.
    # Connect and handshake sockets are not mapped yet, so they stay
    # on the global cap and the caller loops until its own deadline.
    my $cap = $IO_MAX;
    if ($sock) {
        my $fd = eval { fileno($sock) };
        $cap = server_read_cap(@{ $FD_SERVER{$fd} })
            if defined $fd && $FD_SERVER{$fd};
    }
    $timeout = $cap if !defined $timeout || $timeout > $cap;
    $timeout = 0 if $timeout < 0;
    # A login already in progress must not run on into IDLE.
    if (_shutdown_wanted()) {
        shutdown_phase();
        return 0;
    }
    if ($timeout <= 0 || $IO_DEPTH) {
        return _fd_ready($sock, $write, $timeout) > 0 ? 1 : 0;
    }
    my $deadline = Time::HiRes::time() + $timeout;
    while (1) {
        my $left = $deadline - Time::HiRes::time();
        last if $left <= 0;
        my $slice = _wait_slice($left);
        if ($slice <= 0) {
            _io_service();
            return 0 if _shutdown_wanted();
            my $hint = $track_cfg ? eval { loop_timeout() } : undef;
            $slice = (defined $hint && $hint > 0 && $hint < $left) ? $hint : ($left < 0.2 ? $left : 0.2);
        }
        my $rc = _io_select($sock, $write, $slice);
        _io_service();
        return 0 if _shutdown_wanted();
        return 1 if $rc > 0;
        return 0 if $rc < 0;
    }
    _io_service();
    return 0 if _shutdown_wanted();
    return 0;
}

sub imap_read_more {
    my $self = shift;
    my $opt = ref($_[0]) eq 'HASH' ? shift : {};
    my ($socket, $timeout) = @_;
    return 1 if $socket && eval { $socket->isa('IO::Socket::SSL') && $socket->pending };
    $timeout = 0 if !defined $timeout || $timeout < 0;
    my $fd = $socket ? eval { fileno($socket) } : undef;
    my $cap = $IO_MAX;
    my $raised;
    if (defined $fd && $FD_SERVER{$fd}) {
        $cap = server_read_cap(@{ $FD_SERVER{$fd} });
        $raised = $FD_SERVER{$fd};
    }
    $timeout = $cap if $timeout > $cap;
    if (defined $READ_DEADLINE) {
        my $left = $READ_DEADLINE - Time::HiRes::time();
        if ($left <= 0) {
            $self->LastError('timeout waiting for server');
            return 0;
        }
        $timeout = $left if $left < $timeout;
    }
    my $err_on = exists $opt->{error_on_timeout} ? $opt->{error_on_timeout} : 1;
    return 1 if io_wait_fd($socket, 0, $timeout);
    return 0 unless $err_on;
    if ($raised) {
        delete $FD_SERVER{$fd} if defined $fd;
        raise_server_read_cap(@$raised);
    }
    $self->LastError("timeout waiting ${timeout}s for data from server");
    $self->_disconnect if $self->can('_disconnect');
    return 0;
}

sub _tcp_connect {
    my ($host, $port, $deadline) = @_;
    my $left = $deadline - Time::HiRes::time();
    die "tcp timeout\n" if $left <= 0;
    my $sock;
    my $err = 0;
    eval {
        local $SIG{ALRM} = sub { die "tcp timeout\n" };
        Time::HiRes::alarm($left);
        $sock = IO::Socket::IP->new(
            PeerHost => $host,
            PeerPort => $port,
            Proto    => 'tcp',
            Blocking => 0,
        ) or die 'tcp: ' . ($@ || $!) . "\n";
        # Non-blocking new() returns the socket for refusal and for
        # EINPROGRESS. $! is the outcome, and the next call replaces it.
        $err = $! + 0;
        Time::HiRes::alarm(0);
        1;
    };
    Time::HiRes::alarm(0);
    die $@ if $@;
    if ($err && $err != EINPROGRESS() && $err != EWOULDBLOCK()) {
        $! = $err;
        die "tcp connect: $!\n";
    }
    while (1) {
        my $remain = $deadline - Time::HiRes::time();
        die "tcp timeout\n" if $remain <= 0;
        if ($sock->connect()) {
            last unless $!;
            die "tcp connect: $!\n";
        }
        if ($!{EINPROGRESS} || $!{EWOULDBLOCK} || $!{EINTR}) {
            io_wait_fd($sock, 1, $remain) or die "tcp timeout\n";
            next;
        }
        die "tcp connect: $!\n";
    }
    $sock->blocking(0);
    return $sock;
}

# IANA extension ids. Names match openssl s_client -tlsextdebug.
# Stable extensions are stored as a hex dump. Key shares and verify
# data are a fixed length but a new value every handshake, so only the
# length is kept. Tickets and OCSP responses change length as well, so
# those records name the extension and nothing else. The file then stays
# the same until the client offer or the server selection changes.
my %TLS_EXT_NAME = (
    0     => 'server name',
    1     => 'max fragment length',
    5     => 'status request',
    10    => 'supported groups',
    11    => 'EC point formats',
    13    => 'signature algorithms',
    16    => 'application layer protocol negotiation',
    18    => 'signed certificate timestamp',
    21    => 'TLS padding',
    22    => 'encrypt-then-mac',
    23    => 'extended master secret',
    35    => 'session ticket',
    41    => 'pre shared key',
    42    => 'early data',
    43    => 'supported versions',
    44    => 'cookie',
    45    => 'PSK key exchange modes',
    47    => 'certificate authorities',
    49    => 'post handshake auth',
    50    => 'signature algorithms cert',
    51    => 'key share',
    65281 => 'renegotiation info',
);
my %TLS_EXT_STABLE = map { $_ => 1 } (0, 1, 10, 11, 13, 16, 21, 22, 23, 43, 45, 47, 49, 50);
my %TLS_EXT_OMIT_LEN = map { $_ => 1 } (5, 18, 35, 41, 42, 44);

sub _tls_u8 {
    my ($buf, $off) = @_;
    return if $off + 1 > length $$buf;
    return ($off + 1, ord(substr($$buf, $off, 1)));
}

sub _tls_u16 {
    my ($buf, $off) = @_;
    return if $off + 2 > length $$buf;
    return ($off + 2, unpack('n', substr($$buf, $off, 2)));
}

sub _tls_u24 {
    my ($buf, $off) = @_;
    return if $off + 3 > length $$buf;
    return ($off + 3, unpack('N', "\0" . substr($$buf, $off, 3)));
}

sub _bio_dump {
    my $data = defined $_[0] ? "$_[0]" : '';
    return '' if $data eq '';
    my $trailing = 0;
    while (length $data && (substr($data, -1, 1) eq "\0" || substr($data, -1, 1) eq ' ')) {
        chop $data;
        $trailing++;
    }
    my $out = '';
    my $off = 0;
    while ($off < length $data) {
        my $row = substr($data, $off, 16);
        my $take = length $row;
        $out .= sprintf('%04x - ', $off);
        my $ascii = '';
        for my $i (0 .. $take - 1) {
            my $c = substr($row, $i, 1);
            $out .= sprintf('%02x%s', ord($c), $i == 7 ? '-' : ' ');
            $ascii .= ($c =~ /[ -~]/) ? $c : '.';
        }
        $out .= ' ' x (3 * (16 - $take) + 2);
        $out .= "$ascii\n";
        $off += $take;
    }
    $out .= sprintf("%04x - <SPACES/NULS>\n", $off + $trailing) if $trailing;
    return $out;
}

sub _tls_extensions {
    my ($body, $off) = @_;
    return if $off > length $body;
    return () if $off == length $body;
    my ($o, $elen) = _tls_u16(\$body, $off);
    return unless defined $o;
    return if $o + $elen > length $body;
    my $end = $o + $elen;
    my @ext;
    while ($o + 4 <= $end) {
        my ($o2, $type) = _tls_u16(\$body, $o);
        last unless defined $o2;
        my ($o3, $len) = _tls_u16(\$body, $o2);
        last unless defined $o3 && $o3 + $len <= $end;
        push @ext, [ $type, substr($body, $o3, $len) ];
        $o = $o3 + $len;
    }
    return @ext;
}

sub _tls_hello_ext_off {
    my ($body, $server) = @_;
    return if length $body < 35;
    my $o = 34;
    my ($o2, $slen) = _tls_u8(\$body, $o);
    return unless defined $o2;
    $o = $o2 + $slen;
    if ($server) {
        return if $o + 3 > length $body;
        return $o + 3;
    }
    my ($o3, $clen) = _tls_u16(\$body, $o);
    return unless defined $o3;
    $o = $o3 + $clen;
    my ($o4, $complen) = _tls_u8(\$body, $o);
    return unless defined $o4;
    return $o4 + $complen;
}

sub _tls_ext_record {
    my ($who, $id, $data) = @_;
    my $name = $TLS_EXT_NAME{$id} // 'unknown';
    if ($TLS_EXT_OMIT_LEN{$id}) {
        return "TLS $who extension \"$name\" (id=$id)\nephemeral\n";
    }
    my $head = sprintf('TLS %s extension "%s" (id=%d), len=%d',
        $who, $name, $id, length $data);
    return "$head\nephemeral\n" unless $TLS_EXT_STABLE{$id};
    my $dump = _bio_dump($data);
    return $dump eq '' ? "$head\n" : "$head\n$dump";
}

# Handshake messages only. Certificate bytes are archived on their own.
sub _tls_extension_lines {
    my ($dir, $msg) = @_;
    return unless defined $msg && length $msg >= 4;
    my ($o, $type) = _tls_u8(\$msg, 0);
    my ($o2, $hlen) = _tls_u24(\$msg, $o);
    return unless defined $o2 && $o2 + $hlen <= length $msg;
    my $body = substr($msg, $o2, $hlen);
    my $off;
    if ($type == 1) {
        $off = _tls_hello_ext_off($body, 0);
    } elsif ($type == 2) {
        $off = _tls_hello_ext_off($body, 1);
    } elsif ($type == 8) {
        $off = 0;
    } elsif ($type == 13) {
        my ($c, $clen) = _tls_u8(\$body, 0);
        return unless defined $c;
        $off = $c + $clen;
    } else {
        return;
    }
    return unless defined $off;
    my $who = $dir ? 'client' : 'server';
    my @lines;
    for my $ext (_tls_extensions($body, $off)) {
        push @lines, _tls_ext_record($who, $ext->[0], $ext->[1]);
    }
    return @lines;
}

sub _tls_clear_callback {
    my ($ssl) = @_;
    return unless $ssl && $ssl->can('set_msg_callback');
    eval { $ssl->set_msg_callback(undef) };
}

sub _save_hashed_file {
    my ($kind, $host, $port, $body) = @_;
    return if $DRY_RUN;
    return unless defined $STATE_DIR && $STATE_DIR ne '';
    return unless defined $body && $body ne '';
    return unless defined $host && $host ne '' && defined $port && $port ne '';
    my $label = "$host:$port";
    $label =~ s{[\\/\0]}{_}g;
    return if $label eq '';
    my $year = (localtime)[5] + 1900;
    my $hash = unpack('H*', sha1($body));
    my $dir  = "$STATE_DIR/$kind/$year";
    my $path = "$dir/$hash-$label";
    return $path if -e $path;
    make_path($dir, { mode => 0700 });
    chmod 0700, "$STATE_DIR/$kind", $dir;
    my $tmp = "$path.tmp.$$";
    my $old = umask 077;
    my $ok = open my $fh, '>', $tmp;
    if (!$ok) {
        umask $old;
        log_error("tls save $path: $!");
        return;
    }
    binmode $fh;
    print $fh $body;
    my $closed = close $fh;
    umask $old;
    if (!$closed) {
        unlink $tmp;
        log_error("tls save $path: $!");
        return;
    }
    if (!rename($tmp, $path)) {
        unlink $tmp if -e $path;
        if (!-e $path) {
            log_error("tls save $path: $!");
            return;
        }
    }
    chmod 0600, $path;
    my $what = $kind eq 'certs' ? 'cert' : 'negotiation';
    log_info("$label: tls $what $hash");
    return $path;
}

sub _tls_cert_body {
    my ($ssl) = @_;
    my @chain = eval { $ssl->peer_certificates };
    return unless @chain;
    my @out = ("---\n", "Certificate chain\n");
    for my $i (0 .. $#chain) {
        my $cert = $chain[$i] or next;
        my $subj = Net::SSLeay::X509_NAME_oneline(
            Net::SSLeay::X509_get_subject_name($cert)) // '';
        my $iss = Net::SSLeay::X509_NAME_oneline(
            Net::SSLeay::X509_get_issuer_name($cert)) // '';
        my $pem = Net::SSLeay::PEM_get_string_X509($cert) // '';
        $pem .= "\n" if $pem ne '' && $pem !~ /\n\z/;
        push @out, sprintf("%2d s:%s\n", $i, $subj);
        push @out, "   i:$iss\n";
        push @out, $pem if $pem ne '';
    }
    my $leaf = $chain[0];
    my $subj = Net::SSLeay::X509_NAME_oneline(
        Net::SSLeay::X509_get_subject_name($leaf)) // '';
    my $iss = Net::SSLeay::X509_NAME_oneline(
        Net::SSLeay::X509_get_issuer_name($leaf)) // '';
    push @out, "---\n", "Server certificate\n", "subject=$subj\n", "issuer=$iss\n";
    return join('', @out);
}

my $CERT_NOW;

# Tests pin the clock. Production uses the current second.
sub cert_now {
    return $CERT_NOW if defined $CERT_NOW;
    return time();
}

sub set_cert_now_for_test {
    ($CERT_NOW) = @_;
}

sub cert_warn_interval { 7 * 24 * 3600 }

sub _cert_warn_file {
    return unless defined $STATE_DIR && $STATE_DIR ne '';
    return "$STATE_DIR/cert-warn";
}

my %CERT_WARN;
my $CERT_WARN_LOADED = 0;
my $CERT_WARN_PATH   = '';

sub _cert_warn_invalidate {
    %CERT_WARN = ();
    $CERT_WARN_LOADED = 0;
    $CERT_WARN_PATH = '';
}

sub _cert_warn_load_disk {
    my $path = _cert_warn_file() // '';
    %CERT_WARN = ();
    $CERT_WARN_LOADED = 1;
    $CERT_WARN_PATH = $path;
    _state_mark($path) if $path ne '';
    return if $path eq '' || !-f $path;
    open my $fh, '<', $path or return;
    while (my $line = <$fh>) {
        next if $line =~ /^\s*(?:#|$)/;
        chomp $line;
        my ($id, $when) = split /\t/, $line, 2;
        next unless defined $id && $id ne '' && defined $when && $when =~ /^\d+\z/;
        $CERT_WARN{$id} = $when;
    }
    close $fh;
    _state_mark($path);
}

sub load_cert_warn {
    my $path = _cert_warn_file() // '';
    if ($path ne $CERT_WARN_PATH || !$CERT_WARN_LOADED) {
        _cert_warn_load_disk();
    }
    return %CERT_WARN;
}

sub save_cert_warn {
    my (%when) = @_;
    return if $DRY_RUN;
    my $path = _cert_warn_file() or return;
    my $tmp = "$path.tmp.$$";
    my $old = umask 077;
    my $ok = open my $fh, '>', $tmp;
    if (!$ok) {
        umask $old;
        log_error("cert-warn $path: $!");
        return;
    }
    print $fh "# imapidle cert-warn\n";
    print $fh "# entry\tlast-warning-epoch\n\n";
    for my $id (sort keys %when) {
        print $fh "$id\t$when{$id}\n";
    }
    my $closed = close $fh;
    umask $old;
    if (!$closed || !rename($tmp, $path)) {
        unlink $tmp;
        log_error("cert-warn $path: $!");
        return;
    }
    chmod 0600, $path;
    %CERT_WARN = %when;
    $CERT_WARN_LOADED = 1;
    $CERT_WARN_PATH = $path;
    _state_mark($path);
}

sub _load_pem_x509 {
    my ($pem) = @_;
    return unless defined $pem && $pem ne '';
    my $bio = Net::SSLeay::BIO_new(Net::SSLeay::BIO_s_mem());
    return unless $bio;
    my $n = Net::SSLeay::BIO_write($bio, $pem);
    my $x = Net::SSLeay::PEM_read_bio_X509($bio) if defined $n && $n > 0;
    Net::SSLeay::BIO_free($bio);
    return $x;
}

sub _cert_label {
    my ($i) = @_;
    return $i ? "certificate $i" : 'server certificate';
}

sub _asn1_iso {
    my ($cert, $which) = @_;
    my $t = $which eq 'before'
        ? Net::SSLeay::X509_get_notBefore($cert)
        : Net::SSLeay::X509_get_notAfter($cert);
    return '' unless $t;
    return Net::SSLeay::P_ASN1_TIME_get_isotime($t) // '';
}

sub _iso_now {
    my @t = gmtime($_[0]);
    return sprintf('%04d-%02d-%02dT%02d:%02d:%02dZ',
        $t[5] + 1900, $t[4] + 1, $t[3], $t[2], $t[1], $t[0]);
}

sub _has_san {
    my ($cert) = @_;
    my $want = Net::SSLeay::OBJ_txt2nid('subjectAltName') or return 0;
    my $n = Net::SSLeay::X509_get_ext_count($cert);
    return 0 unless defined $n && $n > 0;
    for (my $i = 0; $i < $n; $i++) {
        my $ext = Net::SSLeay::X509_get_ext($cert, $i) or next;
        my $obj = Net::SSLeay::X509_EXTENSION_get_object($ext) or next;
        my $nid = Net::SSLeay::OBJ_obj2nid($obj);
        return 1 if $nid && $nid == $want;
    }
    return 0;
}

sub _name_matches {
    my ($cert, $host) = @_;
    return 0 if !defined $host || $host eq '';
    my $ip = $host;
    $ip =~ s/^\[(.*)\]\z/$1/;
    if ($ip =~ /:/ || $ip =~ /^\d{1,3}(?:\.\d{1,3}){3}\z/) {
        my $r = eval { Net::SSLeay::X509_check_ip_asc($cert, $ip, 0) };
        return 1 if $r && $r > 0;
    }
    my $name = $host;
    my $r = eval { Net::SSLeay::X509_check_host($cert, $name) };
    return 1 if $r && $r > 0;
    return 0;
}

sub _key_fact {
    my ($cert) = @_;
    my $pk = Net::SSLeay::X509_get_pubkey($cert) or return ('', 0);
    my $bits = Net::SSLeay::EVP_PKEY_bits($pk) // 0;
    my $id = Net::SSLeay::EVP_PKEY_id($pk) // 0;
    my $sn = $id ? (Net::SSLeay::OBJ_nid2sn($id) // '') : '';
    Net::SSLeay::EVP_PKEY_free($pk);
    return ($sn, $bits);
}

sub _key_warning {
    my ($label, $sn, $bits) = @_;
    $sn //= '';
    $bits //= 0;
    if ($sn =~ /dsa/i) {
        return "$label public key $sn is not suitable";
    }
    if ($sn =~ /ec/i) {
        return "$label public key $sn $bits is shorter than 224"
            if $bits && $bits < 224;
        return;
    }
    if ($bits && $bits < 2048) {
        my $what = $sn ne '' ? "$sn $bits" : "$bits-bit";
        return "$label public key $what is shorter than 2048";
    }
    return;
}

sub _sig_name {
    my ($cert) = @_;
    my $alg = Net::SSLeay::P_X509_get_signature_alg($cert) or return '';
    my $nid = Net::SSLeay::OBJ_obj2nid($alg) or return '';
    return Net::SSLeay::OBJ_nid2sn($nid) // '';
}

# Time is checked on its own, so an expired chain still reports the signer.
sub _authority_problem {
    my ($certs) = @_;
    return 'certificate chain could not be checked' unless $certs && $certs->[0];
    my $ctx = Net::SSLeay::CTX_new() or return 'trust store could not be opened';
    my $loaded = Net::SSLeay::CTX_load_verify_locations($ctx, '/etc/ssl/cert.pem', '');
    if (!$loaded) {
        Net::SSLeay::CTX_free($ctx);
        return 'trust store /etc/ssl/cert.pem could not be read';
    }
    my $store = Net::SSLeay::CTX_get_cert_store($ctx);
    my $flag = eval { Net::SSLeay::X509_V_FLAG_NO_CHECK_TIME() };
    Net::SSLeay::X509_STORE_set_flags($store, $flag) if $store && $flag;
    my $sk;
    if (@$certs > 1) {
        $sk = Net::SSLeay::sk_X509_new_null();
        Net::SSLeay::sk_X509_push($sk, $certs->[$_]) for 1 .. $#$certs;
    }
    my $sctx = Net::SSLeay::X509_STORE_CTX_new();
    my $init = $sctx && Net::SSLeay::X509_STORE_CTX_init($sctx, $store, $certs->[0], $sk || 0);
    my $problem = '';
    if (!$init) {
        $problem = 'certificate chain could not be checked';
    } else {
        my $ok = Net::SSLeay::X509_verify_cert($sctx);
        if (!$ok) {
            my $err = Net::SSLeay::X509_STORE_CTX_get_error($sctx);
            my $str = Net::SSLeay::X509_verify_cert_error_string($err) // 'unknown error';
            if ($str !~ /not yet valid|has expired/i) {
                my $depth = Net::SSLeay::X509_STORE_CTX_get_error_depth($sctx) // 0;
                my $where = $depth ? ' (certificate ' . $depth . ')' : '';
                $problem = "not a trusted authority ($str$where)";
            }
        }
    }
    Net::SSLeay::X509_STORE_CTX_free($sctx) if $sctx;
    Net::SSLeay::sk_X509_free($sk) if $sk;
    Net::SSLeay::CTX_free($ctx);
    return $problem;
}

sub cert_problems {
    my ($host, $text) = @_;
    my @pem = $text =~ /(-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----)/sg;
    return ('certificate chain is empty') unless @pem;
    my @x;
    my @problems;
    my $now = _iso_now(cert_now());
    for my $i (0 .. $#pem) {
        my $x = _load_pem_x509($pem[$i]);
        $x[$i] = $x;
        my $label = _cert_label($i);
        if (!$x) {
            push @problems, "$label could not be read";
            next;
        }
        my $before = _asn1_iso($x, 'before');
        my $after  = _asn1_iso($x, 'after');
        if ($before eq '') {
            push @problems, "$label has no notBefore";
        } elsif ($before gt $now) {
            push @problems, "$label not valid until $before";
        }
        if ($after eq '') {
            push @problems, "$label has no notAfter";
        } elsif ($after lt $now) {
            push @problems, "$label expired $after";
        }
        if ($i == 0) {
            if (!_name_matches($x, $host)) {
                push @problems, "$label name does not match $host";
            }
            if (!_has_san($x)) {
                push @problems, "$label has no subjectAltName";
            }
            my $ver = Net::SSLeay::X509_get_version($x);
            if (!defined $ver || $ver < 2) {
                push @problems, "$label is not X.509 v3";
            }
        }
        my ($sn, $bits) = _key_fact($x);
        my $kw = _key_warning($label, $sn, $bits);
        push @problems, $kw if $kw;
        my $sig = _sig_name($x);
        if ($sig eq '') {
            push @problems, "$label signature algorithm is unknown";
        } elsif ($sig =~ /SHA-?1(?!\d)|MD[245]/i) {
            push @problems, "$label signature $sig is weak";
        }
    }
    for my $i (0 .. $#x - 1) {
        next unless $x[$i] && $x[$i + 1];
        my $cmp = Net::SSLeay::X509_NAME_cmp(
            Net::SSLeay::X509_get_issuer_name($x[$i]),
            Net::SSLeay::X509_get_subject_name($x[$i + 1]));
        if ($cmp) {
            push @problems, _cert_label($i) . ' issuer is not ' . _cert_label($i + 1);
            next;
        }
        my $pk = Net::SSLeay::X509_get_pubkey($x[$i + 1]);
        if (!$pk) {
            push @problems, _cert_label($i + 1) . ' has no public key';
            next;
        }
        my $signed = Net::SSLeay::X509_verify($x[$i], $pk);
        Net::SSLeay::EVP_PKEY_free($pk);
        if (!$signed || $signed < 1) {
            push @problems, _cert_label($i + 1) . ' did not sign ' . _cert_label($i);
        }
    }
    if (@x && !grep { !$_ } @x) {
        my $auth = _authority_problem(\@x);
        push @problems, $auth if defined $auth && $auth ne '';
    }
    Net::SSLeay::X509_free($_) for grep { $_ } @x;
    return @problems;
}

sub consider_cert_warnings {
    my ($host, $port, $path, $body) = @_;
    return unless defined $path && $path ne '';
    my ($id) = $path =~ m{([^/]+)\z};
    return unless defined $id && $id ne '';
    my @problems = cert_problems($host, $body // '');
    return unless @problems;
    my $now = cert_now();
    my %when = load_cert_warn();
    my $last = $when{$id} // 0;
    return if $last && $now >= $last && $now - $last < cert_warn_interval();
    my $label = "$host:$port";
    log_warn("$label: cert $_") for @problems;
    $when{$id} = int($now);
    save_cert_warn(%when);
}

sub _tls_chain_lines {
    my ($ssl) = @_;
    my @chain = eval { $ssl->peer_certificates };
    my @lines;
    for my $i (0 .. $#chain) {
        my $fp = eval { $ssl->get_fingerprint('SHA256', $chain[$i]) } // '';
        push @lines, "chain $i: $fp\n";
    }
    my $bits = '';
    if (@chain && $chain[0]) {
        my $pkey = eval { Net::SSLeay::X509_get_pubkey($chain[0]) };
        if ($pkey) {
            $bits = eval { Net::SSLeay::EVP_PKEY_bits($pkey) } // '';
            Net::SSLeay::EVP_PKEY_free($pkey);
        }
    }
    return ($bits, @lines);
}

sub _save_tls_observation {
    my ($ssl, $host, $port, $ext) = @_;
    return unless $ssl;
    my $obj = eval { $ssl->_get_ssl_object };
    my @ciphers;
    if ($obj) {
        for (my $i = 0; $i < 256; $i++) {
            my $c = Net::SSLeay::get_cipher_list($obj, $i);
            last unless defined $c && $c ne '';
            push @ciphers, $c;
        }
    }
    my $ciphers = join(':', @ciphers);
    # LibreSSL offers the same extensions in a different order on each
    # handshake. Sort by side and id so the file changes only when an
    # extension does.
    my @ext = sort {
        my ($aw, $aid) = $a =~ /^TLS (\S+) extension .*?\(id=(\d+)\)/;
        my ($bw, $bid) = $b =~ /^TLS (\S+) extension .*?\(id=(\d+)\)/;
        ($aw // '') cmp ($bw // '')
            || ($aid // 0) <=> ($bid // 0)
            || $a cmp $b;
    } @{ $ext // [] };
    my @client = grep { /^TLS client extension / } @ext;
    my $offer = unpack('H*', sha1(join('', "ciphers $ciphers\n", @client)));
    my $lib = Net::SSLeay::SSLeay_version(0) // '';
    chomp $lib;
    my $verify = ($obj && eval { Net::SSLeay::get_verify_mode($obj) }) // '';
    my $min = ($obj && eval { Net::SSLeay::get_min_proto_version($obj) });
    my $max = ($obj && eval { Net::SSLeay::get_max_proto_version($obj) });
    $min = '' unless defined $min;
    $max = '' unless defined $max;
    my ($pkbits, @chain) = _tls_chain_lines($ssl);
    my $version = eval { $ssl->get_sslversion } // '';
    my $cipher  = eval { $ssl->get_cipher } // '';
    my $bits = '';
    if ($obj) {
        my @got = eval { Net::SSLeay::get_cipher_bits($obj) };
        $bits = $got[0] // '';
    }
    my $body = join('',
        "library: $lib\n",
        "sni: $host\n",
        "verify mode: $verify\n",
        "proto min: $min\n",
        "proto max: $max\n",
        "offered ciphers: $ciphers\n",
        "offered sha1: $offer\n",
        "\n",
        @ext,
        "---\n",
        "version: $version\n",
        "cipher: $cipher\n",
        "cipher bits: $bits\n",
        (defined $pkbits && $pkbits ne '' ? "server public key: $pkbits bit\n" : ()),
        "compression: NONE\n",
        @chain,
    );
    _save_hashed_file('tls-negotiations', $host, $port, $body);
    my $certs = _tls_cert_body($ssl);
    return unless defined $certs && $certs ne '';
    my $path = _save_hashed_file('certs', $host, $port, $certs);
    return unless $path;
    eval { consider_cert_warnings($host, $port, $path, $certs) };
    log_error('cert check: ' . scrub($@)) if $@;
}

sub _ssl_handshake {
    my ($sock, $host, $port, $deadline) = @_;
    my $ssl = IO::Socket::SSL->start_SSL(
        $sock,
        SSL_startHandshake => 0,
        SSL_verify_mode    => SSL_VERIFY_NONE,
        SSL_hostname       => $host,
    );
    die 'ssl: ' . (IO::Socket::SSL::errstr() // 'start failed') . "\n" unless $ssl;
    $ssl->blocking(0);
    my @tls_ext;
    if ($ssl->can('set_msg_callback')) {
        $ssl->set_msg_callback(sub {
            my ($self, $dir, $ver, $ct, $buf, $len) = @_;
            return unless defined $ct && $ct == 22 && defined $buf;
            my $n = length $buf;
            $n = $len if defined $len && $len >= 0 && $len < $n;
            push @tls_ext, _tls_extension_lines($dir, substr($buf, 0, $n));
        });
    }
    my $up = eval {
        while (1) {
            my $remain = $deadline - Time::HiRes::time();
            die "ssl timeout\n" if $remain <= 0;
            my $ok = eval { $ssl->connect_SSL() };
            return 1 if $ok;
            if ($ssl->want_read) {
                io_wait_fd($ssl, 0, $remain) or die "ssl timeout\n";
                next;
            }
            if ($ssl->want_write) {
                io_wait_fd($ssl, 1, $remain) or die "ssl timeout\n";
                next;
            }
            die 'ssl: ' . ($ssl->errstr // $!) . "\n";
        }
    };
    my $boom = $@ unless $up;
    _tls_clear_callback($ssl);
    die $boom if $boom;
    eval { _save_tls_observation($ssl, $host, $port, \@tls_ext) };
    log_error('tls save: ' . scrub($@)) if $@;
    return $ssl;
}

sub _nb_read_line {
    my ($sock, $deadline) = @_;
    my $line = '';
    while (1) {
        my $remain = $deadline - Time::HiRes::time();
        die "starttls timeout\n" if $remain <= 0;
        io_wait_fd($sock, 0, $remain) or die "starttls timeout\n";
        my $n = sysread($sock, my $byte, 1);
        if (!defined $n) {
            next if $!{EINTR} || $!{EAGAIN} || $!{EWOULDBLOCK};
            die "starttls read: $!\n";
        }
        die "starttls closed\n" if $n == 0;
        $line .= $byte;
        last if $byte eq "\n";
        die "starttls line too long\n" if length($line) > 8192;
    }
    $line =~ s/\r?\n\z//;
    return $line;
}

sub _nb_write_all {
    my ($sock, $data, $deadline) = @_;
    while (length $data) {
        my $remain = $deadline - Time::HiRes::time();
        die "starttls timeout\n" if $remain <= 0;
        io_wait_fd($sock, 1, $remain) or die "starttls timeout\n";
        my $n = syswrite($sock, $data);
        if (!defined $n) {
            next if $!{EINTR} || $!{EAGAIN} || $!{EWOULDBLOCK};
            die "starttls write: $!\n";
        }
        die "starttls closed\n" if $n == 0;
        substr($data, 0, $n, '');
    }
}

# Clear greeting, then STARTTLS, then the same handshake as implicit TLS.
sub _imap_starttls {
    my ($sock, $deadline) = @_;
    my $greet = _nb_read_line($sock, $deadline);
    die "starttls greeting\n" unless $greet =~ /^\*\s+(OK|PREAUTH)\b/i;
    _nb_write_all($sock, "A001 STARTTLS\r\n", $deadline);
    my $reply = _nb_read_line($sock, $deadline);
    die "starttls rejected\n" unless $reply =~ /^A001\s+OK\b/i;
}

sub tcp_ssl_connect {
    my ($host, $port) = @_;
    my $deadline = Time::HiRes::time() + $IO_MAX;
    my $sock = _tcp_connect($host, $port, $deadline);
    my $ssl = _ssl_handshake($sock, $host, $port, $deadline);
    cloexec($ssl);
    $ssl->blocking(0);
    return $ssl;
}

# tls is implicit TLS. starttls upgrades after the greeting. notls
# stays on the clear socket and does not collect a certificate.
sub imap_transport {
    my ($name, $acc) = @_;
    my $proto = $acc->{proto} // 'tls';
    my $host  = $acc->{server};
    my $port  = $acc->{port};
    my $deadline = Time::HiRes::time() + server_read_cap($host, $port);
    my $sock;
    eval { $sock = _tcp_connect($host, $port, $deadline); 1 };
    if ($@) {
        my $err = $@;
        raise_server_read_cap($host, $port) if $err =~ /tcp timeout/;
        die $err;
    }
    if ($proto eq 'notls') {
        log_info("$name: cleartext");
        cloexec($sock);
        $sock->blocking(0);
        _note_fd_server($sock, $host, $port);
        return $sock;
    }
    _imap_starttls($sock, $deadline) if $proto eq 'starttls';
    my $ssl = _ssl_handshake($sock, $host, $port, $deadline);
    cloexec($ssl);
    $ssl->blocking(0);
    _note_fd_server($ssl, $host, $port);
    return $ssl;
}

sub set_login_hook_for_test { $LOGIN_FOR_TEST = $_[0]; }

sub login_imap {
    my ($name, $acc, $password) = @_;
    # Tests die with a server refusal or return a session. A real
    # login, including --tunnel, stays on the path below.
    if ($LOGIN_FOR_TEST) {
        my @got = $LOGIN_FOR_TEST->($name, $acc, $password);
        return @got if @got;
    }
    my $socket = imap_transport($name, $acc);
    cloexec($socket);

    if (($acc->{proto} // 'tls') ne 'notls') {
        my $fingerprint = $socket->get_fingerprint('SHA256');
        if (!approve_fingerprint($acc->{server}, $acc->{port}, $fingerprint,
                _tls_session_facts($socket))) {
            _forget_fd_server($socket);
            $socket->close;
            die 'Certificate fingerprint missing';
        }
    }

    my %login = (
        Socket   => $socket,
        User     => $acc->{user},
        Password => $password,
    );
    if (($acc->{auth} // 'login') eq 'xoauth2') {
        my $step = 0;
        $login{Authmechanism} = 'XOAUTH2';
        $login{Authcallback}  = sub {
            return '' if $step++;
            return xoauth2_initial($acc->{user}, $password);
        };
    }
    $login{Timeout}        = server_read_cap($acc->{server}, $acc->{port});
    $login{Readmoremethod} = \&imap_read_more;
    my $imap = ImapidleClient->new(%login);
    $socket->blocking(0) if $socket && $socket->can('blocking');
    # CAPABILITY clears LastError. Keep the login failure.
    my $login_err = $imap ? $imap->LastError : $@;
    _note_server_auth($acc->{server}, $acc->{port}, $imap) if $imap;
    unless ($imap && $imap->IsAuthenticated) {
        my $err = _scrub_login($login_err, $acc, $password);
        imap_logout($imap);
        _forget_fd_server($socket);
        $socket->close;
        die "IMAP login: $err";
    }
    cloexec($imap->Socket) if $imap->Socket;
    return ($socket, $imap);
}

sub create_imap_connection {
    my ($name, $acc, $folder, $password) = @_;
    my ($socket, $imap) = login_imap($name, $acc, $password);
    unless ($imap->select($folder)) {
        my $err = _scrub_login($imap->LastError, $acc, $password);
        imap_logout($imap);
        _forget_fd_server($socket);
        $socket->close;
        die "SELECT $folder: $err";
    }
    return ($socket, $imap);
}

sub readable_server_id {
    my ($line) = @_;
    return 'unknown' unless defined $line && $line ne '';
    if ($line =~ /dovecot/i) {
        return "dovecot-$1" if $line =~ /dovecot.*?(\d+\.\d+)/i;
        return 'dovecot-unknown';
    }
    return 'cyrus' if $line =~ /cyrus/i;
    return 'other';
}

sub detect_server_version {
    my ($imap) = @_;
    my @resp = $imap->tag_and_run(id_command());
    return 'unknown' unless @resp;
    return readable_server_id(join(' ', @resp));
}

sub _cmd_failed {
    my (@lines) = @_;
    return 1 unless @lines;
    return 1 if @lines == 1 && !defined $lines[0];
    my $last = $lines[-1] // '';
    return 1 if $last =~ /(?:^|\s)(?:NO|BAD)(?:\s|$)/i && $last !~ /(?:^|\s)OK(?:\s|$)/i;
    return 0;
}

sub id_is_due {
    my ($row, $now) = @_;
    $now //= time();
    $row //= {};
    if (($row->{id_status} // '') eq 'unsupported' && ($row->{id_next} // 0) > $now) {
        return 0;
    }
    if (($row->{id_hash} // '') ne '' && ($row->{id_next} // 0) > $now) {
        return 0;
    }
    return 1;
}

sub cap_is_due {
    my ($server, $port, $now) = @_;
    $now //= time();
    return 0 unless defined $server && defined $port;
    my %rows = load_learned();
    my $host = "$server:$port";
    my $row  = $rows{$host};
    return 1 unless $row;
    return 1 if $row->{cap_force};
    if (defined $row->{cap_next} && $row->{cap_next} ne '' && $row->{cap_next} =~ /^\d+(?:\.\d+)?\z/) {
        return ($row->{cap_next} + 0) <= $now ? 1 : 0;
    }
    if (($row->{notify} // '') =~ /^(absent|rejected|active)\z/) {
        $row->{cap_next} = $now + ($track_cfg->{capability} // 604800);
        $rows{$host} = $row;
        save_learned(%rows);
        return 0;
    }
    return 1;
}

sub apply_id_result {
    my ($server, $port, $lines, $now) = @_;
    $now //= time();
    return unless defined $server && defined $port;
    my $host = "$server:$port";
    my %rows = load_learned();
    my $row  = $rows{$host} // { notify => '', id => '' };
    my $interval = ($row->{id_interval} // 0) + 0;
    $interval = $track_cfg->{id} if $interval <= 0;
    $lines //= [];

    if (_cmd_failed(@$lines)) {
        $row->{id_status}   = 'unsupported';
        $row->{id_interval} = $interval;
        $row->{id_next}     = $now + $interval;
        $row->{id_quiet}    = 0;
        $rows{$host} = $row;
        save_learned(%rows);
        log_info("$host: id unsupported");
        return;
    }

    my $text = join(' ', grep { defined } @$lines);
    my $hash = id_reply_hash($text);
    my $prev = $row->{id_hash} // '';
    my $readable = readable_server_id($text);
    $row->{id} = $readable if defined $readable && $readable =~ /^[\w.-]+\z/ && $readable ne 'unknown' && $readable ne 'other';

    if ($prev eq '') {
        $row->{id_hash}        = $hash;
        $row->{id_status}      = 'ok';
        $row->{id_last_change} = int($now);
        $row->{id_interval}    = $interval;
        $row->{id_quiet}       = 0;
        $row->{id_next}        = $now + $interval;
        $rows{$host} = $row;
        save_learned(%rows);
        return;
    }
    if ($prev ne $hash) {
        my $gap = $now - (($row->{id_last_change} // 0) + 0);
        $gap = 0 if $gap < 0;
        $row->{id_changes}     = ($row->{id_changes} // 0) + 1;
        $row->{id_gap_total}   = ($row->{id_gap_total} // 0) + $gap;
        $row->{id_last_change} = int($now);
        $row->{id_hash}        = $hash;
        $row->{id_quiet}       = 0;
        $row->{id_status}      = 'ok';
        $row->{id_interval}    = next_id_interval($interval, 1);
        $row->{id_next}        = $now + $row->{id_interval};
        $row->{cap_force}      = 1;
        $row->{cap_next}       = 0;
        $rows{$host} = $row;
        save_learned(%rows);
        my $n = $row->{id_changes};
        my $avg = $n ? $row->{id_gap_total} / $n : 0;
        log_info(sprintf('%s: id updated (x%d avg %.2fs)', $host, $n, $avg));
        return;
    }
    $row->{id_quiet} = ($row->{id_quiet} // 0) + 1;
    if ($row->{id_quiet} >= 3) {
        $row->{id_interval} = next_id_interval($interval, 0);
        $row->{id_quiet} = 0;
    } else {
        $row->{id_interval} = $interval;
    }
    $row->{id_status} = 'ok';
    $row->{id_next}   = $now + $row->{id_interval};
    $rows{$host} = $row;
    save_learned(%rows);
}

sub consider_id {
    my ($imap, $server, $port, $now) = @_;
    $now //= time();
    return 0 unless $imap && defined $server && defined $port;
    my $row = learned_row($server, $port) // {};
    return 0 unless id_is_due($row, $now);
    my @resp = eval { $imap->tag_and_run(id_command()) };
    if ($@ || !@resp) {
        my %rows = load_learned();
        my $host = "$server:$port";
        my $kept = $rows{$host} // { notify => '', id => '' };
        my $interval = ($kept->{id_interval} // 0) + 0;
        $interval = $track_cfg->{initial} if $interval <= 0;
        $kept->{id_next} = $now + $interval;
        $rows{$host} = $kept;
        save_learned(%rows);
        return 0;
    }
    apply_id_result($server, $port, \@resp, $now);
    return 1;
}

sub consider_capability {
    my ($name, $imap, $server, $port, $folders, $now) = @_;
    $now //= time();
    return 0 unless $imap && defined $server && defined $port;
    return 0 unless cap_is_due($server, $port, $now);
    my @caps = eval { $imap->capability };
    return 0 if $@ || !@caps;
    _note_server_auth($server, $port, $imap, @caps);
    my $hash = capability_hash(@caps);
    my $has      = grep { uc($_) eq 'NOTIFY' } @caps;
    my $has_idle = grep { uc($_) eq 'IDLE' } @caps;
    my %rows = load_learned();
    my $host = "$server:$port";
    my $row  = $rows{$host} // { notify => '', id => '' };
    $row->{cap_hash}  = $hash;
    $row->{cap_force} = 0;
    $row->{cap_next}  = $now + ($track_cfg->{capability} // 604800);
    my $prev_notify = $row->{notify} // '';
    my $had_poll = $row->{cap_no_idle} ? 1 : 0;
    if ($has_idle || $has) {
        delete $row->{cap_no_idle};
    } else {
        $row->{cap_no_idle} = 1;
    }
    my $has_poll = $row->{cap_no_idle} ? 1 : 0;
    if ($has) {
        $row->{cap_has_notify} = 1;
        $rows{$host} = $row;
        save_learned(%rows);
        return 1;
    }
    delete $row->{cap_has_notify};
    $rows{$host} = $row;
    save_learned(%rows);
    remember_discovery($name, $server, $port, 'absent', $row->{id}, $folders);
    # An absent row already stored skips the discovery log. The first
    # capability list with neither extension still has to say so.
    if ($has_poll && !$had_poll && $prev_notify eq 'absent') {
        _log_discovery($name, 'absent', $row->{id}, $folders, 1);
    }
    return 0;
}

sub _hot_folder_map {
    my ($acc) = @_;
    my %hot;
    $hot{ $_->{name} } = 1 for @{ $acc->{folders} // [] };
    return \%hot;
}

sub consider_list {
    my ($name, $acc, $imap, $now) = @_;
    return unless $acc && $imap;
    my $channel = $acc->{mbsync_channel} // '';
    return if $channel eq '';
    $now //= time();
    my $due = $list_next{$channel};
    return if defined $due && $due > $now;
    my $hot = _hot_folder_map($acc);
    my $recs = eval { $imap->folders_hash };
    if ($@ || !$recs || ref $recs ne 'ARRAY') {
        apply_folder_list($channel, undef, $hot, 0, $now);
        return 0;
    }
    my @names = folder_names_from_list($recs);
    apply_folder_list($channel, \@names, $hot, 1, $now);
    return 1;
}

sub _id_probe_needed {
    my ($row) = @_;
    return 1 unless $row;
    return 0 if id_is_due($row) == 0;
    return 1;
}

sub _clear_learned_key {
    my ($server, $port, $key) = @_;
    my %rows = load_learned();
    my $host = "$server:$port";
    return unless $rows{$host};
    delete $rows{$host}{$key};
    save_learned(%rows);
}

sub _request_list_refresh {
    $list_next{$_} = 0 for keys %folder_lists;
    for my $name (keys %accounts) {
        my $ch = $accounts{$name}{mbsync_channel} // '';
        $list_next{$ch} = 0 if $ch ne '';
    }
}

sub probes_due {
    my ($acc, $now) = @_;
    return 0 unless $acc;
    $now //= time();
    my $row = learned_row($acc->{server}, $acc->{port}) // {};
    return 1 if id_is_due($row, $now);
    return 1 if cap_is_due($acc->{server}, $acc->{port}, $now);
    my $ch = $acc->{mbsync_channel} // '';
    if ($ch ne '') {
        my $due = $list_next{$ch};
        return 1 if !defined $due || $due <= $now;
    }
    return 0;
}

sub setup_notification {
    my ($name, $acc, $imap, $folder_list) = @_;
    my $server = $acc->{server};
    my $port   = $acc->{port};
    my $known  = learned_row($server, $port);
    my $retry_notify = $known && $known->{cap_has_notify};
    if ($known && (($known->{notify} // '') eq 'absent' || ($known->{notify} // '') eq 'rejected')
        && !$retry_notify) {
        return 0;
    }
    my $quiet = $known && ($known->{notify} // '') eq 'active';

    if (!$quiet) {
        my $need_cap = !$known || ($known->{cap_hash} // '') eq '' || $known->{cap_force};
        if ($need_cap) {
            my @caps = $imap->capability or return 0;
            my $has_notify = grep { uc($_) eq 'NOTIFY' } @caps;
            my $has_idle   = grep { uc($_) eq 'IDLE' } @caps;
            _store_idle_cap($server, $port, $has_idle, $has_notify);
            if (!$has_notify) {
                remember_discovery($name, $server, $port, 'absent', undef, $folder_list);
                return 0;
            }
        }
    }

    my $server_id;
    if ($quiet && ($known->{id} // '') ne '') {
        $server_id = $known->{id};
    } elsif (!$quiet && _id_probe_needed($known)) {
        $server_id = detect_server_version($imap);
    } else {
        $server_id = ($known && $known->{id}) ? $known->{id} : '';
    }
    _clear_learned_key($server, $port, 'cap_has_notify') if $retry_notify;
    my $cmd = 'NOTIFY SET (personal (MessageNew MessageExpunge MessageFlags))';
    log_info("$name: NOTIFY $cmd") unless $quiet;
    # tag_and_run returns a single undef on failure, which is not a response line.
    my @resp = grep { defined && $_ ne '' } $imap->tag_and_run($cmd);
    my $last = $resp[-1] // '';
    my $res  = @resp ? join(' | ', @resp) : ($imap->LastError // 'empty');
    if ($last =~ /OK/i) {
        log_info("$name: NOTIFY response [$res]") unless $quiet;
        remember_discovery($name, $server, $port, 'active', $server_id, $folder_list);
        return 1;
    }
    log_info("$name: NOTIFY $cmd") if $quiet;
    log_info("$name: NOTIFY response [$res]");
    remember_discovery($name, $server, $port, 'rejected', $server_id, $folder_list);
    return 0;
}

sub register_conn {
    my ($conn) = @_;
    $conn->{started} //= time();
    $conns{ $conn->{key} } = $conn;
    $sock_to_key{ $conn->{socket} } = $conn->{key};
    $select->add($conn->{socket});
}

# Mail::IMAPClient clucks a stack once it has marked the socket dead
# and another command is sent. Skip DONE, IDLE, and LOGOUT then.
sub imap_connected {
    my ($imap) = @_;
    return 0 unless $imap;
    my $up = eval { $imap->IsConnected };
    return $up ? 1 : 0;
}

sub imap_done {
    my ($imap, $tag) = @_;
    return () unless imap_connected($imap);
    my @lines;
    my $ok = eval { @lines = $imap->done($tag); 1 };
    return () unless $ok;
    return grep { defined && $_ ne '' } @lines;
}

# DONE is legal only while this process still has the server in IDLE.
# A second DONE is an unknown command and the server drops the session.
sub _conn_read_budget {
    my ($conn) = @_;
    my $acc = $accounts{ $conn->{name} // '' };
    my $cap = $IO_MAX;
    if ($acc && ($acc->{server} // '') ne '') {
        $cap = server_read_cap($acc->{server}, $acc->{port});
    }
    return $cap if defined $cap && $cap > 0;
    return 45;
}

# $code runs with a deadline that untagged mail cannot push back.
sub _with_read_deadline {
    my ($seconds, $code) = @_;
    my $prev = $READ_DEADLINE;
    $seconds = 45 if !defined $seconds || $seconds <= 0;
    my $end = Time::HiRes::time() + $seconds;
    $READ_DEADLINE = (!defined $prev || $end < $prev) ? $end : $prev;
    my $want = wantarray;
    my @ret;
    my $ok = eval {
        if ($want) { @ret = $code->() }
        else       { $ret[0] = scalar $code->() }
        1;
    };
    my $err = $@;
    $READ_DEADLINE = $prev;
    die $err if !$ok;
    return $want ? @ret : $ret[0];
}

sub _leave_idle {
    my ($conn) = @_;
    return (1) unless $conn && $conn->{idling};
    $conn->{idling} = 0;
    my $imap = $conn->{imap};
    return (0) unless imap_connected($imap);
    my @lines;
    my $budget = _conn_read_budget($conn);
    my $ok = eval {
        @lines = _with_read_deadline($budget, sub { $imap->done($conn->{tag}) });
        1;
    };
    @lines = grep { defined && $_ ne '' } @lines;
    return (0, @lines) if !$ok || !imap_connected($imap);
    return (0, @lines) if !@lines || grep { /\b(?:BAD|BYE)\b/i } @lines;
    return (1, @lines);
}

sub _note_idle {
    my ($conn, $tag) = @_;
    return 0 unless $conn && defined $tag && $tag ne '';
    $conn->{tag}       = $tag;
    $conn->{idling}    = 1;
    $conn->{last_idle} = time();
    return 1;
}

sub _probe_ready {
    my ($conn) = @_;
    return $conn && imap_connected($conn->{imap}) ? 1 : 0;
}

sub imap_logout {
    my ($imap) = @_;
    return unless imap_connected($imap);
    eval { $imap->logout };
}

sub close_session {
    my ($imap, $socket) = @_;
    imap_logout($imap);
    _forget_fd_server($socket);
    eval { $socket->close if $socket };
}

sub arm_idle {
    my ($name, $acc, $folder, $socket, $imap) = @_;
    unless (imap_connected($imap)) {
        close_session($imap, $socket);
        die "IDLE on $folder->{name}: not connected";
    }
    my $tag = $imap->idle();
    unless ($tag) {
        my $err = $imap->LastError // 'IDLE failed';
        close_session($imap, $socket);
        die "IDLE on $folder->{name}: $err";
    }
    register_conn({
        key          => "$name:$folder->{name}",
        name         => $name,
        folder       => $folder->{name},
        imap         => $imap,
        tag          => $tag,
        mode         => 'IDLE',
        idling       => 1,
        debounce     => $folder->{debounce},
        socket       => $socket,
        channel      => $acc->{mbsync_channel},
        wait         => $acc->{wait},
        last_success => time(),
        last_idle    => time(),
        messages     => selected_exists($imap),
        uidnext      => selected_uidnext($imap),
    });
    my $seen = selected_exists($imap);
    my $mem  = $name . "\0" . $folder->{name};
    my $prev = delete $LAST_EXISTS{$mem};
    if (defined $prev && defined $seen && $seen > $prev) {
        note_mail_event(
            $acc->{mbsync_channel},
            $folder->{name},
            $folder->{debounce},
            $acc->{wait} // 0,
        );
    }
    log_info("$name: IDLE $folder->{name} (priority $folder->{priority})");
}

# The SELECT reply's EXISTS is the baseline. A later unsolicited
# EXISTS is compared with it. Mail::IMAPClient keeps that line in Results.
sub selected_exists {
    my ($imap) = @_;
    return unless $imap && $imap->can('Results');
    my $n;
    my $ok = eval {
        for my $line ($imap->Results) {
            next unless defined $line;
            $n = $1 + 0 if $line =~ /^\*\s+(\d+)\s+EXISTS\b/i;
        }
        1;
    };
    return if !$ok;
    return $n;
}

# SELECT advertises the next UID in the response code. The after-sync
# STATUS compares against it. Undef until a line is seen.
sub selected_uidnext {
    my ($imap) = @_;
    return unless $imap && $imap->can('Results');
    my $n;
    my $ok = eval {
        for my $line ($imap->Results) {
            next unless defined $line;
            $n = $1 + 0 if $line =~ /\[UIDNEXT\s+(\d+)\]/i;
        }
        1;
    };
    return if !$ok;
    return $n;
}

sub adopt_notify {
    my ($name, $acc, $socket, $imap) = @_;
    register_conn({
        key          => "$name:NOTIFY",
        name         => $name,
        imap         => $imap,
        mode         => 'NOTIFY',
        socket       => $socket,
        channel      => $acc->{mbsync_channel},
        wait         => $acc->{wait},
        folders      => $acc->{folders},
        last_success => time(),
    });
    log_info("$name: NOTIFY mode, " . scalar(@{ $acc->{folders} }) . ' folder(s)');
}

sub _poll_interval {
    my ($acc) = @_;
    my $n = ($acc && defined $acc->{poll}) ? $acc->{poll} + 0 : 60;
    return $n < 60 ? 60 : $n;
}

# One connection, no IDLE. The first STATUS is a baseline. A later
# change of the count or UIDNEXT schedules mbsync.
sub adopt_poll {
    my ($name, $acc, $socket, $imap) = @_;
    my $every = _poll_interval($acc);
    register_conn({
        key          => "$name:POLL",
        name         => $name,
        imap         => $imap,
        mode         => 'POLL',
        socket       => $socket,
        channel      => $acc->{mbsync_channel},
        wait         => $acc->{wait},
        folders      => $acc->{folders},
        last_success => time(),
        poll_next    => 0,
        seen         => {},
    });
    log_info("$name: polling " . scalar(@{ $acc->{folders} }) . " folder(s) every ${every}s");
}

sub _poll_conn {
    my ($conn, $now) = @_;
    return unless $conn && ($conn->{mode} // '') eq 'POLL';
    return unless $conn->{key} && exists $conns{ $conn->{key} };
    $now //= time();
    my $name = $conn->{name} // '';
    my $acc = $accounts{$name};
    $conn->{poll_next} = $now + _poll_interval($acc);
    my $imap = $conn->{imap};
    unless ($imap && imap_connected($imap)) {
        drop_conn($conn->{key}, 'poll failed');
        return;
    }
    my $channel = ($acc && $acc->{mbsync_channel}) // $conn->{channel} // '';
    my $folders = $acc ? $acc->{folders} : $conn->{folders};
    $folders = [] unless ref $folders eq 'ARRAY';
    $conn->{seen} = {} unless ref $conn->{seen} eq 'HASH';
    my $ok = eval {
        for my $folder (@$folders) {
            my $box = $folder->{name} // '';
            next if $box eq '';
            my @resp = grep { defined && $_ ne '' } $imap->tag_and_run(
                'STATUS ' . imap_mailbox($box) . ' (MESSAGES UIDNEXT)'
            );
            my ($messages, $uidnext) = parse_status_counts(join("\n", @resp));
            die "STATUS $box\n" unless defined $messages;
            my $prev = $conn->{seen}{$box};
            $conn->{seen}{$box} = { messages => $messages, uidnext => $uidnext };
            next unless $prev;
            next if ($prev->{messages} // -1) == $messages
                && ($prev->{uidnext} // -1) == $uidnext;
            note_mail_event(
                $channel, $box,
                $folder->{debounce} // 0,
                ($acc && defined $acc->{wait}) ? $acc->{wait} : 0,
                $now,
            );
        }
        1;
    };
    return if $ok;
    log_warn("$name: poll failed: " . scrub($@));
    drop_conn($conn->{key}, 'poll failed') if exists $conns{ $conn->{key} };
}

sub next_poll_delay {
    my ($now) = @_;
    $now //= time();
    my $wait;
    for my $conn (values %conns) {
        next if ($conn->{mode} // '') ne 'POLL';
        my $d = ($conn->{poll_next} // 0) - $now;
        next if $d <= 0;
        $wait = $d if !defined $wait || $d < $wait;
    }
    return $wait;
}

sub set_imsg_sched { $IMSG_SCHED = $_[0] ? 1 : 0 }

sub set_imsg_conn_count { $IMSG_CONNS = ($_[0] // 0) + 0 }

# $folder empty marks the pulse speaker for this account.
sub imsg_folder_up {
    my ($name, $folder, $up) = @_;
    return unless defined $name && $name ne '';
    $folder = '' unless defined $folder;
    my $key = "$name\0$folder";
    if ($up) {
        $IMSG_UP{$key} = 1;
    } else {
        delete $IMSG_UP{$key};
    }
}

# Channels whose STATUS runs in a worker. due_tracked waits for that
# sample instead of starting mbsync for every row that is already due.
sub set_external_probe {
    my ($channel, $on) = @_;
    return unless defined $channel && $channel ne '';
    if ($on) {
        $EXTERNAL_PROBE{$channel} = 1;
    } else {
        delete $EXTERNAL_PROBE{$channel};
    }
}

sub account_covered {
    my ($name) = @_;
    return 1 if $conns{"$name:NOTIFY"};
    return 1 if $conns{"$name:POLL"};
    return 1 if $conns{"$name:PULSE"};
    my $acc = $accounts{$name} or return 0;
    my $role = $acc->{role} // '';
    return 1 if $role eq 'account';
    if ($role eq 'pulse') {
        return $IMSG_UP{"$name\0"} ? 1 : 0;
    }
    for my $f (@{ $acc->{folders} }) {
        my $box = $f->{name} // '';
        return 0 if $box eq '';
        return 0 unless $conns{"$name:$box"} || $IMSG_UP{"$name\0$box"};
    }
    return 1;
}

sub start_give_up    { 5 }
sub disable_floor    { 1800 }
sub disable_ceiling  { 12 * 3600 }

# Same half-again step as the connect backoff. A step past 12 hours
# is not taken, so the pause stays on the previous one.
sub next_disable_for {
    my ($cur) = @_;
    $cur = disable_floor() if !defined $cur || $cur < disable_floor();
    my $n = int($cur * 1.5 + 0.5);
    return $cur if $n > disable_ceiling();
    return $n;
}

# One week, with no extra spread. The operator schedules the next
# try with account.NAME.next_try once the login is fixed.
sub auth_week { 604800 }

# The server rejected the login. A timeout or a dropped socket is not
# this, and neither is a connection-limit refusal.
sub auth_failure_error {
    my ($err) = @_;
    return 0 unless defined $err && $err ne '';
    return 1 if $err =~ /authenticationfailed/i;
    return 1 if $err =~ /authentication failed/i;
    return 1 if $err =~ /authenticate failed/i;
    return 1 if $err =~ /invalid credentials/i;
    return 1 if $err =~ /\blogin failed\b/i;
    return 0;
}

# A timeout or a refused socket ends the authentication streak.
# The week-long backoff must not become the next ordinary retry.
sub _clear_auth_streak {
    my ($name) = @_;
    my $acc = $accounts{$name} or return;
    $acc->{auth_fails} = 0;
    $acc->{backoff} = 5 if ($acc->{backoff} // 0) > 900;
}

# The first two authentication failures use the connect backoff.
# The third in a row, and each one after it, waits one week.
# A different failure clears the streak.
sub note_auth_failure {
    my ($name) = @_;
    my $acc = $accounts{$name} or return;
    return if $acc->{disabled};
    $acc->{auth_fails} = ($acc->{auth_fails} // 0) + 1;
    if ($acc->{auth_fails} < 3) {
        mark_retry($name);
        return;
    }
    my $b = auth_week();
    $acc->{backoff}  = $b;
    $acc->{next_try} = time() + $b;
    log_error("$name: auth failed, retry in ${b}s at " . _clock($acc->{next_try}));
}

sub mark_retry {
    my ($name) = @_;
    my $acc = $accounts{$name} or return;
    return if $acc->{disabled};
    $acc->{fails} = ($acc->{fails} // 0) + 1;
    if (!$acc->{up} && $acc->{fails} >= start_give_up()) {
        my $nfail = $acc->{fails};
        my $b = $acc->{disable_for} // disable_floor();
        $b = disable_floor() if $b < disable_floor();
        $acc->{disabled}    = 1;
        $acc->{fails}       = 0;
        $acc->{backoff}     = 5;
        $acc->{next_try}    = time() + $b;
        $acc->{disable_for} = next_disable_for($b);
        log_error("$name: disabled after $nfail failures, back in ${b}s at "
            . _clock($acc->{next_try}));
        return;
    }
    my $b = $acc->{backoff} // 5;
    $b = 5 if $b < 5;
    $acc->{next_try} = time() + $b;
    my $n = int($b * 1.5 + 0.5);
    $n = 900 if $n > 900;
    $acc->{backoff} = $n;
    log_info("$name: retry in ${b}s");
}

# The pause ended. The connect backoff starts over at 5 seconds.
sub lift_account_disable {
    my ($name, $now) = @_;
    my $acc = $accounts{$name} or return 0;
    return 0 if $acc->{config_disabled} || !$acc->{disabled};
    $now //= time();
    my $due = $acc->{next_try} // 0;
    return 0 if $due <= 0 || $due > $now;
    $acc->{disabled} = 0;
    $acc->{fails}    = 0;
    $acc->{backoff}  = 5;
    $acc->{next_try} = 0;
    log_info("$name: backoff reset");
    return 1;
}

sub note_success {
    my ($name) = @_;
    my $acc = $accounts{$name} or return;
    $acc->{backoff}    = 5;
    $acc->{next_try}   = 0;
    $acc->{fails}      = 0;
    $acc->{auth_fails} = 0;
    $acc->{up}         = 1;
    $acc->{disabled}   = 0;
    delete $acc->{disable_for};
}

sub drop_socket {
    my ($sock) = @_;
    return unless $sock;
    _forget_fd_server($sock);
    eval { $select->remove($sock) };
    delete $sock_to_key{$sock};
}

sub drop_conn {
    my ($key, $why, $no_retry) = @_;
    return unless defined $key && exists $conns{$key};
    my $conn = delete $conns{$key};
    if (defined $conn->{folder} && $conn->{folder} ne '' && defined $conn->{messages}) {
        my $who = $conn->{name} // '';
        $LAST_EXISTS{$who . "\0" . $conn->{folder}} = $conn->{messages} + 0
            if $who ne '';
    }
    drop_socket($conn->{socket});
    my $name = $conn->{name} // '?';
    $why = scrub($why);
    my $what = $key;
    $what =~ s/^\Q$name\E:// if $name ne '?';
    my $secs = 0;
    $secs = time() - $conn->{started} if defined $conn->{started};
    my $avg = note_conn_time(_conn_time_key($conn), $secs);
    $avg = '' unless defined $avg;
    my $silence = _idle_silence_line($conn, $why);
    if (defined $silence) {
        log_warn("$name: $silence");
    } else {
        log_warn("$name: dropping $what: $why" . ($avg ne '' ? " $avg" : ''));
    }
    eval { _leave_idle($conn) };
    close_session($conn->{imap}, $conn->{socket});
    mark_retry($name) unless $no_retry;
}

# The read cap expired on an IDLE session. One line names the folder
# and the wait. A TCP close keeps the ordinary drop text.
sub _idle_silence_line {
    my ($conn, $why) = @_;
    return unless $conn && ($conn->{mode} // '') eq 'IDLE';
    my $folder = $conn->{folder} // '';
    return if $folder eq '';
    return unless defined $why
        && $why =~ /timeout waiting ([0-9]+(?:\.[0-9]+)?)s for data from server/;
    my $n = $1 + 0;
    my $shown = ($n == int($n)) ? sprintf('%d', int($n)) : sprintf('%.3f', $n);
    $shown =~ s/0+$//;
    $shown =~ s/\.$//;
    return "$folder idle refresh timeout, waited ${shown}s with no response";
}

# One week, plus the same quarter spread as an empty-mailbox confirm.
sub conn_limit_week { 604800 }

# The refusal text, including Perl's "at file line" suffix. A plain
# authentication NO is not this.
sub conn_limit_error {
    my ($err) = @_;
    return 0 unless defined $err && $err ne '';
    return 1 if $err =~ /maximum number of connections/i;
    return 1 if $err =~ /mail_max_userip_connections/i;
    return 1 if $err =~ /too many simultaneous connections/i;
    return 1 if $err =~ /too many connections/i;
    return 0;
}

sub conn_limit_stop {
    my ($err) = @_;
    return 0 unless defined $err && $err ne '';
    return 1 if $err =~ /^connection limit\b/;
    return conn_limit_error($err);
}

sub _conn_limit_server_max {
    my ($err) = @_;
    return unless defined $err;
    return $1 + 0 if $err =~ /mail_max_userip_connections\s*=\s*(\d+)/i;
    return;
}

sub _conn_limit_key {
    my ($acc) = @_;
    return unless ref $acc eq 'HASH';
    my $server = $acc->{server};
    my $user   = $acc->{user};
    return if !defined $server || $server eq '';
    return if !defined $user || $user eq '';
    return if !defined $acc->{port};
    return join("\0", $server, $acc->{port} + 0, $user);
}

# Sessions already in the table. Holds are separate so a login that
# has not landed yet still reserves its slot.
sub _conn_limit_sessions {
    my ($key) = @_;
    return 0 unless defined $key;
    my $n = 0;
    for my $conn (values %conns) {
        my $acc = $accounts{ $conn->{name} // '' } or next;
        my $k = _conn_limit_key($acc) or next;
        $n++ if $k eq $key;
    }
    return $n;
}

sub _conn_limit_open {
    my ($key) = @_;
    return _conn_limit_sessions($key) + ($CONN_LIMIT_HOLD{$key} // 0);
}

# True when another login would pass the learned cap and this week’s
# extra attempt is not due. Does not mark that attempt.
sub conn_limit_blocked {
    my ($acc, $now) = @_;
    my $key = _conn_limit_key($acc) or return 0;
    return 1 if $CONN_LIMIT_PROBING{$key};
    my $row = $CONN_LIMIT{$key} or return 0;
    return 0 unless defined $row->{cap};
    return 0 if _conn_limit_open($key) < $row->{cap};
    $now //= time();
    my $probe = $row->{probe} // 0;
    return 0 if $probe <= $now;
    return 1;
}

# Seconds until a blocked account may try again. A probe already in
# flight does not pull the sleep down to zero.
sub _conn_limit_wait {
    my ($acc, $now) = @_;
    $now //= time();
    my $key = _conn_limit_key($acc) or return 30;
    my $row = $CONN_LIMIT{$key};
    my $probe = $row ? ($row->{probe} // 0) : 0;
    my $left = $probe - $now;
    return 30 if $CONN_LIMIT_PROBING{$key} && $left <= 0;
    return $left > 0 ? $left : 0;
}

sub conn_limit_begin {
    my ($name, $acc) = @_;
    my $key = _conn_limit_key($acc) or return;
    my $open = _conn_limit_open($key);
    my $row = $CONN_LIMIT{$key};
    my $extra = 0;
    if ($row && defined $row->{cap} && $open >= $row->{cap}) {
        $CONN_LIMIT_PROBING{$key} = 1;
        $extra = 1;
    }
    $CONN_LIMIT_HOLD{$key} = ($CONN_LIMIT_HOLD{$key} // 0) + 1;
    return { key => $key, extra => $extra, name => $name };
}

sub _conn_limit_release {
    my ($hold) = @_;
    return unless $hold && defined $hold->{key};
    my $key = $hold->{key};
    my $n = $CONN_LIMIT_HOLD{$key} // 0;
    if ($n <= 1) {
        delete $CONN_LIMIT_HOLD{$key};
    } else {
        $CONN_LIMIT_HOLD{$key} = $n - 1;
    }
}

sub _conn_limit_schedule {
    my ($row, $now) = @_;
    $now //= time();
    $row->{probe} = $now + with_quarter_spread(conn_limit_week());
}

sub _conn_limit_log {
    my ($name, $row) = @_;
    my $cap = $row->{cap} // 0;
    my $left = int(($row->{probe} // 0) - time());
    $left = 0 if $left < 0;
    my $msg = "$name: connection limit $cap";
    $msg .= ", server $row->{server_max}" if defined $row->{server_max};
    $msg .= ", probe in ${left}s";
    log_warn($msg);
}

sub _conn_limit_note_refusal {
    my ($key, $err, $name) = @_;
    my $row = $CONN_LIMIT{$key};
    my $max = _conn_limit_server_max($err);
    if (!$row || !defined $row->{cap}) {
        $row = { cap => _conn_limit_sessions($key) };
    }
    $row->{server_max} = $max if defined $max;
    _conn_limit_schedule($row);
    $CONN_LIMIT{$key} = $row;
    delete $CONN_LIMIT_PROBING{$key};
    _conn_limit_save();
    _conn_limit_log($name, $row);
}

# The new session is already in %conns. An extra success raises the
# cap to that count and waits another week.
sub conn_limit_success {
    my ($hold) = @_;
    return unless $hold;
    my $extra = $hold->{extra};
    my $key = $hold->{key};
    _conn_limit_release($hold);
    return unless $extra;
    my $row = $CONN_LIMIT{$key} or return;
    return unless defined $row->{cap};
    my $n = _conn_limit_sessions($key);
    $row->{cap} = $n if $n > $row->{cap};
    _conn_limit_schedule($row);
    delete $CONN_LIMIT_PROBING{$key};
    _conn_limit_save();
}

# 1 when this failure is the server cap. The caller must not retry it.
# Any other failure of an extra attempt leaves the week unspent.
sub conn_limit_fail {
    my ($hold, $err) = @_;
    return 0 unless $hold;
    my $extra = $hold->{extra};
    my $key = $hold->{key};
    my $name = $hold->{name};
    _conn_limit_release($hold);
    if (conn_limit_error($err)) {
        _conn_limit_note_refusal($key, $err, $name);
        return 1;
    }
    delete $CONN_LIMIT_PROBING{$key} if $extra;
    return 0;
}

# The hub has no %conns. $open is how many workers for this login are
# already in IMAP. A refusal records that count and waits out the week.
sub note_imsg_conn_limit {
    my ($name, $err, $open) = @_;
    my $acc = $accounts{$name} or return 0;
    my $key = _conn_limit_key($acc) or return 0;
    $open = 0 if !defined $open || $open < 0;
    return 0 if $open < 1;
    my $row = $CONN_LIMIT{$key} //= {};
    my $max = _conn_limit_server_max($err);
    my $cap = int($open);
    # mbsync logs in as this same user and needs one of the server's slots.
    if (defined $max && $max > 1 && $cap > $max - 1) {
        $cap = $max - 1;
    }
    if (!defined $row->{cap} || $row->{cap} > $cap) {
        $row->{cap} = $cap;
    }
    $row->{server_max} = $max if defined $max;
    _conn_limit_schedule($row);
    $CONN_LIMIT{$key} = $row;
    delete $CONN_LIMIT_PROBING{$key};
    _conn_limit_save();
    _conn_limit_log($name, $row);
    return $row->{probe} // 0;
}

sub imsg_conn_limit_blocked {
    my ($name, $open, $now) = @_;
    my $acc = $accounts{$name} or return 0;
    my $key = _conn_limit_key($acc) or return 0;
    my $row = $CONN_LIMIT{$key} or return 0;
    return 0 unless defined $row->{cap};
    $open = 0 if !defined $open || $open < 0;
    return 0 if $open < $row->{cap};
    $now //= time();
    return 0 if ($row->{probe} // 0) <= $now;
    return 1;
}

sub imsg_conn_limit_until {
    my ($name) = @_;
    my $acc = $accounts{$name} or return 0;
    my $key = _conn_limit_key($acc) or return 0;
    my $row = $CONN_LIMIT{$key} or return 0;
    return $row->{probe} // 0;
}

sub imsg_conn_limit_cap {
    my ($name) = @_;
    my $acc = $accounts{$name} or return 0;
    my $key = _conn_limit_key($acc) or return 0;
    my $row = $CONN_LIMIT{$key} or return 0;
    return $row->{cap} // 0;
}

# The startup sync lost the race with IDLE. Try the same folders once
# the extra worker has been dropped.
sub requeue_after_conn_limit {
    my ($rec) = @_;
    return unless ref $rec eq 'HASH' && ref $rec->{args} eq 'ARRAY';
    my $now = time();
    my $n = 0;
    for my $arg (@{ $rec->{args} }) {
        next unless defined $arg && $arg =~ /^([^:]+):(.+)$/;
        queue_folder($1, $2, $now, $now + 10);
        $n++;
    }
    log_warn('mbsync hit the connection limit, retry in 10s') if $n;
    return;
}

sub _conn_limit_save {
    return if $DRY_RUN;
    return unless defined $CONN_LIMIT_FILE && $CONN_LIMIT_FILE ne '';
    my $dir = dirname($CONN_LIMIT_FILE);
    make_path($dir, { mode => 0700 }) if $dir ne '' && $dir ne '.';
    my $old = umask 077;
    open my $fh, '>', $CONN_LIMIT_FILE or do {
        umask $old;
        log_error("Cannot write $CONN_LIMIT_FILE: $!");
        return;
    };
    print $fh "# server\tport\tuser\tcap\tprobe\tserver_max\n";
    for my $key (sort keys %CONN_LIMIT) {
        my ($server, $port, $user) = split /\0/, $key, 3;
        next unless defined $server && $server ne '' && index($server, "\t") < 0;
        next unless defined $user && $user ne '' && index($user, "\t") < 0;
        my $row = $CONN_LIMIT{$key} or next;
        next unless defined $row->{cap} && $row->{cap} =~ /^\d+$/;
        my $probe = $row->{probe} // 0;
        next unless $probe =~ /^\d+(?:\.\d+)?\z/;
        my $max = '';
        $max = $row->{server_max} if defined $row->{server_max} && $row->{server_max} =~ /^\d+$/;
        print $fh join("\t", $server, $port + 0, $user, $row->{cap} + 0,
            _stat_num($probe), $max), "\n";
    }
    close $fh;
    umask $old;
    _state_mark($CONN_LIMIT_FILE);
}

sub _conn_limit_load {
    _state_mark($CONN_LIMIT_FILE);
    return unless defined $CONN_LIMIT_FILE && -f $CONN_LIMIT_FILE;
    open my $fh, '<', $CONN_LIMIT_FILE or return;
    while (<$fh>) {
        chomp;
        next if /^\s*#/ || /^\s*$/;
        my @f = split /\t/, $_, -1;
        next unless @f == 6;
        my ($server, $port, $user, $cap, $probe, $max) = @f;
        next if !defined $server || $server eq '' || index($server, "\t") >= 0;
        next if !defined $user || $user eq '' || index($user, "\t") >= 0;
        next unless defined $port && $port =~ /^\d+$/;
        next unless defined $cap && $cap =~ /^\d+$/;
        next unless defined $probe && $probe =~ /^\d+(?:\.\d+)?\z/;
        my $key = join("\0", $server, $port + 0, $user);
        my $row = { cap => $cap + 0, probe => $probe + 0 };
        $row->{server_max} = $max + 0 if defined $max && $max =~ /^\d+$/;
        $CONN_LIMIT{$key} = $row;
    }
    close $fh;
    _state_mark($CONN_LIMIT_FILE);
}

sub _conn_limit_info_lines {
    my ($now) = @_;
    $now //= time();
    my @lines;
    for my $key (sort keys %CONN_LIMIT) {
        my ($server, $port, $user) = split /\0/, $key, 3;
        next unless defined $user && $user ne '';
        my $row = $CONN_LIMIT{$key} or next;
        my $left = int(($row->{probe} // 0) - $now);
        $left = 0 if $left < 0;
        my $line = "limit: $server:$port $user cap "
            . ($row->{cap} // 0) . " probe ${left}s";
        $line .= " server $row->{server_max}" if defined $row->{server_max};
        push @lines, $line;
    }
    return @lines;
}

sub connect_idle_folders {
    my ($name, $folders, $password) = @_;
    my $acc = $accounts{$name} or return 0;
    my $failed = 0;
    for my $folder (@$folders) {
        _abandon_startup();
        if (conn_limit_blocked($acc)) {
            return $failed ? 0 : -1;
        }
        my $hold = conn_limit_begin($name, $acc);
        my $ok = eval {
            my ($socket, $imap) = create_imap_connection($name, $acc, $folder->{name}, $password);
            if (_shutdown_wanted()) {
                close_session($imap, $socket);
                _abandon_startup();
            }
            arm_idle($name, $acc, $folder, $socket, $imap);
            1;
        };
        my $err = $@;
        _abandon_startup();
        if ($ok) {
            conn_limit_success($hold);
            next;
        }
        if (conn_limit_fail($hold, $err)) {
            return $failed ? 0 : -1;
        }
        if (auth_failure_error($err)) {
            log_error("$name: $folder->{name}: " . scrub($err, $password));
            note_auth_failure($name);
            return -2;
        }
        $failed = 1;
        log_error("$name: $folder->{name}: " . scrub($err, $password));
    }
    return $failed ? 0 : 1;
}

sub _account_primary {
    my ($name) = @_;
    for my $key (keys %conns) {
        next unless index($key, "$name:") == 0;
        return 1 if $conns{$key}{primary};
    }
    return 0;
}

sub _session_held {
    my ($socket) = @_;
    return 0 unless $socket;
    for my $key (keys %conns) {
        return 1 if $conns{$key}{socket} && $conns{$key}{socket} == $socket;
    }
    return 0;
}

sub adopt_pulse {
    my ($name, $acc, $socket, $imap) = @_;
    register_conn({
        key          => "$name:PULSE",
        name         => $name,
        imap         => $imap,
        mode         => 'PULSE',
        socket       => $socket,
        channel      => $acc->{mbsync_channel},
        wait         => $acc->{wait},
        folders      => [],
        last_success => time(),
        primary      => 1,
    });
    log_info("$name: pulse " . ($acc->{mbsync_channel} // ''));
}

sub _connect_pulse {
    my ($name) = @_;
    my $acc = $accounts{$name} or return 0;
    my $password = account_pass($name);
    if (!defined $password) {
        my $cmd = $acc->{pass_cmd};
        mark_retry($name) unless defined $cmd && $cmd ne '';
        return 0;
    }
    return 1 if conn_limit_blocked($acc);
    my $hold = conn_limit_begin($name, $acc);
    my $ok = eval {
        my ($socket, $imap) = login_imap($name, $acc, $password);
        if (_shutdown_wanted()) {
            close_session($imap, $socket);
            _abandon_startup();
        }
        my $now = time();
        consider_id($imap, $acc->{server}, $acc->{port}, $now);
        consider_capability($name, $imap, $acc->{server}, $acc->{port}, [], $now);
        consider_list($name, $acc, $imap, $now);
        adopt_pulse($name, $acc, $socket, $imap);
        1;
    };
    my $err = $@;
    _abandon_startup();
    if (!$ok) {
        return 1 if $hold && conn_limit_fail($hold, $err);
        return _settle_account($name, 0, $err, $password);
    }
    conn_limit_success($hold);
    return _settle_account($name, 1, '', $password);
}

sub _limit_idle_result {
    my ($name, $rc) = @_;
    return 0 if $rc < -1;
    if ($rc < 0) {
        note_success($name) if account_covered($name);
        return 1;
    }
    if ($rc && account_covered($name)) {
        note_success($name);
        return 1;
    }
    mark_retry($name);
    return $rc ? 1 : 0;
}

sub connect_account {
    my ($name) = @_;
    _abandon_startup();
    my $acc = $accounts{$name} or return 0;
    return 0 if $acc->{disabled};
    return 1 if ($acc->{role} // '') eq 'account';
    if (($acc->{role} // '') eq 'pulse') {
        return 1 if $conns{"$name:PULSE"};
        return 1 if conn_limit_blocked($acc);
        return _connect_pulse($name);
    }
    return 1 if account_covered($name);

    my @need = grep { !$conns{"$name:$_->{name}"} } @{ $acc->{folders} };
    return 1 unless @need;
    return 1 if conn_limit_blocked($acc);

    my $password = account_pass($name);
    if (!defined $password) {
        # account_pass already scheduled a pass_cmd failure. mark_retry
        # would log a retry and, before the first monitor, disable it.
        my $cmd = $acc->{pass_cmd};
        mark_retry($name) unless defined $cmd && $cmd ne '';
        return 0;
    }

    my $partial = grep { index($_, "$name:") == 0 } keys %conns;
    if ($partial && _account_primary($name)) {
        my $rc = connect_idle_folders($name, \@need, $password);
        _abandon_startup();
        return _limit_idle_result($name, $rc);
    }

    my $hold = conn_limit_begin($name, $acc);
    my $auth_stop = 0;
    my $ok = eval {
        my ($socket, $imap) = login_imap($name, $acc, $password);
        if (_shutdown_wanted()) {
            close_session($imap, $socket);
            _abandon_startup();
        }
        my $now = time();
        my $held = eval {
            consider_id($imap, $acc->{server}, $acc->{port}, $now);
            consider_capability($name, $imap, $acc->{server}, $acc->{port}, $acc->{folders}, $now);
            consider_list($name, $acc, $imap, $now);
            my $notify = setup_notification($name, $acc, $imap, $acc->{folders});
            if ($notify) {
                adopt_notify($name, $acc, $socket, $imap);
                $conns{"$name:NOTIFY"}{primary} = 1 if $conns{"$name:NOTIFY"};
            } elsif (server_needs_poll($acc->{server}, $acc->{port})) {
                adopt_poll($name, $acc, $socket, $imap);
                $conns{"$name:POLL"}{primary} = 1 if $conns{"$name:POLL"};
            } else {
                my $folder = $need[0];
                $imap->select($folder->{name})
                    or die 'SELECT ' . $folder->{name} . ': ' . ($imap->LastError // '');
                arm_idle($name, $acc, $folder, $socket, $imap);
                my $key = "$name:$folder->{name}";
                $conns{$key}{primary} = 1 if $conns{$key};
                conn_limit_success($hold);
                $hold = undef;
                my @rest = @need[1 .. $#need];
                if (@rest) {
                    my $rc = connect_idle_folders($name, \@rest, $password);
                    if ($rc < -1) {
                        $auth_stop = 1;
                        return 0;
                    }
                    die "connection limit\n" if $rc < 0;
                    die 'IDLE failed' if !$rc;
                }
            }
            1;
        };
        return 0 if $auth_stop;
        if (!$held) {
            my $err = $@;
            if ($err =~ /^connection limit\b/) {
                die $err;
            }
            close_session($imap, $socket) unless _session_held($socket);
            die $err || 'connect failed';
        }
        if ($hold) {
            conn_limit_success($hold);
            $hold = undef;
        }
        1;
    };
    my $err = $@;
    _abandon_startup();
    return 0 if $auth_stop;
    if ($hold && conn_limit_fail($hold, $err)) {
        return 1;
    }
    if ($err && $err =~ /^connection limit\b/) {
        note_success($name) if account_covered($name);
        return 1;
    }
    return _settle_account($name, $ok, $err, $password);
}

sub _settle_account {
    my ($name, $ok, $err, $password) = @_;
    if (!$ok) {
        if (conn_limit_stop($err)) {
            note_success($name) if account_covered($name);
            return 1;
        }
        log_error("$name: connect failed: " . scrub($err, $password));
        if (auth_failure_error($err)) {
            note_auth_failure($name);
        } else {
            _clear_auth_streak($name);
            mark_retry($name);
        }
        return 0;
    }
    if (account_covered($name)) {
        note_success($name);
        my $channel = $accounts{$name}{mbsync_channel} // '';
        log_info("$name: monitoring $channel");
        return 1;
    }
    mark_retry($name);
    return 0;
}

sub restart_idle {
    my ($conn) = @_;
    return 1 unless $conn;
    my $mode = $conn->{mode} // '';
    return 1 if $mode eq 'NOTIFY' || $mode eq 'POLL' || $mode eq 'PULSE';
    return 0 unless $conn->{imap};
    my $ok = eval {
        if ($conn->{idling}) {
            my $was = imap_connected($conn->{imap});
            my ($left) = _leave_idle($conn);
            unless ($left) {
                my $why = $was
                    ? ($conn->{imap}->LastError || 'DONE failed')
                    : 'not connected';
                die $why;
            }
        }
        die 'not connected' unless imap_connected($conn->{imap});
        my $tag = $conn->{imap}->idle() or die($conn->{imap}->LastError // 'IDLE failed');
        _note_idle($conn, $tag);
        1;
    };
    if (!$ok) {
        my $why = scrub($@);
        if ($why =~ /timeout waiting [0-9]+(?:\.[0-9]+)?s for data from server/) {
            $conn->{drop_why} = $why;
        } else {
            log_warn("$conn->{name}: idle re-arm failed: $why");
        }
        return 0;
    }
    note_idle_rearmed($conn->{name});
    return 1;
}

# * OK Still here and the IDLE re-arm notice are the 30s keepalive.
# -v logs them. Other server lines stay.
sub _keepalive_line {
    my ($line) = @_;
    return 0 unless defined $line;
    return $line =~ /^\*\s+OK\s+Still here\b/i;
}

# $folder names the selected mailbox. $prev is the remembered EXISTS.
# The signed delta is that local total against the number in this line.
sub trace_imap_line {
    my ($name, $line, $folder, $prev) = @_;
    return if !$VERBOSE && _keepalive_line($line);
    my $body = $line;
    if (defined $folder && $folder ne '') {
        $body = "$folder $line";
        if ($line =~ /^\*\s+(\d+)\s+EXISTS\b/i) {
            if (defined $prev) {
                $body .= sprintf(' (%+d from last check)', $1 - $prev);
            } else {
                $body .= ' (no local count)';
            }
        }
    }
    log_info("$name: $body");
}

sub note_idle_rearmed {
    my ($name) = @_;
    log_info("$name: IDLE re-armed") if $VERBOSE;
}

# OpenBSD SYS_wait4. Same rusage time -l prints, collected here so the
# exit log is one line instead of time's stderr block.
my $SYS_wait4 = 11;

sub _time_secs {
    my ($sec, $usec) = @_;
    $sec  //= 0;
    $usec //= 0;
    my $n = $sec + ($usec / 1_000_000);
    return $n < 0 ? 0 : $n;
}

sub _rusage_numbers {
    my ($ru) = @_;
    $ru = "\0" x 144 unless defined $ru && length($ru) >= 144;
    my ($u_sec, $u_usec, $s_sec, $s_usec, $maxrss, undef, undef, undef,
        $minflt, $majflt, undef, $inblock, $oublock, undef, undef,
        undef, $nvcsw, $nivcsw) = unpack('q18', $ru);
    my $rss = $maxrss // 0;
    $rss = 0 if $rss < 0;
    return {
        user    => _time_secs($u_sec, $u_usec),
        sys     => _time_secs($s_sec, $s_usec),
        rss     => $rss,
        minflt  => _ru_count($minflt),
        majflt  => _ru_count($majflt),
        inblock => _ru_count($inblock),
        oublock => _ru_count($oublock),
        nvcsw   => _ru_count($nvcsw),
        nivcsw  => _ru_count($nivcsw),
    };
}

sub _ru_count {
    my ($n) = @_;
    $n //= 0;
    $n = 0 if $n < 0;
    return int($n);
}

sub format_time_stats {
    my ($real, $ru) = @_;
    $real //= 0;
    $real = 0 if $real < 0;
    my $n = _rusage_numbers($ru);
    return sprintf(
        '%.2f real %.2f user %.2f sys rss %dk minflt %d majflt %d inblock %d oublock %d nvcsw %d nivcsw %d',
        $real,
        $n->{user},
        $n->{sys},
        $n->{rss},
        $n->{minflt},
        $n->{majflt},
        $n->{inblock},
        $n->{oublock},
        $n->{nvcsw},
        $n->{nivcsw},
    );
}

sub exit_how {
    my ($status) = @_;
    $status //= 0;
    if ($status == 0) {
        return 'ret 0';
    } elsif ($status & 127) {
        return 'sig ' . ($status & 127);
    }
    return 'ret ' . ($status >> 8);
}

sub _pair_secs {
    my ($cur, $avg, $unit) = @_;
    return sprintf('%.2f|%.2f%s', $cur, $avg, $unit);
}

sub _pair_int {
    my ($cur, $avg, $unit) = @_;
    return sprintf('%d|%d%s', int($cur), int($avg + 0.5), $unit);
}

# Number before the bar is this run. Number after it is the average.
# The unit sits on the average. -v adds the fields that are always totaled.
sub _format_run_tail {
    my ($row, $cur) = @_;
    my $n   = $row->{n} || 0;
    my $avg = $n ? $row->{total} / $n : 0;
    my $s   = sprintf('x%d %s', $n, _pair_secs($cur->{real}, $avg, 's'));
    return $s unless ($row->{nr} // 0) > 0 && $cur->{have_ru};
    my $nr   = $row->{nr};
    my $user = _pair_secs($cur->{user}, $row->{user} / $nr, 'user');
    my $sys  = _pair_secs($cur->{sys},  $row->{sys} / $nr,  'sys');
    my $rss  = _pair_int($cur->{rss}, $row->{rss} / $nr, 'rss');
    if ($VERBOSE) {
        $s .= " $user $sys $rss";
        for my $f (@RU_FIELDS) {
            next if $f eq 'user' || $f eq 'sys' || $f eq 'rss';
            $s .= ' ' . _pair_int($cur->{$f}, ($row->{$f} // 0) / $nr, $f);
        }
    } else {
        $s .= " $rss";
    }
    return $s;
}

my $LAST_CHILD_EXIT = '';

# Real seconds for one mbsync argv. The stored key is sha1 -b of that
# command. n counts every run. nr counts runs that recorded rusage.
sub mbsync_cli {
    my ($rec) = @_;
    return unless ref $rec eq 'HASH' && ref $rec->{args} eq 'ARRAY' && @{ $rec->{args} };
    return join("\0", @{ $rec->{args} });
}

sub note_mbsync_real {
    my ($cli, $real, $ru) = @_;
    $cli = _memory_key($cli);
    return unless defined $cli;
    $real = 0 if !defined $real || $real < 0;
    my $row = $MBSYNC_REAL{$cli} //= { n => 0, total => 0 };
    $row->{n}++;
    $row->{total} += $real;
    my $cur = { real => $real, have_ru => 0 };
    if (defined $ru) {
        my $got = ref $ru eq 'HASH' ? $ru : _rusage_numbers($ru);
        $row->{nr} //= 0;
        for my $f (@RU_FIELDS) {
            my $v = $got->{$f} // 0;
            $v = 0 if $v < 0;
            $row->{$f} //= 0;
            $row->{$f} += $v;
            $cur->{$f} = $v;
        }
        $row->{nr}++;
        $cur->{have_ru} = 1;
    }
    _stat_save($MBSYNC_REAL_FILE, \%MBSYNC_REAL)
        if defined $MBSYNC_REAL_FILE && $MBSYNC_REAL_FILE ne '';
    return _format_run_tail($row, $cur);
}

sub reset_mbsync_real_for_test { %MBSYNC_REAL = (); }

# Trim a hook command. Blank means the section sets none.
sub _hook_value {
    my ($s) = @_;
    return '' unless defined $s;
    $s =~ s/^\s+|\s+$//g;
    return $s;
}

sub _hook_channel {
    my ($rec) = @_;
    my $args = ref $rec eq 'HASH' ? $rec->{args} : undef;
    return '' unless ref $args eq 'ARRAY' && @$args;
    my ($ch) = split /:/, ($args->[0] // ''), 2;
    return '' unless defined $ch && $ch ne '';
    return $ch;
}

sub _hook_label {
    my ($rec) = @_;
    my $ch = _hook_channel($rec);
    return $ch ne '' ? $ch : 'hook';
}

# Account hook for this channel, else the pulse hook when the job is a
# pulse run, plus the global hook when that text is different.
# One exit starts each command once.
sub _hook_commands {
    my ($rec) = @_;
    return () unless ref $rec eq 'HASH';
    my $ch = _hook_channel($rec);
    my @cmds;
    my $account_hook = 0;
    if ($ch ne '') {
        for my $name (sort keys %accounts) {
            my $acc = $accounts{$name} or next;
            next if $acc->{disabled};
            next if ($acc->{mbsync_channel} // '') ne $ch;
            my $hook = _hook_value($acc->{hook});
            if ($hook ne '') {
                push @cmds, $hook;
                $account_hook = 1;
            }
        }
    }
    if ($rec->{pulse} && !$account_hook && $ch ne '') {
        for my $name (sort keys %accounts) {
            my $acc = $accounts{$name} or next;
            next if $acc->{disabled};
            next if ($acc->{mbsync_channel} // '') ne $ch;
            my $hook = _hook_value($acc->{pulse_hook});
            if ($hook ne '') {
                push @cmds, $hook;
                last;
            }
        }
    }
    my $global = _hook_value($track_cfg->{hook});
    push @cmds, $global if $global ne '';
    my (%seen, @out);
    for my $cmd (@cmds) {
        next if $seen{$cmd}++;
        push @out, $cmd;
    }
    return @out;
}

# A burst of mailboxes would otherwise start one indexer per exit.
# The command already running is remembered and started once more.
sub _start_hook {
    my ($cmd, $label) = @_;
    $cmd = _hook_value($cmd);
    return 0 if $cmd eq '';
    $label = 'hook' if !defined $label || $label eq '';
    if (my $running = $hook_by_cmd{$cmd}) {
        $hook_again{$cmd} = $label;
        return $running;
    }
    my $pid = fork();
    if (!defined $pid) {
        log_error("$label: hook fork failed: $!");
        return 0;
    }
    if ($pid == 0) {
        $SIG{PIPE} = 'IGNORE';
        $SIG{HUP}  = 'DEFAULT';
        $SIG{INFO} = 'DEFAULT';
        $SIG{CHLD} = 'DEFAULT';
        $SIG{TERM} = 'DEFAULT';
        $SIG{INT}  = 'DEFAULT';
        _restore_wake_mask();
        close_extra_fds();
        open STDIN,  '<', '/dev/null' or _exit(127);
        open STDOUT, '>', '/dev/null' or _exit(127);
        open STDERR, '>', '/dev/null' or _exit(127);
        exec '/bin/sh', '-c', $cmd or _exit(1);
    }
    $hook_children{$pid} = { cmd => $cmd, label => $label };
    $hook_by_cmd{$cmd} = $pid;
    log_info("$label: hook");
    return $pid;
}

sub _finish_hook {
    my ($pid, $rec, $status) = @_;
    my $cmd   = (ref $rec eq 'HASH' ? $rec->{cmd} : '') // '';
    my $label = (ref $rec eq 'HASH' && ($rec->{label} // '') ne '') ? $rec->{label} : 'hook';
    delete $hook_by_cmd{$cmd} if $cmd ne '' && ($hook_by_cmd{$cmd} // 0) == $pid;
    my $how = exit_how($status);
    if (($status // 0) == 0) {
        log_info("$label: hook $how");
    } else {
        log_warn("$label: hook $how");
    }
    my $again = delete $hook_again{$cmd};
    _start_hook($cmd, $again) if defined $again && $again ne '';
}

# Exit 0 only. A hook is not an mbsync child and does not hold a slot.
sub maybe_arm_sync_hooks {
    my ($rec, $status) = @_;
    return unless ref $rec eq 'HASH';
    return unless defined $status && $status == 0;
    my $label = _hook_label($rec);
    _start_hook($_, $label) for _hook_commands($rec);
}

# Password of the account that owns the child's channel, so a failed
# mbsync line does not repeat it.
sub _secret_for_channel {
    my ($channel) = @_;
    return unless defined $channel && $channel ne '';
    my $held;
    for my $acc (values %accounts) {
        next unless ref $acc eq 'HASH';
        next unless ($acc->{mbsync_channel} // '') eq $channel;
        next unless defined $acc->{pass} && $acc->{pass} ne '';
        return $acc->{pass} unless $acc->{config_disabled};
        $held = $acc->{pass} unless defined $held;
    }
    return $held;
}

sub _child_err_text {
    my ($rec) = @_;
    return '' unless ref $rec eq 'HASH' && $rec->{err_fh};
    my $fh = delete $rec->{err_fh};
    local $/;
    my $text = <$fh> // '';
    close $fh;
    return $text;
}

# First non-empty stderr line. Whitespace is one space. The account
# password is replaced. Longer than 160 characters is cut.
sub _err_line_from {
    my ($text, $rec) = @_;
    my $line = '';
    for my $row (split /\r?\n/, $text // '') {
        $row =~ s/^\s+|\s+$//g;
        next if $row eq '';
        $line = $row;
        last;
    }
    $line =~ s/\s+/ /g;
    my $channel = '';
    if (ref $rec eq 'HASH' && ref $rec->{args} eq 'ARRAY' && @{ $rec->{args} }) {
        ($channel) = split /:/, $rec->{args}[0], 2;
    }
    $line = scrub($line, _secret_for_channel($channel));
    $line = substr($line, 0, 160) if length($line) > 160;
    return $line;
}

sub _child_err_line {
    my ($rec) = @_;
    return _err_line_from(_child_err_text($rec), $rec);
}

# A broken .mbsyncstate, or a UIDVALIDITY change mbsync will not
# repair. Other mbsync errors are not this.
sub sync_state_issue {
    my ($text) = @_;
    return 0 unless defined $text && $text ne '';
    return 1 if $text =~ /sync state (?:entry|header)/i;
    return 1 if $text =~ /Unable to recover from (?:both-sided )?UIDVALIDITY change/i;
    return 1 if $text =~ /UIDVALIDITY genuinely changed/i;
    return 0;
}

sub _state_keep_pattern {
    my $pat = $track_cfg->{state_keep} // '';
    $pat =~ s/^\s+|\s+$//g if defined $pat;
    return '(?:^|/)(?:draft|sent)[^/]*$' if !defined $pat || $pat eq '';
    return $pat;
}

# True when this mailbox is one the config says to leave in place.
sub state_keep_hit {
    my ($box, $pat) = @_;
    return 0 if !defined $box || $box eq '';
    $pat = _state_keep_pattern() if !defined $pat;
    my $re = eval { qr/$pat/i };
    return 0 unless $re;
    return $box =~ $re ? 1 : 0;
}

# One -v line. Configured mailbox names, and whether a sync-state
# failure would keep or remove each one.
sub state_keep_plan {
    my %box;
    for my $acc (values %accounts) {
        next unless ref $acc eq 'HASH';
        for my $folder (@{ $acc->{folders} // [] }) {
            my $name = ref $folder eq 'HASH' ? $folder->{name} : $folder;
            next if !defined $name || $name eq '';
            $box{$name} = 1;
        }
    }
    my (@keep, @drop);
    for my $name (sort keys %box) {
        if (state_keep_hit($name)) {
            push @keep, $name;
        } else {
            push @drop, $name;
        }
    }
    my $line = 'state_keep ' . _state_keep_pattern();
    $line .= ' keep ' . join(', ', @keep) if @keep;
    $line .= ' remove ' . join(', ', @drop) if @drop;
    return $line;
}

sub log_state_keep_verbose {
    return unless $VERBOSE;
    log_info(state_keep_plan());
    return;
}

sub _sync_state_file {
    my ($text) = @_;
    return '' unless defined $text;
    return $1 if $text =~ / at (.+\.mbsyncstate):\d+/;
    return '';
}

sub _sync_state_box_name {
    my ($text) = @_;
    return '' unless defined $text;
    return $1 if $text =~ /side box ([^:\r\n]+):/;
    return '';
}

sub _expand_home {
    my ($p) = @_;
    return '' unless defined $p;
    $p =~ s/^\s+|\s+$//g;
    return '' if $p eq '';
    if ($p eq '~' || $p =~ m{^~/}) {
        my $home = $ENV{HOME} // '';
        return '' if $home eq '';
        $p =~ s{^~}{$home};
    }
    return $p;
}

sub _near_maildir {
    my ($text, $channel) = @_;
    return unless defined $text && defined $channel && $channel ne '';
    my (undef, $secs) = _parse_mbsync_rc($text);
    my $channels = _mbsync_named($secs, 'channel');
    my $ch = $channels->{$channel} or return;
    my $near = '';
    for my $line (@{ $ch->{lines} }) {
        my @tok = _mbsync_tokens($line);
        next unless @tok && lc $tok[0] eq 'near';
        $near = $tok[1] // '';
        $near =~ s/^:+//;
        $near =~ s/:+$//;
        last if $near ne '';
    }
    return if $near eq '';
    my $stores = _mbsync_named($secs, 'maildirstore');
    my $store = $stores->{$near} or return;
    my ($path, $inbox) = ('', '');
    for my $line (@{ $store->{lines} }) {
        my @tok = _mbsync_tokens($line);
        next unless @tok;
        $path  = $tok[1] // '' if lc $tok[0] eq 'path';
        $inbox = $tok[1] // '' if lc $tok[0] eq 'inbox';
    }
    $path  = _expand_home($path);
    $inbox = _expand_home($inbox);
    return if $path eq '';
    $path =~ s{/+$}{};
    $inbox =~ s{/+$}{} if $inbox ne '';
    return { path => $path, inbox => $inbox };
}

sub _read_mbsyncrc_text {
    my $src = _mbsyncrc_path();
    return '' if !defined $src || $src eq '' || !-r $src;
    open my $fh, '<', $src or return '';
    local $/;
    my $text = <$fh> // '';
    close $fh;
    return $text;
}

# Mailbox name relative to the store, or undef when $dir is not inside it.
sub _box_under_store {
    my ($dir, $store) = @_;
    return unless defined $dir && $dir ne '' && ref $store eq 'HASH';
    my $path = $store->{path} // '';
    return if $path eq '';
    $dir =~ s{/+$}{};
    my $inbox = $store->{inbox} // '';
    return 'INBOX' if $inbox ne '' && $dir eq $inbox;
    return if index($dir, "$path/") != 0;
    my $box = substr($dir, length($path) + 1);
    return if !defined $box || $box eq '' || $box =~ m{(^|/)\.\.(/|$)};
    return $box;
}

sub _box_dir {
    my ($store, $box) = @_;
    return '' unless ref $store eq 'HASH' && defined $box && $box ne '';
    if (lc($box) eq 'inbox' && ($store->{inbox} // '') ne '') {
        return $store->{inbox};
    }
    my $path = $store->{path} // '';
    return '' if $path eq '';
    return "$path/$box";
}

sub _sole_box_arg {
    my ($rec, $channel) = @_;
    return '' unless ref $rec eq 'HASH' && ref $rec->{args} eq 'ARRAY';
    my $box = '';
    for my $arg (@{ $rec->{args} }) {
        next unless defined $arg && $arg =~ /^([^:]+):(.+)$/;
        next unless $1 eq $channel;
        return '' if $box ne '';
        $box = $2;
    }
    return $box;
}

# Absolute maildir under the store, or undef. The store root itself
# is not a mailbox.
sub _removable_maildir {
    my ($dir, $store_path) = @_;
    return if !defined $dir || $dir eq '' || $dir !~ m{^/};
    return if $dir =~ m{(^|/)\.\.(/|$)};
    return if -l $dir || !-d $dir;
    return if -l "$dir/cur" || !-d "$dir/cur";
    my $real = abs_path($dir);
    my $root = abs_path($store_path);
    return if !defined $real || !defined $root || $root eq '';
    return if $real eq $root;
    return if index($real, "$root/") != 0;
    return $real;
}

# Remove the local mailbox and queue that one box again. A name that
# matches state_keep is left alone. Returns 1 when the directory was
# removed. $rc_text is the test's copy of the mbsync config.
sub recover_sync_state {
    my ($errtext, $rec, $rc_text) = @_;
    return 0 unless sync_state_issue($errtext);
    return 0 unless ref $rec eq 'HASH';
    my $channel = _hook_channel($rec);
    return 0 if $channel eq '';
    my $rc = defined $rc_text ? $rc_text : _read_mbsyncrc_text();
    my $store = _near_maildir($rc, $channel);
    if (!$store) {
        log_warn("$channel: sync state, mailbox path unknown");
        return 0;
    }
    my ($box, $dir);
    my $file = _sync_state_file($errtext);
    if ($file ne '') {
        $dir = dirname($file);
        $dir =~ s{/+$}{};
        $box = _box_under_store($dir, $store);
        if (!defined $box) {
            log_warn("$channel: sync state not removed");
            return 0;
        }
    } else {
        $box = _sync_state_box_name($errtext);
        $box = _sole_box_arg($rec, $channel) if $box eq '';
        if ($box eq '') {
            log_warn("$channel: sync state, mailbox name unknown");
            return 0;
        }
        $dir = _box_dir($store, $box);
    }
    if (state_keep_hit($box)) {
        log_warn("$channel: $box sync state kept");
        return 0;
    }
    my $real = _removable_maildir($dir, $store->{path});
    if (!$real) {
        log_warn("$channel: $box sync state not removed");
        return 0;
    }
    if ($DRY_RUN) {
        log_warn("$channel: $box would remove $real");
        return 0;
    }
    remove_tree($real, { safe => 1, error => \my $err });
    if (($err && @$err) || -d $real) {
        log_warn("$channel: $box sync state not removed");
        return 0;
    }
    log_warn("$channel: $box sync state removed, retry");
    my $now = time();
    queue_folder($channel, $box, $now, $now + 1);
    return 1;
}

sub reap_children {
    while (1) {
        my $statb = pack('i', 0);
        my $ru    = "\0" x 144;
        my $pid   = syscall($SYS_wait4, -1, $statb, WNOHANG, $ru);
        if (!defined $pid || $pid < 0) {
            next if $!{EINTR};
            # No child of this process. Entries left in the hash were
            # reparented to init, usually because they were forked by the
            # starter before daemonize. They will never be ours to reap.
            _drop_orphaned_children() if $!{ECHILD};
            last;
        }
        last if $pid == 0;
        my $status = unpack('i', $statb);
        if (my $hook = delete $hook_children{$pid}) {
            _finish_hook($pid, $hook, $status);
            next;
        }
        my $rec    = delete $children{$pid};
        _unlink_tunnel_cfg($rec);
        my $real   = 0;
        if (ref $rec eq 'HASH' && defined $rec->{started}) {
            $real = time() - $rec->{started};
        }
        my $text = '';
        if (ref $rec eq 'HASH' && $rec->{out_fh}) {
            my $fh = $rec->{out_fh};
            local $/;
            $text = <$fh> // '';
            close $fh;
        }
        my @args = _child_args($rec);
        my $slot = ref $rec eq 'HASH' ? $rec->{slot} : undef;
        my $errtext = _child_err_text($rec);
        my $errline = _err_line_from($errtext, $rec);
        my $line = mbsync_job_line('stop', $pid, { slot => $slot }, @args);
        $line .= ' ' . exit_how($status);
        my $cli  = mbsync_cli($rec);
        my $tail = note_mbsync_real($cli, $real, $ru);
        $line .= " $tail" if defined $tail && $tail ne '';
        $line .= " $errline" if $status && defined $errline && $errline ne '';
        $LAST_CHILD_EXIT = $line;
        if ($status == 0) {
            log_info($line);
        } else {
            log_warn($line);
            if (conn_limit_error($errline)) {
                requeue_after_conn_limit($rec);
            } elsif (($status & 127) == 0 && sync_state_issue($errtext)) {
                recover_sync_state($errtext, $rec);
            } elsif (($status & 127) == 0 && $VERBOSE && $errline ne '') {
                my $ch = _hook_channel($rec);
                log_info(($ch ne '' ? $ch : 'mbsync') . ': not a sync-state error');
            }
        }
        if (ref $rec eq 'HASH' && ($rec->{pulse} // '') ne '' && ($rec->{track} // '') eq '') {
            finish_pulse_channel($rec->{pulse});
        }
        finish_track_job($rec, $status, $real, $text) if ref $rec eq 'HASH' && $rec->{track};
        settle_counts_after($rec) if $status == 0 && ref $rec eq 'HASH';
        maybe_arm_sync_hooks($rec, $status) if ref $rec eq 'HASH';
    }
}

sub _drop_orphaned_children {
    return unless %children;
    for my $pid (sort { $a <=> $b } keys %children) {
        my $rec  = delete $children{$pid};
        _unlink_tunnel_cfg($rec);
        my @args = _child_args($rec);
        my $slot = ref $rec eq 'HASH' ? $rec->{slot} : undef;
        my $errline = _child_err_line($rec);
        my $line = mbsync_job_line('stop', $pid, { slot => $slot }, @args);
        $line .= ' gone';
        $line .= " $errline" if defined $errline && $errline ne '';
        $LAST_CHILD_EXIT = $line;
        log_warn($line);
        if (ref $rec eq 'HASH' && ($rec->{pulse} // '') ne '' && ($rec->{track} // '') eq '') {
            finish_pulse_channel($rec->{pulse});
        } elsif (ref $rec eq 'HASH' && ($rec->{pulse} // '') ne '' && ($rec->{track} // '') ne '') {
            finish_track_job($rec, 1, 0, '');
        }
    }
}

# Minimum time between mbsync runs is per folder. Events inside that gap
# stay pending and run when the gap ends. A ready event opens a 5s window
# on its mbsync channel so other ready folders of that channel share one
# invocation: mbsync channel:box channel:box ...
my $COMBINE_SEC = 5;
my %box_gap;
my %box_last_run;
my %box_pending;
my %box_wait;
my %batch;

sub batch_folders_for_test {
    my @out;
    for my $ch (sort keys %batch) {
        for my $box (sort keys %{ $batch{$ch}{boxes} // {} }) {
            push @out, "$ch:$box";
        }
    }
    return @out;
}

sub reset_batch_for_test { %batch = (); }

sub _named_queued { return keys %batch ? 1 : 0; }

sub named_sync_pending {
    return 1 if _named_queued();
    return 1 if _hot_running();
    return 0;
}

sub _box_id {
    my ($channel, $folder) = @_;
    return $channel . "\0" . $folder;
}

my $NAMED_PRIMED = 0;

sub reset_schedule_for_test {
    %box_gap      = ();
    %box_last_run = ();
    %box_pending  = ();
    %box_wait     = ();
    %batch        = ();
    $NAMED_PRIMED = 0;
}

sub forget_folder_schedule {
    my ($channel, $folder) = @_;
    return unless defined $channel && defined $folder;
    my $id = _box_id($channel, $folder);
    delete $box_gap{$id};
    delete $box_last_run{$id};
    delete $box_pending{$id};
    delete $box_wait{$id};
    return unless exists $batch{$channel};
    my $boxes = $batch{$channel}{boxes};
    delete $boxes->{$folder} if ref $boxes eq 'HASH';
    delete $batch{$channel} if !$boxes || !keys %$boxes;
}

sub _in_batch {
    my ($channel, $folder) = @_;
    return 0 unless exists $batch{$channel};
    my $boxes = $batch{$channel}{boxes};
    return 0 unless ref $boxes eq 'HASH' && exists $boxes->{$folder};
    return 1;
}

sub queue_folder {
    my ($channel, $folder, $now, $deadline_if_new) = @_;
    $batch{$channel}{boxes}{$folder} = 1;
    my $deadline = $batch{$channel}{deadline};
    # An open window keeps its deadline so a burst cannot postpone the run.
    return if defined $deadline && $deadline > $now;
    $batch{$channel}{deadline} = $deadline_if_new;
}

# folderN is queued once at startup. Reload does not queue it again.
sub prime_named_folders {
    my ($now) = @_;
    $now //= time();
    return if $NAMED_PRIMED;
    $NAMED_PRIMED = 1;
    for my $name (sort keys %accounts) {
        my $acc = $accounts{$name} or next;
        next if $acc->{disabled};
        my $channel = $acc->{mbsync_channel} // '';
        next if $channel eq '';
        my @names;
        for my $folder (@{ $acc->{folders} // [] }) {
            my $box = $folder->{name};
            next unless defined $box && $box ne '';
            my $id = _box_id($channel, $box);
            $box_gap{$id}     = $folder->{debounce} // 0;
            $box_wait{$id}    = 0;
            $box_pending{$id} = 0;
            queue_folder($channel, $box, $now, $now);
            push @names, $box;
        }
        log_info("$name: startup sync " . join(' ', @names)) if @names;
    }
}

# Local clock time with microseconds after the seconds. OpenBSD strftime
# has no %f, so the fraction is appended.
sub _clock {
    my ($when) = @_;
    $when = 0 if !defined $when || $when < 0;
    my $sec  = int($when);
    my $frac = $when - $sec;
    my $us   = int($frac * 1_000_000 + 0.5);
    if ($us >= 1_000_000) {
        $sec += int($us / 1_000_000);
        $us  %= 1_000_000;
    }
    return POSIX::strftime('%Y%m%d %H:%M:%S', localtime($sec))
        . sprintf('.%06d', $us);
}

sub _seconds_until {
    my ($when, $now) = @_;
    my $d = ($when // 0) - ($now // 0);
    $d = 0 if $d < 0;
    return int($d + 0.5);
}

sub note_mail_event {
    my ($channel, $folder, $gap, $wait, $now) = @_;
    return unless defined $channel && $channel ne '' && defined $folder && $folder ne '';
    $now  //= time();
    $wait //= 0;
    $gap  //= 0;
    my $id = _box_id($channel, $folder);
    $box_gap{$id}      = $gap;
    $box_wait{$id}     = $wait;
    $box_pending{$id}  = 1;
    my $last = $box_last_run{$id} // 0;
    if ($last && $now < $last + $gap) {
        my $when = $last + $gap;
        log_info(_log_name($channel) . ': ' . sprintf('%-5s %s next sync in %ds at %s',
            'kept', $folder, _seconds_until($when, $now), _clock($when)));
        return;
    }
    queue_folder($channel, $folder, $now, $now + $COMBINE_SEC);
    my $when = $batch{$channel}{deadline};
    log_info(_log_name($channel) . ': ' . sprintf('%-5s %s mbsync combines in %ds at %s',
        'ready', $folder, _seconds_until($when, $now), _clock($when)));
}

sub promote_pending {
    my ($now) = @_;
    for my $id (keys %box_pending) {
        next unless $box_pending{$id};
        my ($channel, $folder) = split /\0/, $id, 2;
        next if _in_batch($channel, $folder);
        my $last = $box_last_run{$id} // 0;
        my $gap  = $box_gap{$id} // 0;
        next if $last && $now < $last + $gap;
        queue_folder($channel, $folder, $now, $now);
        log_info(_log_name($channel) . ': ' . sprintf('%-5s %s minimum interval elapsed; mbsync scheduled',
            'due', $folder));
    }
}

sub take_due_batches {
    my ($now, $limit) = @_;
    my @jobs;
    return @jobs if defined $limit && $limit <= 0;
    for my $channel (sort keys %batch) {
        my $deadline = $batch{$channel}{deadline};
        next unless defined $deadline && $deadline <= $now;
        my @folders = sort keys %{ $batch{$channel}{boxes} // {} };
        next unless @folders;
        # A bare channel and channel:box are one mbsync. Leave the batch
        # until that process exits; the gap clock starts at the later spawn.
        next if channel_busy($channel);
        # A bad token must not become an mbsync socket. The batch stays
        # queued until the command's own wait has elapsed.
        my $hold = _pass_cmd_blocks($channel, $now);
        if ($hold) {
            $batch{$channel}{deadline} = $now + $hold;
            next;
        }
        last if defined $limit && @jobs >= $limit;
        my $wait = 0;
        for my $folder (@folders) {
            my $id = _box_id($channel, $folder);
            my $w  = $box_wait{$id} // 0;
            $wait = $w if $w > $wait;
            $box_last_run{$id} = $now;
            $box_pending{$id}  = 0;
        }
        delete $batch{$channel};
        push @jobs, {
            args => [ map { "$channel:$_" } @folders ],
            wait => $wait,
        };
    }
    return @jobs;
}

sub due_mbsync_jobs {
    my ($now, $limit) = @_;
    $now //= time();
    promote_resync($now);
    promote_pending($now);
    return take_due_batches($now, $limit);
}

# A watched folder has no other clock. After resync seconds with no
# sync, queue one the same way an arrival would.
sub promote_resync {
    my ($now) = @_;
    $now //= time();
    for my $name (sort keys %accounts) {
        my $acc = $accounts{$name} or next;
        next if $acc->{disabled};
        next if ($acc->{role} // '') ne 'idle';
        my $channel = $acc->{mbsync_channel} // '';
        next if $channel eq '';
        for my $folder (@{ $acc->{folders} // [] }) {
            my $box = $folder->{name} // '';
            next if $box eq '';
            my $id = _box_id($channel, $box);
            my $limit = $folder->{resync};
            $limit = default_resync() unless defined $limit && $limit >= 60;
            my $last = $box_last_run{$id} // 0;
            next unless $last;
            next if $now < $last + $limit;
            next if $box_pending{$id};
            next if _in_batch($channel, $box);
            note_mail_event(
                $channel, $box,
                $folder->{debounce} // 0,
                $acc->{wait} // 0,
                $now,
            );
        }
    }
}

sub next_resync_delay {
    my ($now) = @_;
    $now //= time();
    my $wait;
    for my $name (keys %accounts) {
        my $acc = $accounts{$name} or next;
        next if $acc->{disabled};
        next if ($acc->{role} // '') ne 'idle';
        my $channel = $acc->{mbsync_channel} // '';
        next if $channel eq '';
        for my $folder (@{ $acc->{folders} // [] }) {
            my $box = $folder->{name} // '';
            next if $box eq '';
            my $id = _box_id($channel, $box);
            my $last = $box_last_run{$id} // 0;
            next unless $last;
            next if $box_pending{$id};
            next if _in_batch($channel, $box);
            my $limit = $folder->{resync};
            $limit = default_resync() unless defined $limit && $limit >= 60;
            my $d = $last + $limit - $now;
            $d = 0 if $d < 0;
            $wait = $d if !defined $wait || $d < $wait;
        }
    }
    return $wait;
}

sub next_schedule_delay {
    my ($now) = @_;
    $now //= time();
    my $wait;
    for my $id (keys %box_pending) {
        next unless $box_pending{$id};
        my ($channel, $folder) = split /\0/, $id, 2;
        next if _in_batch($channel, $folder);
        my $last = $box_last_run{$id} // 0;
        next unless $last;
        my $d = $last + ($box_gap{$id} // 0) - $now;
        next if $d < 0;
        $wait = $d if !defined $wait || $d < $wait;
    }
    for my $channel (keys %batch) {
        next if channel_busy($channel);
        my $deadline = $batch{$channel}{deadline};
        next unless defined $deadline;
        my $d = $deadline - $now;
        $d = 0 if $d < 0;
        # No free slot: a due batch waits for a running mbsync to exit.
        next if $d <= 0 && slots_for_hot($now) <= 0;
        $wait = $d if !defined $wait || $d < $wait;
    }
    return $wait;
}

sub schedule_deadline {
    my ($channel) = @_;
    return unless exists $batch{$channel};
    return $batch{$channel}{deadline};
}

sub _channel_of_target {
    my ($arg) = @_;
    return unless defined $arg && $arg ne '';
    my ($ch) = split /:/, $arg, 2;
    return if !defined $ch || $ch eq '';
    return $ch;
}

sub child_label {
    my ($rec) = @_;
    return 'child' unless defined $rec;
    return $rec unless ref $rec;
    my $label = $rec->{label} // '';
    return $label eq '' ? 'child' : $label;
}

sub child_channels {
    my ($rec) = @_;
    my @args;
    if (ref $rec eq 'HASH' && @{ $rec->{args} // [] }) {
        @args = @{ $rec->{args} };
    } else {
        my $label = child_label($rec);
        $label =~ s/^mbsync\s+//;
        @args = split / /, $label if $label ne '' && $label ne 'child';
    }
    my %ch;
    for my $arg (@args) {
        my $ch = _channel_of_target($arg);
        $ch{$ch} = 1 if defined $ch;
    }
    return keys %ch;
}

sub channel_busy {
    my ($channel) = @_;
    return 0 unless defined $channel && $channel ne '';
    for my $pid (keys %children) {
        for my $ch (child_channels($children{$pid})) {
            return 1 if $ch eq $channel;
        }
    }
    return 0;
}

sub _child_args {
    my ($rec) = @_;
    if (ref $rec eq 'HASH' && ref $rec->{args} eq 'ARRAY' && @{ $rec->{args} }) {
        return @{ $rec->{args} };
    }
    my $label = child_label($rec);
    return () unless defined $label && $label =~ /^mbsync\s+(\S.*)\z/;
    return split / /, $1;
}

sub _connection_cap {
    my $cap = $track_cfg->{connections} // 1;
    return $cap < 1 ? 1 : int($cap);
}

# 0, 1, ... 9, a, ... z, then 10. A value at or past the connection
# cap means one mbsync was started too many.
sub slot_token {
    my ($n) = @_;
    return '' unless defined $n && $n =~ /^\d+$/;
    my $s = '';
    do {
        $s = substr('0123456789abcdefghijklmnopqrstuvwxyz', $n % 36, 1) . $s;
        $n = int($n / 36);
    } while ($n > 0);
    return $s;
}

sub alloc_mbsync_slot {
    my $cap = _connection_cap();
    my %used;
    for my $pid (keys %children) {
        my $rec = $children{$pid};
        next unless ref $rec eq 'HASH' && defined $rec->{slot} && $rec->{slot} =~ /^\d+$/;
        $used{ $rec->{slot} + 0 } = 1;
    }
    for (my $i = 0; $i < $cap; $i++) {
        return $i unless $used{$i};
    }
    my $n = $cap;
    $n++ while $used{$n};
    return $n;
}

# Average real seconds of this command, rounded, and the local time
# that far from $now. Empty until the command has finished once.
sub start_guestimate {
    my ($cli, $now) = @_;
    my $avg = _argv_real_avg($cli);
    return '' unless defined $avg;
    my $secs = int($avg + 0.5);
    $secs = 0 if $secs < 0;
    $now = time() if !defined $now;
    my $end = int($now) + $secs;
    my $clock = POSIX::strftime('%Y%m%d %H:%M:%S', localtime($end));
    return sprintf('guestimate %ds ending at %s', $secs, $clock);
}

# stop is one letter shorter than start, so one pad keeps the hash
# in one column. The pid is five columns inside the brackets.
sub _job_field {
    my ($verb, $slot) = @_;
    if (defined $slot && $slot =~ /^\d+$/ && ($verb eq 'start' || $verb eq 'stop')) {
        my $tok = slot_token($slot);
        my $raw = $verb eq 'stop' ? "$tok.stop" : "$tok.start";
        return sprintf('%-*s', length($tok) + 6, $raw);
    }
    return sprintf('%-5s', $verb);
}

sub mbsync_job_line {
    my ($verb, $pid, @args) = @_;
    $verb = 'stop' unless defined $verb && $verb ne '';
    $pid  = 0 if !defined $pid || $pid !~ /^-?\d+$/ || $pid < 0;
    my $slot;
    if (ref $args[0] eq 'HASH') {
        my $opt = shift @args;
        $slot = $opt->{slot} if exists $opt->{slot};
    }
    if (!defined $slot && ref $children{$pid} eq 'HASH') {
        $slot = $children{$pid}{slot};
    }
    my $field = _job_field($verb, $slot);
    my ($channel, @boxes);
    my $one = @args ? 1 : 0;
    for my $arg (@args) {
        my ($ch, $box) = split /:/, $arg, 2;
        if (!defined $ch || $ch eq '' || (defined $channel && $ch ne $channel)) {
            $one = 0;
            last;
        }
        $channel = $ch;
        push @boxes, $box if defined $box && $box ne '';
    }
    my $line;
    if (!$one || !defined $channel || $channel eq '') {
        my $shown = @args ? join(' ', @args) : '';
        $line = sprintf('mbsync: %s [%5d]', $field, $pid);
        $line .= " $shown" if $shown ne '';
    } else {
        my $hash = sha1_b(join("\0", @args));
        $line = sprintf('%s: %s %s[%5d]', _log_name($channel), $field, $hash, $pid);
        $line .= ' ' . join(',', @boxes) if @boxes;
    }
    if ($verb eq 'start' && @args) {
        my $guess = start_guestimate(join("\0", @args));
        $line .= " $guess" if defined $guess && $guess ne '';
    }
    return $line;
}

# One channel per process. The log names the account that claims it,
# then the mailboxes. The argument stays channel:box.
sub mbsync_phrase {
    my ($verb, @args) = @_;
    return $verb unless @args;
    my ($channel, @boxes);
    for my $arg (@args) {
        my ($ch, $box) = split /:/, $arg, 2;
        if (!defined $ch || $ch eq '' || (defined $channel && $ch ne $channel)) {
            return $verb . ' ' . join(' ', @args);
        }
        $channel = $ch;
        push @boxes, $box if defined $box && $box ne '';
    }
    my $rest = @boxes ? "$verb @boxes" : $verb;
    return _log_name($channel) . ": $rest";
}

sub child_state_line {
    my ($pid, $rec) = @_;
    my @args = _child_args($rec);
    return mbsync_job_line('child', $pid, @args) if @args;
    return sprintf('child pid %d %s', $pid, child_label($rec));
}

# mbsync runs this string as /bin/sh -c. Each argument is shell-quoted.
sub _sh_sq {
    my ($s) = @_;
    $s //= '';
    $s =~ s/'/'\\''/g;
    return "'$s'";
}

# One mbsync config argument. Backslash and double quote are escaped.
sub _mbsync_dq {
    my ($s) = @_;
    $s //= '';
    $s =~ s/([\\"])/\\$1/g;
    return qq{"$s"};
}

sub tunnel_shell {
    my ($section) = @_;
    return join(' ',
        _sh_sq($^X),
        _sh_sq($SELF_PATH // ''),
        _sh_sq('--tunnel'),
        _sh_sq($section // ''),
        _sh_sq('-c'),
        _sh_sq($CONFIG_FILE // ''),
    );
}

sub _mbsync_tokens {
    my ($line) = @_;
    return () if !defined $line || $line =~ /^\s*#/;
    my @tok;
    my $i = 0;
    my $n = length $line;
    while ($i < $n) {
        my $c = substr($line, $i, 1);
        if ($c =~ /\s/) {
            $i++;
            next;
        }
        if ($c eq '"') {
            $i++;
            my $s = '';
            while ($i < $n) {
                my $ch = substr($line, $i, 1);
                if ($ch eq '\\') {
                    $i++;
                    $s .= substr($line, $i, 1) if $i < $n;
                    $i++ if $i < $n;
                    next;
                }
                if ($ch eq '"') {
                    $i++;
                    last;
                }
                $s .= $ch;
                $i++;
            }
            push @tok, $s;
            next;
        }
        my $s = '';
        while ($i < $n && substr($line, $i, 1) !~ /\s/) {
            $s .= substr($line, $i, 1);
            $i++;
        }
        push @tok, $s;
    }
    return @tok;
}

my %_MBSYNC_DROP = map { $_ => 1 } qw(
    host port user usercmd pass passcmd authmechs
    tlstype tlsversions certificatefile systemcertificates
    pipelinedepth timeout tunnel cipherstring
    ssltype sslversions requiressl useimaps
);

my %_MBSYNC_START = map { $_ => 1 } qw(
    imapaccount imapstore maildirstore channel group
);

sub _parse_mbsync_rc {
    my ($text) = @_;
    $text = '' unless defined $text;
    $text =~ s/\r\n/\n/g;
    $text =~ s/\r/\n/g;
    my @lines = split /\n/, $text, -1;
    pop @lines if @lines && $lines[-1] eq '';
    my (@pre, @secs, $cur);
    for my $line (@lines) {
        if ($line =~ /^\s*$/) {
            if ($cur) {
                push @secs, $cur;
                $cur = undef;
            } else {
                push @pre, $line;
            }
            next;
        }
        if (!$cur && $line !~ /^\s*#/) {
            my @tok = _mbsync_tokens($line);
            if (@tok && $_MBSYNC_START{ lc $tok[0] }) {
                $cur = {
                    kw    => $tok[0],
                    name  => $tok[1] // '',
                    lines => [$line],
                };
                next;
            }
        }
        if ($cur) {
            push @{ $cur->{lines} }, $line;
        } else {
            push @pre, $line;
        }
    }
    push @secs, $cur if $cur;
    return (\@pre, \@secs);
}

sub _emit_mbsync_rc {
    my ($pre, $secs) = @_;
    my $out = '';
    $out .= join("\n", @$pre) . "\n" if @$pre;
    for my $sec (@$secs) {
        $out .= join("\n", @{ $sec->{lines} }) . "\n\n";
    }
    return $out;
}

sub _mbsync_named {
    my ($secs, $kw) = @_;
    my %h;
    for my $sec (@$secs) {
        next unless lc($sec->{kw}) eq $kw;
        next if ($sec->{name} // '') eq '';
        $h{ $sec->{name} } = $sec;
    }
    return \%h;
}

sub _chan_base {
    my ($tok) = @_;
    return '' unless defined $tok && $tok ne '';
    $tok =~ s/:.*//s;
    return $tok;
}

sub _group_members {
    my ($group) = @_;
    my @out;
    my $header = 1;
    for my $line (@{ $group->{lines} }) {
        next if $line =~ /^\s*#/;
        my @tok = _mbsync_tokens($line);
        next unless @tok;
        if ($header) {
            $header = 0;
            push @out, map { _chan_base($_) } @tok[ 2 .. $#tok ];
            next;
        }
        my $k = lc $tok[0];
        next unless $k eq 'channel' || $k eq 'channels';
        push @out, map { _chan_base($_) } @tok[ 1 .. $#tok ];
    }
    return grep { $_ ne '' } @out;
}

sub _imap_targets_for_channel {
    my ($ch, $stores, $iaccts) = @_;
    my @hits;
    for my $line (@{ $ch->{lines} }) {
        next if $line =~ /^\s*#/;
        my @tok = _mbsync_tokens($line);
        next unless @tok >= 2;
        my $k = lc $tok[0];
        next unless $k eq 'far' || $k eq 'near';
        next unless $tok[1] =~ /^:([^:]*):/;
        my $store = $stores->{$1} or next;
        next unless lc($store->{kw}) eq 'imapstore';
        my ($acct_name, $inline);
        for my $sl (@{ $store->{lines} }) {
            next if $sl =~ /^\s*#/;
            my @st = _mbsync_tokens($sl);
            next unless @st;
            if (lc($st[0]) eq 'account' && defined $st[1] && $st[1] ne '') {
                $acct_name = $st[1];
            }
            $inline = 1 if $_MBSYNC_DROP{ lc $st[0] };
        }
        if (defined $acct_name && $iaccts->{$acct_name}) {
            push @hits, $iaccts->{$acct_name};
        } elsif (!defined $acct_name && $inline) {
            push @hits, $store;
        }
    }
    return @hits;
}

# Prefer the section whose mbsync channel is the invoked name.
# Otherwise the section name, or its channel, is the IMAPAccount name.
sub _idle_section_for {
    my ($channel, $acct_obj) = @_;
    my $acct_name = $acct_obj->{name} // '';
    my @names = sort keys %accounts;
    for my $name (@names) {
        my $acc = $accounts{$name} or next;
        next if $acc->{disabled};
        my $role = $acc->{role} // 'idle';
        next unless $role eq 'idle' || $role eq 'pulse' || $role eq 'account';
        return $name if ($acc->{mbsync_channel} // '') eq $channel;
    }
    for my $name (@names) {
        my $acc = $accounts{$name} or next;
        next if $acc->{disabled};
        my $role = $acc->{role} // 'idle';
        next unless $role eq 'idle' || $role eq 'pulse' || $role eq 'account';
        return $name if $name eq $acct_name;
        return $name if ($acc->{mbsync_channel} // '') eq $acct_name;
    }
    return;
}

sub _rewrite_account_lines {
    my ($sec, $idle_name, $timeout) = @_;
    my @keep;
    for my $line (@{ $sec->{lines} }) {
        if ($line =~ /^\s*#/) {
            push @keep, $line;
            next;
        }
        my @tok = _mbsync_tokens($line);
        next if @tok && $_MBSYNC_DROP{ lc $tok[0] };
        push @keep, $line;
    }
    push @keep, 'Tunnel ' . _mbsync_dq(tunnel_shell($idle_name));
    push @keep, 'TLSType None';
    push @keep, 'Timeout ' . ($timeout + 0);
    $sec->{lines} = \@keep;
}

# Rewritten mbsyncrc text, or undef when no account is taken over.
# The caller falls back to mbsync's own file in that case.
sub tunnel_rewrite {
    my ($text, @args) = @_;
    return unless defined $text;
    my ($pre, $secs) = _parse_mbsync_rc($text);
    my $channels = _mbsync_named($secs, 'channel');
    my $groups   = _mbsync_named($secs, 'group');
    my $stores   = _mbsync_named($secs, 'imapstore');
    my $iaccts   = _mbsync_named($secs, 'imapaccount');
    my @chans;
    for my $arg (@args) {
        my $base = _chan_base($arg);
        next if $base eq '';
        if (my $group = $groups->{$base}) {
            push @chans, _group_members($group);
            next;
        }
        push @chans, $base if $channels->{$base};
    }
    my (%plan, @order);
    for my $chname (@chans) {
        my $ch = $channels->{$chname} or next;
        for my $obj (_imap_targets_for_channel($ch, $stores, $iaccts)) {
            my $idle = _idle_section_for($chname, $obj);
            next unless defined $idle;
            my $key = "$obj";
            if (exists $plan{$key} && $plan{$key}{idle} ne $idle) {
                log_warn('tunnel: ' . ($obj->{name} // '') . ' matches more than one section');
                return;
            }
            next if exists $plan{$key};
            $plan{$key} = { obj => $obj, idle => $idle };
            push @order, $key;
        }
    }
    return unless @order;
    my $timeout = $track_cfg->{tunnel_timeout} // 3600;
    $timeout = 3600 if !$timeout || $timeout < 1;
    for my $key (@order) {
        _rewrite_account_lines($plan{$key}{obj}, $plan{$key}{idle}, $timeout);
    }
    return _emit_mbsync_rc($pre, $secs);
}

sub _mbsyncrc_path {
    my $set = $track_cfg->{mbsyncrc} // '';
    return $set if $set ne '';
    my $home = $ENV{HOME} // '';
    my $xdg  = $ENV{XDG_CONFIG_HOME};
    $xdg = "$home/.config" if !defined $xdg || $xdg eq '';
    my $xdg_rc = "$xdg/isyncrc";
    return $xdg_rc if $xdg ne '' && -f $xdg_rc;
    return "$home/.mbsyncrc" if $home ne '';
    return '';
}

sub _tunnel_on {
    return $track_cfg && $track_cfg->{tunnel} ? 1 : 0;
}

sub prepare_tunnel_config {
    my (@args) = @_;
    return if $DRY_RUN;
    return unless _tunnel_on();
    return unless @args;
    my $src = _mbsyncrc_path();
    if (!defined $src || $src eq '' || !-r $src) {
        log_warn('tunnel: cannot read config');
        return;
    }
    open my $fh, '<', $src or do {
        log_warn('tunnel: cannot read config');
        return;
    };
    my $text = do { local $/; <$fh> };
    close $fh;
    my $out = tunnel_rewrite($text // '', @args);
    if (!defined $out) {
        log_warn('tunnel: no match');
        return;
    }
    if (!defined $STATE_DIR || $STATE_DIR eq '') {
        log_warn('tunnel: cannot write config');
        return;
    }
    my $dir = "$STATE_DIR/tunnel";
    my $made = eval { make_path($dir, { mode => 0700 }); 1 };
    if (!$made) {
        log_warn('tunnel: cannot write config');
        return;
    }
    $TUNNEL_SEQ++;
    my $path = "$dir/$$-$TUNNEL_SEQ.rc";
    my $old  = umask 0177;
    my $ok   = open my $outfh, '>', $path;
    if (!$ok) {
        umask $old;
        log_warn('tunnel: cannot write config');
        return;
    }
    print {$outfh} $out;
    close $outfh;
    umask $old;
    chmod 0600, $path;
    return $path;
}

sub _arm_tunnel {
    my (@args) = @_;
    return unless _tunnel_on();
    my $path = prepare_tunnel_config(@args);
    if ($path) {
        log_info('tunnel: ' . join(' ', @args));
        return $path;
    }
    log_warn('tunnel: plain ' . join(' ', @args));
    return;
}

sub _unlink_tunnel_cfg {
    my ($rec) = @_;
    return unless ref $rec eq 'HASH';
    my $path = $rec->{tunnel_cfg} // '';
    return if $path eq '';
    unlink $path;
    delete $rec->{tunnel_cfg};
}

sub mbsync_exec_argv {
    my ($cfg, @args) = @_;
    my @cmd = ($MBSYNC_BIN);
    push @cmd, '-c', $cfg if defined $cfg && $cfg ne '';
    push @cmd, @args;
    return @cmd;
}

sub _nb_fh {
    my ($fh) = @_;
    my $flags = fcntl($fh, F_GETFL, 0);
    return unless defined $flags;
    fcntl($fh, F_SETFL, $flags | O_NONBLOCK);
}

sub _write_all {
    my ($fh, $buf) = @_;
    my $off = 0;
    while ($off < length $buf) {
        my $n = syswrite($fh, $buf, length($buf) - $off, $off);
        if (!defined $n) {
            next if $!{EINTR};
            return 0;
        }
        return 0 if $n == 0;
        $off += $n;
    }
    return 1;
}

sub _ssl_want {
    my ($sock) = @_;
    return '' unless $sock && eval { $sock->can('want_read') };
    return 'r' if $sock->want_read;
    return 'w' if $sock->want_write;
    return '';
}

sub _tunnel_drain_pending {
    my ($sock) = @_;
    return '' unless $sock && eval { $sock->can('pending') };
    my $buf = '';
    while (1) {
        my $n = eval { $sock->pending } // 0;
        last if !$n || $n < 0;
        my $chunk;
        my $take = $n > 16384 ? 16384 : $n;
        my $got  = sysread($sock, $chunk, $take);
        last if !defined $got || $got == 0;
        $buf .= $chunk;
        last if length($buf) > 1048576;
    }
    return $buf;
}

sub _tunnel_half_close {
    my ($sock) = @_;
    return unless $sock;
    my $obj;
    $obj = eval { $sock->_get_ssl_object } if eval { $sock->can('_get_ssl_object') };
    if ($obj) {
        eval { Net::SSLeay::shutdown($obj) };
        return;
    }
    eval { shutdown($sock, SHUT_WR) };
}

# Bytes from STDIN go to the server. Bytes from the server go to STDOUT.
# STDIN EOF stops the server-bound writes. Server EOF ends the splice
# once those bytes have been written.
sub _tunnel_splice {
    my ($sock) = @_;
    binmode STDIN;
    binmode STDOUT;
    _nb_fh(\*STDIN);
    _nb_fh(\*STDOUT);
    _nb_fh($sock);
    eval { $sock->blocking(0) if $sock->can('blocking') };

    my $up     = '';
    my $down   = _tunnel_drain_pending($sock);
    my $in_eof = 0;
    my $sk_eof = 0;
    my $out_ok = 1;
    my $stopped = 0;
    my $hold   = '';

    while ($out_ok && !($sk_eof && $down eq '')) {
        if ($in_eof && $up eq '' && !$stopped && !$sk_eof) {
            $stopped = 1;
            _tunnel_half_close($sock);
        }
        my $rs = IO::Select->new();
        my $ws = IO::Select->new();
        $rs->add(\*STDIN)  if !$in_eof && length($up) < 65536;
        $ws->add(\*STDOUT) if length $down;
        if (!$sk_eof) {
            if ($hold eq 'w') {
                $ws->add($sock);
            } elsif ($hold eq 'r') {
                $rs->add($sock);
            } else {
                $rs->add($sock) if length($down) < 65536;
                $ws->add($sock) if length($up) && !$stopped;
            }
        }
        last if !$rs->count && !$ws->count;

        my ($rr, $ww) = IO::Select::select($rs, $ws, undef, undef);
        if (!defined $rr) {
            next if $!{EINTR};
            die "tunnel splice: $!\n";
        }
        my %rd     = map { fileno($_) => 1 } @$rr;
        my %wd     = map { fileno($_) => 1 } @$ww;
        my $in_fd  = fileno(STDIN);
        my $out_fd = fileno(STDOUT);
        my $sk_fd  = fileno($sock);

        if ($wd{$out_fd} && length $down) {
            my $n = syswrite(STDOUT, $down);
            if (!defined $n) {
                if ($! == EPIPE) {
                    $out_ok = 0;
                    $down   = '';
                } elsif ($! != EINTR && $! != EWOULDBLOCK && $! != EAGAIN) {
                    $out_ok = 0;
                    $down   = '';
                }
            } elsif ($n == 0) {
                $out_ok = 0;
                $down   = '';
            } else {
                substr($down, 0, $n, '');
            }
        }

        if (!$in_eof && $rd{$in_fd}) {
            my $chunk;
            my $n = sysread(STDIN, $chunk, 8192);
            if (!defined $n) {
                die "tunnel splice: stdin: $!\n"
                    unless $!{EINTR} || $!{EWOULDBLOCK} || $!{EAGAIN};
            } elsif ($n == 0) {
                $in_eof = 1;
            } else {
                $up .= $chunk;
            }
        }

        next if $sk_eof || !$sk_fd || (!$rd{$sk_fd} && !$wd{$sk_fd});
        my $wrote = 0;
        if (length $up && !$stopped && $hold ne 'r'
            && ($hold eq 'w' || $wd{$sk_fd})) {
            my $n = syswrite($sock, $up);
            $wrote = 1;
            if (!defined $n) {
                my $why = _ssl_want($sock);
                if ($why eq 'r' || $why eq 'w') {
                    $hold = $why;
                } elsif ($!{EINTR} || $!{EWOULDBLOCK} || $!{EAGAIN}) {
                    $hold = 'w';
                } else {
                    $sk_eof = 1;
                    $hold   = '';
                }
            } elsif ($n == 0) {
                $sk_eof = 1;
                $hold   = '';
            } else {
                substr($up, 0, $n, '');
                $hold = '';
            }
        }
        if (!$sk_eof && $hold ne 'w' && ($hold eq 'r' || (!$wrote && $rd{$sk_fd}))) {
            my $chunk;
            my $n = sysread($sock, $chunk, 8192);
            if (!defined $n) {
                my $why = _ssl_want($sock);
                if ($why eq 'r' || $why eq 'w') {
                    $hold = $why;
                } elsif ($!{EINTR} || $!{EWOULDBLOCK} || $!{EAGAIN}) {
                    $hold = 'r';
                } else {
                    $sk_eof = 1;
                    $hold   = '';
                }
            } elsif ($n == 0) {
                $sk_eof = 1;
                $hold   = '';
            } else {
                $down .= $chunk;
                $hold = '';
            }
        }
    }
    return 1;
}

# Log in on our own TLS session and hand mbsync a PREAUTH greeting.
# Stdout is the IMAP byte stream after that greeting.
sub tunnel_session {
    my ($section) = @_;
    $SIG{PIPE} = 'IGNORE';
    my $acc = $accounts{$section};
    die "tunnel $section: unknown section\n" unless $acc;
    die "tunnel $section: disabled\n" if $acc->{disabled};
    my $role = $acc->{role} // '';
    if ($role ne 'idle' && $role ne 'pulse' && $role ne 'account') {
        die "tunnel $section: not an account\n";
    }
    my $limit = $track_cfg->{tunnel_timeout} // 3600;
    $limit = 3600 if !$limit || $limit < 1;
    my $password = account_pass($section, $limit);
    die "tunnel $section: no password\n" unless defined $password;

    my $saved = $IO_MAX;
    $IO_MAX = $limit;
    my ($socket, $imap);
    my $ok = eval { ($socket, $imap) = login_imap($section, $acc, $password); 1 };
    my $err = $@;
    $IO_MAX = $saved;
    if (!$ok) {
        chomp $err;
        $err = scrub($err, $password);
        die "tunnel $section: $err\n";
    }
    if ($imap) {
        delete $imap->{Socket};
        delete $imap->{RawSocket};
        undef $imap;
    }
    binmode STDIN;
    binmode STDOUT;
    _write_all(\*STDOUT, "* PREAUTH ready\r\n")
        or die "tunnel $section: greeting: $!\n";
    _tunnel_splice($socket);
    _forget_fd_server($socket);
    eval { $socket->close } if $socket;
    return 1;
}

sub _split_tunnel_argv {
    my (@argv) = @_;
    my @rest;
    my $section;
    for (my $i = 0; $i < @argv; $i++) {
        if (($argv[$i] // '') eq '--tunnel') {
            my $name = $argv[ ++$i ];
            usage() if !defined $name || $name eq '' || $name =~ /^-/;
            usage() if defined $section;
            $section = $name;
            next;
        }
        push @rest, $argv[$i];
    }
    return ($section, @rest);
}

sub _abs_config {
    my ($path) = @_;
    return $path unless defined $path && $path ne '';
    my $abs = abs_path($path);
    return $abs if defined $abs && $abs ne '';
    return $path;
}

sub trigger_mbsync {
    my $meta = (ref($_[-1]) eq 'HASH') ? pop @_ : {};
    my ($wait, @args) = @_;
    $wait //= 0;
    return 0 unless @args;
    if ($DRY_RUN) {
        log_info(mbsync_phrase('would mbsync', @args));
        return 0;
    }
    if (ref $TRIGGER_HOOK eq 'CODE') {
        return $TRIGGER_HOOK->($wait, [@args], $meta);
    }
    my $tunnel_cfg = _arm_tunnel(@args);
    my $shown = join(' ', @args);
    my $capture = $meta->{capture};
    my ($rd, $wr, $erd, $ewr);
    if ($capture) {
        pipe($rd, $wr) or do {
            _unlink_tunnel_cfg({ tunnel_cfg => $tunnel_cfg });
            log_error(mbsync_phrase('fork mbsync', @args) . " failed: $!");
            return 0;
        };
    }
    pipe($erd, $ewr) or do {
        _unlink_tunnel_cfg({ tunnel_cfg => $tunnel_cfg });
        if ($capture) {
            close $rd;
            close $wr;
        }
        log_error(mbsync_phrase('fork mbsync', @args) . " failed: $!");
        return 0;
    };
    my $pid = fork();
    if (!defined $pid) {
        _unlink_tunnel_cfg({ tunnel_cfg => $tunnel_cfg });
        close $erd;
        close $ewr;
        if ($capture) {
            close $rd;
            close $wr;
        }
        log_error(mbsync_phrase('fork mbsync', @args) . " failed: $!");
        return 0;
    }
    if ($pid == 0) {
        $SIG{PIPE} = 'IGNORE';
        $SIG{HUP}  = 'DEFAULT';
        $SIG{INFO} = 'DEFAULT';
        $SIG{CHLD} = 'DEFAULT';
        $SIG{TERM} = 'DEFAULT';
        $SIG{INT}  = 'DEFAULT';
        _restore_wake_mask();
        close $erd;
        if ($capture) {
            close $rd;
            open STDOUT, '>&', $wr or _exit(127);
            close $wr;
        } else {
            open STDOUT, '>', '/dev/null' or _exit(127);
        }
        open STDERR, '>&', $ewr or _exit(127);
        close $ewr;
        close_extra_fds();
        open STDIN, '<', '/dev/null' or _exit(127);
        sleep $wait if $wait > 0;
        my @cmd = mbsync_exec_argv($tunnel_cfg, @args);
        exec @cmd or _exit(1);
    }
    close $ewr;
    cloexec($erd);
    if ($capture) {
        close $wr;
        cloexec($rd);
    }
    my $count_snap = _folder_count_snaps(@args);
    $children{$pid} = {
        label   => "mbsync $shown",
        args    => [@args],
        slot    => alloc_mbsync_slot(),
        pulse   => $meta->{pulse},
        track      => $meta->{track},
        tunnel_cfg => $tunnel_cfg,
        out_fh     => $capture ? $rd : undef,
        err_fh     => $erd,
        count_snap => $count_snap,
        started    => time(),
    };
    log_info(mbsync_job_line('start', $pid, @args));
    return $pid;
}

# Channels that have a pulse mailbox ready to sync. STATUS alone is
# not enough: the mailbox has to be classified and holding mail, or
# waiting on its weekly confirmation.
sub due_pulse_channels {
    my ($now) = @_;
    $now //= time();
    return () if $track_cfg && $track_cfg->{disabled};
    my %due;
    for my $id (keys %track) {
        my $rec = $track{$id} or next;
        next unless _row_wants_pulse_mbsync($rec, $now);
        my ($ch) = split /\0/, $id, 2;
        next if !defined $ch || $ch eq '';
        next if channel_busy($ch);
        $due{$ch} = 1;
    }
    return sort keys %due;
}

# A bare channel exit, if one is still recorded. Mailbox jobs use
# finish_track_job so each folder keeps its own clock.
sub finish_pulse_channel {
    my ($ch, $now) = @_;
    $now //= time();
    return unless defined $ch && $ch ne '';
    my $sweep = _pulse_sweep_for_channel($ch) // 3600;
    $sweep = 1 if $sweep < 1;
    my $n = 0;
    for my $id (keys %track) {
        my $rec = $track{$id} or next;
        next unless $rec->{pulse};
        my ($c) = split /\0/, $id, 2;
        next if !defined $c || $c ne $ch;
        $rec->{await_sync} = 0;
        $rec->{confirming} = 0;
        $rec->{next}       = $now + $sweep;
        $rec->{interval}   = $sweep unless $rec->{empty};
        $n++;
    }
    _pulse_note_exit($ch, $now);
    log_info(_log_name($ch) . ": pulse next in ${sweep}s") if $n;
}

sub pump_pulse { }

# Soonest pulse mbsync. Undef while no cold slot is free, so a full
# connection list does not spin the loop. STATUS wakes are separate.
sub next_pulse_delay {
    my ($now) = @_;
    $now //= time();
    return if $track_cfg && $track_cfg->{disabled};
    return if slots_for_cold($now) <= 0;
    my $wait;
    for my $id (keys %track) {
        my $rec = $track{$id} or next;
        next unless $rec->{pulse};
        my ($ch) = split /\0/, $id, 2;
        next if !defined $ch || $ch eq '';
        next if channel_busy($ch);
        my $when;
        if ($rec->{classified} && !$rec->{empty}) {
            $when = $rec->{next} // 0;
        } elsif ($rec->{empty} && defined $rec->{confirm}) {
            $when = $rec->{confirm};
        } else {
            next;
        }
        my $d = $when - $now;
        $d = 0 if $d < 0;
        $wait = $d if !defined $wait || $d < $wait;
    }
    return $wait;
}

sub _argv_real_avg {
    my ($cli) = @_;
    $cli = _memory_key($cli);
    return unless defined $cli;
    my $row = $MBSYNC_REAL{$cli} or return;
    return unless $row->{n};
    return $row->{total} / $row->{n};
}

sub tracked_deferred {
    my ($channel, $box, $now) = @_;
    return 1 if channel_busy($channel);
    if (exists $batch{$channel} && defined $batch{$channel}{deadline}) {
        return 1;
    }
    my $avg = _argv_real_avg("$channel:$box");
    for my $id (keys %box_pending) {
        next unless $box_pending{$id};
        my ($ch) = split /\0/, $id, 2;
        next if !defined $ch || $ch ne $channel;
        return 1 unless defined $avg;
        my $last = $box_last_run{$id} // 0;
        my $gap  = $box_gap{$id} // 0;
        return 1 if !$last || $now + $avg > $last + $gap;
    }
    return 0;
}

# Sooner of the STATUS wake and, while empty, the confirmation.
sub _track_when {
    my ($rec) = @_;
    my $when = $rec->{next} // 0;
    if ($rec->{empty} && defined $rec->{confirm} && $rec->{confirm} < $when) {
        $when = $rec->{confirm};
    }
    return $when;
}

sub _confirm_due {
    my ($rec, $now) = @_;
    return 0 unless $rec && $rec->{empty} && defined $rec->{confirm};
    return $rec->{confirm} <= $now ? 1 : 0;
}

# One log for the run that checks an empty mailbox for local mail.
sub _arm_confirm {
    my ($channel, $box, $rec) = @_;
    return unless $rec && !$rec->{confirming};
    $rec->{confirming} = 1;
    $rec->{await_sync} = 1;
    log_info(_log_name($channel) . ": $box confirm");
}

sub due_tracked {
    my ($now) = @_;
    $now //= time();
    return () if $track_cfg->{disabled};
    my @due;
    for my $id (keys %track) {
        my $rec = $track{$id} or next;
        next unless ($rec->{next} // 0) <= $now || _confirm_due($rec, $now);
        my ($ch, $box) = split /\0/, $id, 2;
        next if !defined $ch || !defined $box || $box eq '';
        next unless channel_claimed($ch);
        next if tracked_deferred($ch, $box, $now);
        push @due, { id => $id, channel => $ch, box => $box, next => _track_when($rec) };
    }
    return sort { $a->{next} <=> $b->{next} || $a->{box} cmp $b->{box} } @due;
}

# The sweep is counted from this mailbox's mbsync exit. An empty
# confirmation keeps the daily STATUS and the weekly clock.
sub _finish_pulse_box {
    my ($row, $channel, $box, $text, $now) = @_;
    my $confirming = $row->{confirming} ? 1 : 0;
    $row->{confirming} = 0;
    $row->{await_sync} = 0;
    my $sweep = $row->{sweep} // 3600;
    $sweep = 1 if $sweep < 1;
    my $msgs = mbsync_new_messages($text);
    if ($confirming && $row->{empty}) {
        if (defined $msgs && $msgs > 0) {
            $row->{empty} = 0;
            delete $row->{confirm};
            $row->{classified} = 1;
            $row->{interval}   = $sweep;
            $row->{next}       = $now + $sweep;
        } else {
            my $gap  = $track_cfg->{empty} // 86400;
            my $week = $track_cfg->{confirm} // 604800;
            $row->{next}    = $now + $gap;
            $row->{confirm} = $now + with_quarter_spread($week);
        }
        _pulse_note_exit($channel, $now);
        return;
    }
    $row->{interval} = $sweep;
    $row->{next}     = $now + $sweep;
    _pulse_note_exit($channel, $now);
    log_info(_log_name($channel) . ": $box pulse next in ${sweep}s");
}

# First STATUS that finds mail. The wait is the sweep plus a quarter
# spread drawn for this mailbox. A saved channel exit is the start of
# that wait. Several mailboxes that share the exit still draw apart.
# If that time is already past, this mailbox syncs now.
sub _classify_pulse_mail {
    my ($rec, $channel, $box, $now) = @_;
    $rec->{classified} = 1;
    $rec->{empty}      = 0;
    delete $rec->{confirm};
    $rec->{confirming} = 0;
    my $sweep = $rec->{sweep} // 3600;
    $sweep = 1 if $sweep < 1;
    $rec->{interval} = $sweep;
    my $seed = $rec->{seed};
    delete $rec->{seed};
    my $spread = with_quarter_spread($sweep);
    my $due = $now + $spread;
    $due = $seed + $spread if defined $seed && $seed =~ /^[\d.]+$/;
    if ($due <= $now) {
        $rec->{await_sync} = 1;
        $rec->{next}       = $now;
        return;
    }
    $rec->{await_sync} = 0;
    $rec->{next}       = $due;
    my $in = int($due - $now);
    $in = 0 if $in < 0;
    log_info(_log_name($channel) . ": $box sweep in ${in}s");
}

sub finish_track_job {
    my ($rec, $status, $real, $text, $now) = @_;
    return unless ref $rec eq 'HASH' && defined $rec->{track};
    my $id = $rec->{track};
    $now //= time();
    my ($channel, $box) = split /\0/, $id, 2;
    $list_next{$channel} = 0 if defined $channel && $channel ne '' && $status;
    my $row = $track{$id} or return;
    if ($row->{pulse}) {
        _finish_pulse_box($row, $channel, $box, $text, $now);
        return;
    }
    my $confirming = $row->{confirming} ? 1 : 0;
    $row->{confirming} = 0;
    $row->{await_sync} = 0;
    my $msgs = mbsync_new_messages($text);
    if (!defined $msgs) {
        # A non-zero exit with no summary is the mbsync failure already
        # on the stop line. It is not a quiet mailbox, so the interval
        # stays. Exit 0 with no summary is still a miss.
        if (!$status) {
            $row->{fails} = ($row->{fails} // 0) + 1;
            if ($row->{fails} >= 3) {
                my $old = $row->{interval} // $track_cfg->{initial};
                my $span = $old * 3;
                $row->{interval} = next_mailbox_interval($old, []);
                $row->{samples}  = [];
                $row->{fails}    = 0;
                if ($row->{interval} != $old) {
                    log_info(_log_name($channel) . ": track $box interval ${old}s -> $row->{interval}s "
                        . "(0 new in ${span}s, sync 0s)");
                }
            }
        }
    } else {
        my $old = $row->{interval} // $track_cfg->{initial};
        push @{ $row->{samples} }, { msgs => $msgs, dur => $real, span => $old };
        $row->{fails} = 0;
        if (@{ $row->{samples} } >= 3) {
            my ($sum_m, $sum_s, $sum_d, $n) = (0, 0, 0, 0);
            for my $s (@{ $row->{samples} }) {
                $sum_m += $s->{msgs} // 0;
                $sum_s += $s->{span} // 0;
                $sum_d += $s->{dur} // 0;
                $n++;
            }
            $row->{interval} = next_mailbox_interval($old, $row->{samples});
            $row->{samples} = [];
            if ($row->{interval} != $old) {
                my $sync = $n ? int($sum_d / $n + 0.5) : 0;
                log_info(_log_name($channel) . ": track $box interval ${old}s -> $row->{interval}s "
                    . "($sum_m new in ${sum_s}s, sync ${sync}s)");
            }
        }
    }
    if ($confirming && $row->{empty}) {
        if (defined $msgs && $msgs > 0) {
            $row->{empty} = 0;
            delete $row->{confirm};
            $row->{next} = $now + $row->{interval};
        } else {
            my $gap  = $track_cfg->{empty} // 86400;
            my $week = $track_cfg->{confirm} // 604800;
            $row->{next}    = $now + $gap;
            $row->{confirm} = $now + with_quarter_spread($week);
        }
        return;
    }
    $row->{next} = $now + $row->{interval};
}

sub _shutdown_wanted {
    return 1 if $SHUTDOWN;
    return 1 if shutdown_path();
    return 0;
}

sub shutdown_phase {
    return '' unless _shutdown_wanted();
    if (!$shutdown_reason) {
        if (my $path = shutdown_path()) {
            $shutdown_reason = "shutdown file $path detected, finishing mbsync";
        } else {
            my $sig = ($SHUTDOWN && $SHUTDOWN eq 'INT') ? 'INT' : 'TERM';
            $shutdown_reason = "signal $sig, finishing mbsync";
        }
        log_info($shutdown_reason);
        # IDLE ends with DONE then LOGOUT. NOTIFY ends with LOGOUT.
        # mbsync is still allowed to finish after the sockets are closed.
        _release_imap_sessions();
    }
    my $n = mbsync_running();
    if ($n > 0) {
        log_info("waiting on $n mbsync") unless $shutdown_waiting;
        $shutdown_waiting = 1;
        return 'wait';
    }
    return 'exit';
}

sub _conn_what {
    my ($conn, $key) = @_;
    my $name = $conn->{name} // '?';
    my $what = $key // '';
    $what =~ s/^\Q$name\E:// if $name ne '?';
    return $what;
}

sub _disconnect_conn {
    my ($key) = @_;
    return unless defined $key && exists $conns{$key};
    my $conn = delete $conns{$key};
    drop_socket($conn->{socket});
    my $name = $conn->{name} // '?';
    my $what = _conn_what($conn, $key);
    my $secs = 0;
    $secs = time() - $conn->{started} if defined $conn->{started};
    my $avg = note_conn_time(_conn_time_key($conn), $secs) // '';
    log_info("$name: disconnecting $what" . ($avg ne '' ? " $avg" : ''));
    eval { _leave_idle($conn) };
    close_session($conn->{imap}, $conn->{socket});
}

sub _release_imap_sessions {
    return if $RELEASING;
    $RELEASING = 1;
    for my $key (sort keys %conns) {
        eval { _disconnect_conn($key) };
        log_error("disconnect $key: " . scrub($@)) if $@;
    }
    $RELEASING = 0;
}

sub _close_for_shutdown {
    _release_imap_sessions();
    save_stat_files();
    save_track_file();
    _conn_limit_save();
    ctl_close();
    my $dir = $STATE_DIR;
    if (!defined $dir || $dir eq '') {
        $dir = (defined $ENV{HOME} && $ENV{HOME} ne '') ? "$ENV{HOME}/.local/imapidle" : '.local/imapidle';
    }
    log_info("wrote $dir stats");
    log_info('shutdown complete');
    closelog() if $LOG_OPEN;
    $LOG_OPEN = 0;
}

# Startup must not open another mailbox or daemonize once a shutdown
# file is present. An mbsync this process already forked may finish.
my $ABANDON_EXIT;

sub set_abandon_exit_for_test { $ABANDON_EXIT = $_[0]; }

sub _abandon_startup {
    my $phase = shutdown_phase();
    return if $phase eq '';
    while ($phase eq 'wait') {
        reap_children();
        _handles_ready(1);
        $phase = shutdown_phase();
    }
    _close_for_shutdown();
    $ABANDON_EXIT->() if $ABANDON_EXIT;
    exit 0;
}

sub request_shutdown {
    my ($sig) = @_;
    $SHUTDOWN = (defined $sig && $sig eq 'INT') ? 'INT' : 'TERM';
    _poke_info();
}

sub _primary_for_channel {
    my ($channel) = @_;
    return unless defined $channel && $channel ne '';
    for my $key (keys %conns) {
        my $conn = $conns{$key} or next;
        next unless $conn->{primary} && $conn->{imap};
        next unless ($conn->{channel} // '') eq $channel;
        return $conn;
    }
    return;
}

sub _due_unprobed {
    my ($channel, $now) = @_;
    my @ids;
    for my $id (keys %track) {
        my $rec = $track{$id} or next;
        next if $rec->{await_sync};
        next if ($rec->{next} // 0) > $now;
        my ($ch, $box) = split /\0/, $id, 2;
        next if !defined $ch || $ch ne $channel;
        next if !defined $box || $box eq '';
        push @ids, $id;
    }
    return sort @ids;
}

# A dead primary must not stay in the table. The next lap would send
# DONE again, and the server answers BAD until it closes the socket.
sub _park_reconnect {
    my ($name) = @_;
    my $acc = $accounts{$name} or return;
    my $soon = time() + 60;
    $acc->{next_try} = $soon if ($acc->{next_try} // 0) < $soon;
}

sub _drop_idle_conn {
    my ($conn, $why) = @_;
    return unless $conn && $conn->{key} && exists $conns{ $conn->{key} };
    $conn->{idling} = 0;
    my $name = $conn->{name};
    drop_conn($conn->{key}, $why, 1);
    _park_reconnect($name);
}

sub _mark_probe_fallback {
    my ($channel, $now, @extra) = @_;
    my %seen;
    for my $id (@extra, _due_unprobed($channel, $now)) {
        next if !defined $id || $seen{$id}++;
        my $rec = $track{$id} or next;
        next if ($rec->{next} // 0) > $now;
        $rec->{await_sync} = 1;
    }
}

# Ask the primary connection before spending an mbsync on a mailbox
# that has nothing in it. One IDLE gap covers a batch, then IDLE resumes.
sub _probe_channel {
    my ($conn, $channel, $now) = @_;
    my @ids = _due_unprobed($channel, $now);
    return unless @ids;
    my $limit = 40;
    @ids = @ids[0 .. $limit - 1] if @ids > $limit;
    my $imap = $conn->{imap};
    my $idle = ($conn->{mode} // '') eq 'IDLE';
    unless ($imap && imap_connected($imap)) {
        log_warn("$conn->{name}: STATUS probe: not connected");
        _mark_probe_fallback($channel, $now, @ids);
        _drop_idle_conn($conn, 'STATUS probe failed');
        return;
    }
    my $empty_n = 0;
    my $sync_n  = 0;
    my $ok = eval {
        if ($idle) {
            my ($left, @done) = _leave_idle($conn);
            _queue_mail_lines($conn, @done);
            die($imap->LastError || 'DONE failed') unless $left;
        }
        my $budget = _conn_read_budget($conn);
        for my $id (@ids) {
            my $rec = $track{$id} or next;
            my (undef, $box) = split /\0/, $id, 2;
            my @resp = grep { defined && $_ ne '' } _with_read_deadline($budget, sub {
                $imap->tag_and_run(
                    'STATUS ' . imap_mailbox($box) . ' (MESSAGES UIDNEXT)'
                );
            });
            my ($messages, $uidnext) = parse_status_counts(join("\n", @resp));
            my $kind = note_status_sample($channel, $box, $messages, $uidnext, $now);
            $empty_n++ if $kind eq 'empty';
            $sync_n++ if $kind eq 'sync';
        }
        1;
    };
    my $err = $@;
    if ($ok && $idle && imap_connected($imap)) {
        my $tag = eval { $imap->idle() };
        unless (_note_idle($conn, $tag)) {
            log_warn("$conn->{name}: IDLE after STATUS failed: " . scrub($@));
            _drop_idle_conn($conn, 'IDLE after STATUS failed');
        }
    } elsif ($ok && $idle) {
        _drop_idle_conn($conn, 'IDLE after STATUS failed');
    }
    if (!$ok) {
        log_warn("$conn->{name}: STATUS probe: " . scrub($err));
        _mark_probe_fallback($channel, $now, @ids);
        _drop_idle_conn($conn, 'STATUS probe failed');
        return;
    }
    my $n = $empty_n + $sync_n;
    log_info(_log_name($channel) . ": STATUS $n probed, $empty_n empty, $sync_n sync") if $n;
}

sub probe_tracked {
    my ($now) = @_;
    return if $track_cfg->{disabled};
    $now //= time();
    my %channels;
    for my $id (keys %track) {
        my $rec = $track{$id} or next;
        next if $rec->{await_sync};
        next if ($rec->{next} // 0) > $now;
        my ($ch) = split /\0/, $id, 2;
        $channels{$ch} = 1 if defined $ch && $ch ne '';
    }
    for my $ch (sort keys %channels) {
        my $conn = _primary_for_channel($ch) or next;
        _probe_channel($conn, $ch, $now);
    }
}

sub due_unprobed_ids { return _due_unprobed(@_) }

sub _needs_probe {
    my ($id, $now) = @_;
    my $rec = $track{$id} or return 0;
    return 0 if $rec->{await_sync};
    return 0 if ($rec->{next} // 0) > $now;
    my ($ch) = split /\0/, $id, 2;
    return 0 if !defined $ch || $ch eq '';
    return 1 if _primary_for_channel($ch);
    return 1 if $EXTERNAL_PROBE{$ch};
    return 0;
}

# One STATUS sample for a tracked mailbox. 'empty' and 'sync' match
# the counters _probe_channel used to keep itself. '' is a sample
# that did not arm a sync.
sub note_status_sample {
    my ($channel, $box, $messages, $uidnext, $now) = @_;
    return '' if !defined $channel || $channel eq '';
    return '' if !defined $box || $box eq '';
    $now //= time();
    my $rec = $track{ _track_key($channel, $box) } or return '';
    if (!defined $messages) {
        $rec->{await_sync} = 1;
        return 'sync';
    }
    my $prev = $rec->{uidnext};
    my $was_empty = $rec->{empty} ? 1 : 0;
    $rec->{uidnext}  = $uidnext;
    $rec->{messages} = $messages;
    my $gap = $track_cfg->{empty} // 86400;
    if (status_stays_empty($messages, $uidnext, $prev)) {
        $rec->{empty} = 1;
        if ($rec->{pulse}) {
            $rec->{classified} = 1;
            delete $rec->{seed};
        }
        unless (defined $rec->{confirm}) {
            my $week = $track_cfg->{confirm} // 604800;
            $rec->{confirm} = $now + with_quarter_spread($week);
        }
        if ($rec->{confirm} <= $now) {
            _arm_confirm($channel, $box, $rec);
            return 'sync';
        }
        $rec->{await_sync} = 0;
        $rec->{confirming} = 0;
        $rec->{next}       = $now + $gap;
        return 'empty';
    }
    if ($rec->{pulse} && !$rec->{classified}) {
        _classify_pulse_mail($rec, $channel, $box, $now);
        return $rec->{await_sync} ? 'sync' : '';
    }
    $rec->{empty}      = 0;
    $rec->{await_sync} = 1;
    delete $rec->{confirm};
    $rec->{confirming} = 0;
    log_info(_log_name($channel) . ": $box has mail") if $was_empty;
    return 'sync';
}

sub pump_tracked {
    my ($now) = @_;
    $now //= time();
    return if $track_cfg->{disabled};
    probe_tracked($now);
    my %started;
    for my $job (due_tracked($now)) {
        last if slots_for_cold($now) <= 0;
        next if _needs_probe($job->{id}, $now);
        next if $started{ $job->{channel} } || channel_busy($job->{channel});
        my $row = $track{ $job->{id} };
        my $hold = _pass_cmd_blocks($job->{channel}, $now);
        if ($hold) {
            if ($row) {
                $row->{next} = $now + $hold;
                $row->{await_sync} = 0;
            }
            next;
        }
        _arm_confirm($job->{channel}, $job->{box}, $row)
            if $row && _confirm_due($row, $now);
        my %meta = (
            track   => $job->{id},
            capture => 1,
        );
        $meta{pulse} = $job->{channel} if $row && $row->{pulse};
        my $pid = trigger_mbsync(0, "$job->{channel}:$job->{box}", \%meta);
        if ($pid) {
            $started{ $job->{channel} } = 1;
        } else {
            $row = $track{ $job->{id} } or next;
            if ($row->{pulse}) {
                my $sweep = $row->{sweep} // 3600;
                $sweep = 1 if $sweep < 1;
                $row->{confirming} = 0;
                $row->{await_sync} = 0;
                $row->{next}       = $now + $sweep;
                next;
            }
            if ($row->{confirming}) {
                $row->{confirming} = 0;
                $row->{await_sync} = 0;
                my $retry = $now + ($track_cfg->{initial} // 1800);
                $row->{confirm} = $retry
                    if !defined $row->{confirm} || $row->{confirm} <= $now;
                $row->{next} = $retry if ($row->{next} // 0) <= $now;
            } else {
                $row->{next}       = $now + ($track_cfg->{initial} // 1800);
                $row->{await_sync} = 0;
            }
        }
    }
}

sub operations_paused {
    return 1 if $CTL_PAUSE;
    return pause_path() ? 1 : 0;
}

sub _pause_gate {
    my $path = pause_path();
    if ($path || $CTL_PAUSE) {
        unless ($pause_announced) {
            if ($path) {
                log_info("pause file $path detected, idling operations");
            } else {
                log_info('pause requested, idling operations');
            }
            $pause_announced = 1;
        }
        return 1;
    }
    if ($pause_announced) {
        log_info('pause cleared, mbsync resuming');
        $pause_announced = 0;
    }
    return 0;
}

# mbsync has to be a child of the process that stays. The starter exits
# at daemonize, and a child it forked is reparented to init.
my $LIVE = 1;

sub set_live_for_test { $LIVE = $_[0] ? 1 : 0; }

# A STATUS read waits inside this pump. A nested pump writes another
# command and never reads the reply, which is what pegged the CPU.
# Forking an already-due hot mbsync does not write a command.
my $PUMP_DEPTH = 0;
my $HOT_PUMP   = 0;

# Due hot mail only. Safe while a probe is inside an IMAP read:
# this path forks mbsync and does not send another command.
sub _pump_hot {
    my ($now) = @_;
    return if $HOT_PUMP;
    return if shutdown_phase() || _pause_gate();
    $HOT_PUMP = 1;
    eval {
        $now //= time();
        for my $job (due_mbsync_jobs($now, slots_for_hot($now))) {
            trigger_mbsync($job->{wait}, @{ $job->{args} });
        }
        1;
    };
    $HOT_PUMP = 0;
    return;
}

sub pump_schedule {
    my ($now) = @_;
    return unless $LIVE;
    if ($PUMP_DEPTH) {
        _pump_hot($now);
        return;
    }
    $PUMP_DEPTH++;
    my $err;
    eval {
        $now //= time();
        my $phase = shutdown_phase();
        unless ($phase || _pause_gate()) {
            for my $job (due_mbsync_jobs($now, slots_for_hot($now))) {
                trigger_mbsync($job->{wait}, @{ $job->{args} });
            }
            pump_tracked($now);
        }
        1;
    } or $err = $@ || 'pump failed';
    $PUMP_DEPTH--;
    die $err if $err;
}

# Server keepalive and command replies are not mail. EXISTS, EXPUNGE,
# FETCH, RECENT, VANISHED, and STATUS are notices. On an IDLE folder
# only a higher EXISTS, a STATUS line, or hyperdelete's removals schedule.
sub mail_event_line {
    my ($line) = @_;
    return 0 unless defined $line && $line ne '';
    return 0 if $line =~ /^\*\s+(OK|NO|BAD|BYE)\b/i;
    return 0 if $line =~ /^\+/;
    return 0 if $line =~ /^[A-Za-z][A-Za-z0-9]*\s+(OK|NO|BAD|BYE)\b/;
    return 1 if $line =~ /^\*\s+\d+\s+(EXISTS|EXPUNGE|FETCH|RECENT)\b/i;
    return 1 if $line =~ /^\*\s+(VANISHED|STATUS)\b/i;
    return 0;
}

# UID set from VANISHED. Undef when a '*' or a bad token makes the
# size unknowable, so the next EXISTS is treated as a fresh baseline
# that still schedules once.
sub vanished_count {
    my ($set) = @_;
    return if !defined $set || $set eq '';
    my $n = 0;
    for my $part (split /,/, $set) {
        return if $part =~ /\*/;
        if ($part =~ /^(\d+):(\d+)$/) {
            return if $1 < 1 || $2 < 1;
            my ($lo, $hi) = $1 <= $2 ? ($1, $2) : ($2, $1);
            $n += $hi - $lo + 1;
        } elsif ($part =~ /^(\d+)$/) {
            return if $1 < 1;
            $n++;
        } else {
            return;
        }
    }
    return $n;
}

# The connection that is watching this mailbox, if one is up.
# IDLE is one folder. Poll keeps every configured folder.
sub _conn_watching {
    my ($channel, $box) = @_;
    return unless defined $channel && $channel ne '' && defined $box && $box ne '';
    my $poll;
    for my $conn (values %conns) {
        next unless ($conn->{channel} // '') eq $channel;
        my $mode = $conn->{mode} // '';
        if ($mode eq 'IDLE' && ($conn->{folder} // '') eq $box) {
            return $conn;
        }
        next unless $mode eq 'POLL';
        for my $folder (@{ $conn->{folders} // [] }) {
            $poll = $conn if ($folder->{name} // '') eq $box;
        }
    }
    return $poll;
}

sub _chase_on {
    my ($conn, $box) = @_;
    return 0 unless $conn;
    if (($conn->{mode} // '') eq 'POLL') {
        return $conn->{box_chase}{$box} ? 1 : 0;
    }
    return $conn->{uidnext_chase} ? 1 : 0;
}

sub _chase_set {
    my ($conn, $box, $on) = @_;
    return unless $conn;
    if (($conn->{mode} // '') eq 'POLL') {
        if ($on) {
            $conn->{box_chase}{$box} = 1;
        } else {
            delete $conn->{box_chase}{$box};
        }
        return;
    }
    $conn->{uidnext_chase} = $on ? 1 : 0;
}

# Numbers the next EXISTS is compared with, copied at the moment the
# child is forked. Taking the copy clears a pending UIDNEXT confirmation
# so only this run is that confirmation.
sub _folder_count_snaps {
    my %snap;
    for my $arg (@_) {
        next unless defined $arg;
        my ($channel, $box) = split /:/, $arg, 2;
        next unless defined $box && $box ne '';
        my $conn = _conn_watching($channel, $box) or next;
        my $poll = ($conn->{mode} // '') eq 'POLL';
        my $seen = $poll ? $conn->{seen}{$box} : undef;
        $snap{ $channel . "\0" . $box } = {
            channel  => $channel,
            box      => $box,
            messages => $poll ? ($seen && $seen->{messages}) : $conn->{messages},
            uidnext  => $poll ? ($seen && $seen->{uidnext}) : $conn->{uidnext},
            chase    => _chase_on($conn, $box),
        };
        _chase_set($conn, $box, 0);
    }
    return \%snap;
}

# $snap is the count at fork. A higher message total is mail the run
# may have missed. A higher UIDNEXT with no higher total is one
# confirmation run. A confirmation that itself only moves UIDNEXT
# adopts the new number and stops, so a flag rewrite cannot requeue
# forever. Returns (schedule, confirmation).
sub count_follow_decision {
    my ($snap, $messages, $uidnext) = @_;
    return (0, 0) unless ref $snap eq 'HASH';
    return (0, 0) unless defined $messages && defined $uidnext;
    my $prev_m = $snap->{messages};
    my $prev_u = $snap->{uidnext};
    return (1, 0) if defined $prev_m && $messages > $prev_m;
    if (defined $prev_u && $uidnext > $prev_u) {
        return (0, 0) if $snap->{chase};
        return (1, 1);
    }
    return (0, 0);
}

sub _store_watch_counts {
    my ($conn, $box, $messages, $uidnext, $chase) = @_;
    return unless $conn;
    if (($conn->{mode} // '') eq 'POLL') {
        $conn->{seen}{$box} //= {};
        $conn->{seen}{$box}{messages} = $messages;
        $conn->{seen}{$box}{uidnext}  = $uidnext;
    } else {
        $conn->{messages} = $messages;
        $conn->{uidnext}  = $uidnext;
    }
    _chase_set($conn, $box, $chase);
}

# Leave IDLE, ask STATUS, and resume IDLE. Undef when the count is
# not available. A failed resume drops the connection the way a probe does.
sub _status_watching {
    my ($conn, $box) = @_;
    return unless $conn && defined $box && $box ne '';
    my $imap = $conn->{imap};
    return unless imap_connected($imap);
    my $idle = ($conn->{mode} // '') eq 'IDLE';
    if ($idle) {
        my ($left, @done) = _leave_idle($conn);
        _queue_mail_lines($conn, @done) if $left;
        unless ($left) {
            log_warn(($conn->{name} // 'imap') . ": STATUS after sync: IDLE did not end");
            return;
        }
    }
    my ($messages, $uidnext);
    my $ok = eval {
        my @resp = grep { defined && $_ ne '' } $imap->tag_and_run(
            'STATUS ' . imap_mailbox($box) . ' (MESSAGES UIDNEXT)'
        );
        ($messages, $uidnext) = parse_status_counts(join("\n", @resp));
        1;
    };
    my $err = $@;
    if ($idle && imap_connected($imap)) {
        my $tag = eval { $imap->idle() };
        unless (_note_idle($conn, $tag)) {
            log_warn(($conn->{name} // 'imap') . ": IDLE after STATUS failed: " . scrub($@));
            _drop_idle_conn($conn, 'IDLE after STATUS failed');
        }
    } elsif ($idle) {
        _drop_idle_conn($conn, 'IDLE after STATUS failed');
    }
    if (!$ok) {
        log_warn(($conn->{name} // 'imap') . ": STATUS after sync: " . scrub($err));
        return;
    }
    return unless defined $messages && defined $uidnext;
    return ($messages, $uidnext);
}

# After mbsync exits 0, make the remembered total match the server
# and schedule when the run can have missed mail.
sub settle_counts_after {
    my ($rec) = @_;
    return unless ref $rec eq 'HASH' && ref $rec->{count_snap} eq 'HASH';
    for my $id (sort keys %{ $rec->{count_snap} }) {
        my $snap = $rec->{count_snap}{$id};
        next unless ref $snap eq 'HASH';
        my $conn = _conn_watching($snap->{channel}, $snap->{box}) or next;
        my ($messages, $uidnext) = _status_watching($conn, $snap->{box});
        next unless defined $messages && defined $uidnext;
        my ($sync, $chase) = count_follow_decision($snap, $messages, $uidnext);
        _store_watch_counts($conn, $snap->{box}, $messages, $uidnext, $chase);
        my $word = $sync ? 'again' : '';
        if (!$word && $snap->{chase} && defined $snap->{uidnext} && $uidnext > $snap->{uidnext}
            && !(defined $snap->{messages} && $messages > $snap->{messages})) {
            $word = 'steady';
        }
        log_info(_log_name($snap->{channel}) . ': ' . sprintf('%-5s %s status %d uidnext %d',
            $word, $snap->{box}, $messages, $uidnext)) if $word;
        next unless $sync;
        note_mail_event(
            $snap->{channel}, $snap->{box},
            gap_for_folder($conn, $snap->{box}),
            $conn->{wait} // 0,
        );
    }
}

# Updates the remembered remote total. Returns 1 when this line should
# schedule mbsync. $hyper makes a live removal schedule as well.
sub idle_sync_decision {
    my ($conn, $line, $hyper) = @_;
    return 0 unless $conn && defined $line && $line ne '';
    if ($line =~ /^\*\s+(\d+)\s+EXISTS\b/i) {
        my $n = $1 + 0;
        if ($conn->{messages_lost} || !defined $conn->{messages}) {
            my $sync = $conn->{messages_lost} ? 1 : 0;
            $conn->{messages} = $n;
            $conn->{messages_lost} = 0;
            return $sync;
        }
        my $prev = $conn->{messages} + 0;
        $conn->{messages} = $n;
        return 1 if $n > $prev;
        return 1 if $hyper && $n < $prev;
        return 0;
    }
    if ($line =~ /^\*\s+\d+\s+EXPUNGE\b/i) {
        if (defined $conn->{messages} && $conn->{messages} > 0) {
            $conn->{messages}--;
        }
        return $hyper ? 1 : 0;
    }
    if ($line =~ /^\*\s+VANISHED\b/i) {
        if ($line !~ /\(EARLIER\)/i) {
            my $set;
            $set = $1 if $line =~ /^\*\s+VANISHED\s+(\S+)\s*$/i;
            my $n = vanished_count($set);
            if (!defined $n) {
                $conn->{messages_lost} = 1;
                delete $conn->{messages};
            } elsif (defined $conn->{messages}) {
                $conn->{messages} -= $n;
                $conn->{messages} = 0 if $conn->{messages} < 0;
            }
        }
        return $hyper && $line !~ /\(EARLIER\)/i ? 1 : 0;
    }
    return 1 if $line =~ /^\*\s+STATUS\b/i && mail_event_line($line);
    return 0;
}

sub _idle_mail_lines {
    my ($conn, @lines) = @_;
    if (($conn->{mode} // '') ne 'IDLE') {
        return grep { mail_event_line($_) } @lines;
    }
    my $hyper = $conn->{hyperdelete} ? 1 : 0;
    if (!$hyper) {
        my $acc = $accounts{ $conn->{name} // '' };
        $hyper = 1 if $acc && $acc->{hyperdelete};
    }
    my @hit;
    for my $line (@lines) {
        push @hit, $line if idle_sync_decision($conn, $line, $hyper);
    }
    return @hit;
}

sub mailbox_from_line {
    my ($line) = @_;
    return $1 if $line =~ /STATUS\s+"((?:\\.|[^"\\])*)"/i;
    return $1 if $line =~ /STATUS\s+(\S+)/i;
    return;
}

sub folders_for_lines {
    my ($conn, @lines) = @_;
    my %seen;
    if (($conn->{mode} // '') eq 'IDLE' && defined $conn->{folder} && $conn->{folder} ne '') {
        $seen{ $conn->{folder} } = 1 if @lines;
        return sort keys %seen;
    }
    my $named_any = 0;
    for my $line (@lines) {
        my $named = mailbox_from_line($line);
        next unless defined $named && $named ne '';
        $named_any = 1;
        for my $f (@{ $conn->{folders} // [] }) {
            $seen{ $f->{name} } = 1 if $f->{name} eq $named;
        }
    }
    if (!$named_any) {
        $seen{ $_->{name} } = 1 for @{ $conn->{folders} // [] };
    }
    return sort keys %seen;
}

sub gap_for_folder {
    my ($conn, $folder) = @_;
    for my $f (@{ $conn->{folders} // [] }) {
        return $f->{debounce} if $f->{name} eq $folder;
    }
    return $conn->{debounce} // calculate_debounce(5);
}

sub process_notification {
    my ($conn) = @_;
    die "missing IMAP session\n" unless $conn && $conn->{imap};

    my $ok = eval {
        my @lines;
        my $spins = 0;
        my $local = $conn->{messages};
        while ($spins++ < 100) {
            my @data = $conn->{imap}->idle_data(0);
            if (@data == 1 && !defined $data[0]) {
                die(($conn->{imap}->LastError // 'idle_data failed') . "\n");
            }
            @data = grep { defined && $_ ne '' } @data;
            last unless @data;
            for my $line (@data) {
                chomp $line;
                next if $line eq '';
                push @lines, $line;
                trace_imap_line($conn->{name}, $line, $conn->{folder}, $local);
                $local = $1 + 0 if $line =~ /^\*\s+(\d+)\s+EXISTS\b/i;
            }
        }
        my @mail_lines = _idle_mail_lines($conn, @lines);
        if (@mail_lines) {
            for my $folder (folders_for_lines($conn, @mail_lines)) {
                note_mail_event(
                    $conn->{channel}, $folder,
                    gap_for_folder($conn, $folder),
                    $conn->{wait} // 0,
                );
            }
        }
        1;
    };
    if (!$ok) {
        drop_conn($conn->{key}, scrub($@));
        return;
    }
    # idle_data leaves the server in IDLE. Housekeeping sends DONE/IDLE.
}

sub handle_ready {
    my ($sock) = @_;
    my $key  = $sock_to_key{$sock};
    my $conn = defined $key ? $conns{$key} : undef;
    unless ($conn && $conn->{imap}) {
        if (defined $key && exists $conns{$key}) {
            drop_conn($key, 'ready socket has no IMAP session');
        } else {
            drop_socket($sock);
            log_warn('dropping ready socket with no session');
        }
        return;
    }
    process_notification($conn);
}

sub _queue_mail_lines {
    my ($conn, @lines) = @_;
    return unless $conn;
    my @mail = _idle_mail_lines($conn, @lines);
    return unless @mail;
    for my $folder (folders_for_lines($conn, @mail)) {
        note_mail_event(
            $conn->{channel}, $folder,
            gap_for_folder($conn, $folder),
            $conn->{wait} // 0,
        );
    }
}

sub _issue_due {
    my ($conn, $now) = @_;
    my $acc = $accounts{ $conn->{name} } or return;
    $now //= time();
    consider_id($conn->{imap}, $acc->{server}, $acc->{port}, $now);
    consider_capability($conn->{name}, $conn->{imap}, $acc->{server}, $acc->{port}, $acc->{folders}, $now);
    consider_list($conn->{name}, $acc, $conn->{imap}, $now);
}

sub refresh_primary {
    my ($conn, $now) = @_;
    return 0 unless $conn && $conn->{primary} && $conn->{imap};
    $now //= time();
    my $ok = eval {
        if (($conn->{mode} // '') eq 'IDLE') {
            my ($left, @done) = _leave_idle($conn);
            _queue_mail_lines($conn, @done);
            die($conn->{imap}->LastError // 'not connected') unless $left;
            _issue_due($conn, $now);
            die($conn->{imap}->LastError // 'not connected')
                unless imap_connected($conn->{imap});
            my $tag = $conn->{imap}->idle() or die($conn->{imap}->LastError // 'IDLE failed');
            _note_idle($conn, $tag);
            note_idle_rearmed($conn->{name});
        } else {
            _issue_due($conn, $now);
        }
        1;
    };
    if (!$ok) {
        log_warn("$conn->{name}: primary refresh failed: " . scrub($@));
        return 0;
    }
    return 1;
}

sub housekeeping {
    my $now = time();
    return if $shutdown_reason || _shutdown_wanted();
    for my $key (keys %conns) {
        my $conn = $conns{$key} or next;
        my $dead = 0;
        my $mode = $conn->{mode} // '';
        my $ok = eval {
            $dead = 1 if !$conn->{imap} || !$conn->{imap}->IsConnected;
            # IDLE forbids any command except DONE. NOOP would break the session.
            if (!$dead && $mode eq 'POLL') {
                _poll_conn($conn, $now) if ($conn->{poll_next} // 0) <= $now;
                $dead = 1 unless exists $conns{$key};
            } elsif (!$dead && $mode ne 'IDLE') {
                $conn->{imap}->noop or $dead = 1;
            }
            1;
        };
        $dead = 1 if !$ok;
        if ($dead) {
            drop_conn($key, scrub($@) || 'connection lost');
            next;
        }
        if ($now - ($conn->{last_success} // 0) > 300) {
            $accounts{ $conn->{name} }{backoff} = 5 if $accounts{ $conn->{name} };
            $conn->{last_success} = $now;
        }
        my $acc = $accounts{ $conn->{name} };
        if ($conn->{primary} && $conn->{imap} && $acc && probes_due($acc, $now)) {
            drop_conn($key, 'primary refresh failed') unless refresh_primary($conn, $now);
            next;
        }
        if (($conn->{mode} // '') eq 'IDLE'
            && $now - ($conn->{last_idle} // 0) >= 30) {
            next if restart_idle($conn);
            my $why = delete $conn->{drop_why};
            $why = 'idle refresh failed' if !defined $why || $why eq '';
            drop_conn($key, $why);
        }
    }

    return if $shutdown_reason;
    for my $name (keys %accounts) {
        lift_account_disable($name, $now);
        next if $accounts{$name}{disabled};
        next if account_covered($name);
        next if ($accounts{$name}{next_try} // 0) > $now;
        eval { connect_account($name) };
        if (my $err = $@) {
            next if conn_limit_stop($err);
            log_error("$name: reconnect: " . scrub($err));
            if (auth_failure_error($err)) {
                note_auth_failure($name);
            } else {
                _clear_auth_streak($name);
                mark_retry($name);
            }
        }
    }
}

sub loop_timeout {
    my $now  = time();
    my $wait = 30;
    for my $name (keys %accounts) {
        my $acc = $accounts{$name};
        if ($acc->{disabled}) {
            my $due = $acc->{next_try} // 0;
            next unless $due > $now;
            my $d = $due - $now;
            $wait = $d if $d < $wait;
            next;
        }
        next if account_covered($name);
        if ($IMSG_SCHED) {
            # The worker is the login. An unset next_try is not a
            # connect that this process should spin on.
            my $due = $acc->{next_try} // 0;
            if ($due > $now) {
                my $d = $due - $now;
                $wait = $d if $d < $wait;
            }
            next;
        }
        # A learned cap must not busy-poll. The week stays out of
        # next_try so a dropped session can be replaced up to the cap.
        # A real backoff and a nearer probe wait for the later one.
        if (conn_limit_blocked($acc, $now)) {
            my $defer = _conn_limit_wait($acc, $now);
            my $due = $acc->{next_try} // 0;
            my $retry = $due > $now ? ($due - $now) : 0;
            my $d = $defer > $retry ? $defer : $retry;
            $wait = $d if $d < $wait;
            next;
        }
        my $due = $acc->{next_try} // $now;
        my $d   = $due - $now;
        $d = 0 if $d < 0;
        $wait = $d if $d < $wait;
    }
    my $sched = next_schedule_delay($now);
    $wait = $sched if defined $sched && $sched < $wait;
    my $resync_wait = next_resync_delay($now);
    $wait = $resync_wait if defined $resync_wait && $resync_wait < $wait;
    my $track_wait = next_track_delay($now);
    $wait = $track_wait if defined $track_wait && $track_wait < $wait;
    my $poll_wait = next_poll_delay($now);
    $wait = $poll_wait if defined $poll_wait && $poll_wait < $wait;
    # Pause holds the pumps that would clear a due folder. A 0 here
    # busy-polls until that file is removed.
    $wait = 1 if operations_paused() && $wait < 1;
    return $wait;
}

sub next_track_delay {
    my ($now) = @_;
    $now //= time();
    my $wait;
    # An overdue folder that cannot start must not make the select
    # timeout 0. No free slot, or the channel is already syncing.
    # A child exit wakes the sleep.
    unless ($track_cfg->{disabled}) {
        my $cold_open = slots_for_cold($now) > 0;
        for my $id (keys %track) {
            my $rec = $track{$id} or next;
            my ($claim_ch) = split /\0/, $id, 2;
            next unless channel_claimed($claim_ch);
            my $status_only = _pulse_status_only($rec, $now);
            my $future_status = 0;
            if ($rec->{pulse} && !_row_wants_pulse_mbsync($rec, $now)
                && ($rec->{next} // 0) > $now) {
                $future_status = 1;
            }
            next if !$cold_open && !$status_only && !$future_status;
            my $d = _track_when($rec) - $now;
            if ($d <= 0) {
                my ($ch, $box) = split /\0/, $id, 2;
                next if !defined $ch || !defined $box || $box eq '';
                if ($status_only) {
                    # No primary yet: wait for the connect, do not spin.
                    my $primary = _primary_for_channel($ch);
                    next unless _probe_ready($primary);
                } else {
                    next if tracked_deferred($ch, $box, $now);
                    # The primary is still listed but cannot take STATUS.
                    # Asking it again is what pegged the CPU.
                    my $primary = _primary_for_channel($ch);
                    next if _needs_probe($id, $now) && !_probe_ready($primary);
                }
            }
            $d = 0 if $d < 0;
            $wait = $d if !defined $wait || $d < $wait;
        }
    }
    for my $ch (keys %list_next) {
        my $d = ($list_next{$ch} // 0) - $now;
        # Already due: housekeeping lists on the next wake. A 0 here
        # busy-polls until that list lands.
        next if $d <= 0;
        $wait = $d if !defined $wait || $d < $wait;
    }
    my %rows = load_learned();
    for my $row (values %rows) {
        for my $k (qw(id_next cap_next)) {
            my $when = $row->{$k};
            next unless defined $when && $when =~ /^\d+(?:\.\d+)?\z/;
            my $d = $when - $now;
            next if $d <= 0;
            $wait = $d if !defined $wait || $d < $wait;
        }
    }
    return $wait;
}

my $RELOAD_REQUESTED = 0;

sub request_reload { $RELOAD_REQUESTED = 1 }

sub _session_key {
    my ($acc) = @_;
    return join("\0",
        $acc->{server}         // '',
        $acc->{port}           // '',
        $acc->{proto}          // 'tls',
        $acc->{user}           // '',
        $acc->{pass}           // '',
        $acc->{pass_cmd}       // '',
        $acc->{auth}           // 'login',
        $acc->{mbsync_channel} // '',
        $acc->{role}           // 'idle',
    );
}

sub _folder_key {
    my ($acc) = @_;
    return join("\n", map { $_->{name} . "\t" . $_->{priority} } @{ $acc->{folders} });
}

sub _drop_account_conns {
    my ($name, $why) = @_;
    for my $key (grep { index($_, "$name:") == 0 } keys %conns) {
        drop_conn($key, $why, 1);
    }
}

sub _forget_account_schedule {
    my ($acc) = @_;
    return unless $acc;
    forget_folder_schedule($acc->{mbsync_channel}, $_->{name}) for @{ $acc->{folders} };
}

sub _retarget_conns {
    my ($name, $old, $new) = @_;
    my %newf = map { $_->{name} => $_ } @{ $new->{folders} };
    my $notify = $conns{"$name:NOTIFY"};
    if ($notify) {
        $notify->{folders} = $new->{folders};
        $notify->{wait}    = $new->{wait};
        $notify->{channel} = $new->{mbsync_channel};
    }
    my $poll = $conns{"$name:POLL"};
    if ($poll) {
        $poll->{folders} = $new->{folders};
        $poll->{wait}    = $new->{wait};
        $poll->{channel} = $new->{mbsync_channel};
    }
    for my $oldf (@{ $old->{folders} }) {
        my $fname = $oldf->{name};
        my $key   = "$name:$fname";
        unless ($newf{$fname}) {
            drop_conn($key, 'folder removed', 1) if exists $conns{$key};
            forget_folder_schedule($old->{mbsync_channel}, $fname);
            next;
        }
        my $conn = $conns{$key} or next;
        $conn->{debounce} = $newf{$fname}{debounce};
        $conn->{wait}     = $new->{wait};
        $conn->{channel}  = $new->{mbsync_channel};
        my $id = _box_id($new->{mbsync_channel}, $fname);
        $box_gap{$id}  = $newf{$fname}{debounce} if exists $box_gap{$id};
        $box_wait{$id} = $new->{wait}            if exists $box_wait{$id};
    }
}

# Re-read the config. A bad file leaves the running accounts in place.
# Returns '' on success, or the error string.
sub reload_config_now {
    my ($file) = @_;
    $file //= $CONFIG_FILE;
    if (!defined $file || $file eq '') {
        log_error('reload kept the previous config: no config file');
        return 'no config file';
    }
    my ($fresh, $err, $off, $track, $srv) = parse_config_file($file);
    if ($err || !$fresh) {
        $err //= 'empty config';
        log_error("reload kept the previous config: $err");
        return $err;
    }

    for my $name (sort keys %accounts) {
        next if $fresh->{$name};
        my $old = $accounts{$name};
        _drop_account_conns($name, 'account removed');
        _forget_account_schedule($old);
        delete $accounts{$name};
        log_info("$name: removed");
    }

    for my $name (sort keys %$fresh) {
        my $new = $fresh->{$name};
        my $old = $accounts{$name};
        if (!$old) {
            $accounts{$name} = $new;
            log_info($new->{config_disabled} ? "$name: disabled" : "$name: added");
            next;
        }
        if ($new->{config_disabled}) {
            unless ($old->{config_disabled}) {
                _drop_account_conns($name, 'disabled');
                _forget_account_schedule($old);
                log_info("$name: disabled");
            }
            $accounts{$name} = $new;
            next;
        }
        if ($old->{config_disabled}) {
            $accounts{$name} = $new;
            log_info("$name: enabled");
            next;
        }
        if (_session_key($old) ne _session_key($new)) {
            _drop_account_conns($name, 'config changed');
            _forget_account_schedule($old);
            $accounts{$name} = $new;
            log_info("$name: reconnecting");
            next;
        }
        $new->{backoff}     = $old->{backoff}     // 5;
        $new->{next_try}    = $old->{next_try}    // 0;
        $new->{fails}       = $old->{fails}       // 0;
        $new->{auth_fails}  = $old->{auth_fails}  // 0;
        $new->{up}          = $old->{up}          // 0;
        $new->{disable_for} = $old->{disable_for} if defined $old->{disable_for};
        $new->{secret_wait} = $old->{secret_wait} if defined $old->{secret_wait};
        $new->{secret_said} = $old->{secret_said} if defined $old->{secret_said};
        if ($old->{disabled}) {
            $new->{disabled}   = 0;
            $new->{fails}      = 0;
            $new->{auth_fails} = 0;
            $new->{backoff}    = 5;
            $new->{next_try}   = 0;
            delete $new->{disable_for};
            log_info("$name: enabled");
        }
        my $folders_changed = _folder_key($old) ne _folder_key($new);
        $accounts{$name} = $new;
        _retarget_conns($name, $old, $new);
        if ($folders_changed) {
            my %had = map { $_->{name} => 1 } @{ $old->{folders} };
            my $added = grep { !$had{ $_->{name} } } @{ $new->{folders} };
            $new->{next_try} = 0 if $added && !$conns{"$name:NOTIFY"};
            log_info("$name: folders updated");
        }
    }
    install_servers($srv);
    install_pulse($off, 1);
    install_track($track, 1);
    _request_list_refresh();
    log_info('config reloaded');
    log_state_keep_verbose();
    return '';
}

sub apply_reload {
    return unless $RELOAD_REQUESTED;
    $RELOAD_REQUESTED = 0;
    reload_config_now();
}

sub _signal_number {
    my ($want) = @_;
    my @name = split / /, $Config{sig_name};
    my @num  = split / /, $Config{sig_num};
    for my $i (0 .. $#name) {
        return 0 + $num[$i] if $name[$i] eq $want;
    }
    return;
}

# Wake the loop. The report itself runs outside this handler.
sub _poke_info {
    return unless defined $INFO_W;
    syswrite($INFO_W, 'x');
}

sub install_info_signal {
    pipe($INFO_R, $INFO_W) or die "info pipe: $!";
    cloexec($INFO_R);
    cloexec($INFO_W);
    for my $fh ($INFO_R, $INFO_W) {
        my $flags = fcntl($fh, F_GETFL, 0);
        fcntl($fh, F_SETFL, ($flags // 0) | O_NONBLOCK) if defined $flags;
    }
    $select->add($INFO_R);
    my $sig = _signal_number('INFO');
    die "SIGINFO is not available\n" unless defined $sig;
    my $sa = POSIX::SigAction->new(\&_poke_info, POSIX::SigSet->new(), SA_RESTART);
    POSIX::sigaction($sig, $sa) or die "sigaction INFO: $!";
    hold_wake_signals();
}

sub _drain_fd {
    my ($fh) = @_;
    return unless defined $fh;
    while (1) {
        my $n = sysread($fh, my $buf, 64);
        last if !defined $n || $n == 0;
    }
}

sub _drain_info { _drain_fd($INFO_R); }

sub _poke_chld {
    return unless defined $CHLD_W;
    syswrite($CHLD_W, 'x');
}

# A finished mbsync starts its sweep clock at exit, so the loop wakes
# instead of waiting out the select timeout to reap.
sub install_chld_signal {
    pipe($CHLD_R, $CHLD_W) or die "chld pipe: $!";
    cloexec($CHLD_R);
    cloexec($CHLD_W);
    for my $fh ($CHLD_R, $CHLD_W) {
        my $flags = fcntl($fh, F_GETFL, 0);
        fcntl($fh, F_SETFL, ($flags // 0) | O_NONBLOCK) if defined $flags;
    }
    $select->add($CHLD_R);
    my $sig = _signal_number('CHLD');
    die "SIGCHLD is not available\n" unless defined $sig;
    my $sa = POSIX::SigAction->new(\&_poke_chld, POSIX::SigSet->new(), SA_RESTART);
    POSIX::sigaction($sig, $sa) or die "sigaction CHLD: $!";
    hold_wake_signals();
}

sub info_lines {
    my $now = int($_[0] // time());
    my @kids = sort { $a <=> $b } keys %children;
    my @lines = (
        sprintf('imapidle: info %d accounts %d connections %d mbsync %d',
            $$, scalar keys %accounts, scalar keys %conns, scalar @kids),
    );
    for my $name (sort keys %accounts) {
        my $acc = $accounts{$name};
        if ($acc->{config_disabled} && $acc->{disabled}) {
            my $line = "$name: disabled";
            $line .= " server $acc->{server}" if ($acc->{server} // '') ne '';
            $line .= " channel $acc->{mbsync_channel}"
                if ($acc->{mbsync_channel} // '') ne '';
            $line .= ' auth xoauth2' if ($acc->{auth} // '') eq 'xoauth2';
            push @lines, $line;
            next;
        }
        my $role = $acc->{role} // '';
        if ($role eq 'account' || $role eq 'pulse') {
            my $mode = $role;
            if ($role eq 'pulse') {
                $mode = $conns{"$name:PULSE"} ? 'pulse'
                    : ($acc->{disabled} ? 'disabled' : 'down');
            }
            my $line = "$name: $mode server $acc->{server} channel $acc->{mbsync_channel}";
            $line .= ' auth xoauth2' if ($acc->{auth} // '') eq 'xoauth2';
            if ($mode eq 'down') {
                my $wait = int(($acc->{next_try} // 0) - $now);
                $wait = 0 if $wait < 0;
                $line .= " retry ${wait}s";
            } elsif ($acc->{disabled} && ($acc->{next_try} // 0) > $now) {
                my $wait = int($acc->{next_try} - $now);
                $line .= " back in ${wait}s";
            }
            push @lines, $line;
            next;
        }
        my @modes;
        push @modes, 'NOTIFY' if $conns{"$name:NOTIFY"};
        push @modes, 'POLL'   if $conns{"$name:POLL"};
        for my $folder (@{ $acc->{folders} }) {
            push @modes, 'IDLE ' . $folder->{name} if $conns{"$name:$folder->{name}"};
        }
        my $mode = @modes ? join(', ', @modes) : ($acc->{disabled} ? 'disabled' : 'down');
        $mode .= ' disabled' if $acc->{disabled} && @modes;
        my $line = "$name: $mode server $acc->{server} channel $acc->{mbsync_channel}";
        $line .= ' auth xoauth2' if ($acc->{auth} // '') eq 'xoauth2';
        if ($mode eq 'down') {
            my $wait = int(($acc->{next_try} // 0) - $now);
            $wait = 0 if $wait < 0;
            $line .= " retry ${wait}s";
        } elsif ($acc->{disabled} && ($acc->{next_try} // 0) > $now) {
            my $wait = int($acc->{next_try} - $now);
            $line .= " back in ${wait}s";
        }
        push @lines, $line;
        for my $folder (@{ $acc->{folders} }) {
            push @lines, _folder_info_line($name, $acc, $folder, $now);
        }
    }
    push @lines, _conn_limit_info_lines($now);
    push @lines, _track_info_lines($now);
    push @lines, _pulse_info_lines($now);
    for my $pid (@kids) {
        push @lines, child_state_line($pid, $children{$pid});
    }
    return @lines;
}

sub _track_info_lines {
    my ($now) = @_;
    return () unless $track_cfg && !$track_cfg->{disabled};
    my %by;
    for my $id (keys %track) {
        my ($ch, $box) = split /\0/, $id, 2;
        next if !defined $ch || !defined $box;
        next if $track{$id}{pulse};
        push @{ $by{$ch} }, { box => $box, rec => $track{$id} };
    }
    my @lines;
    for my $ch (sort keys %by) {
        my @boxes = sort {
            ($a->{rec}{next} // 0) <=> ($b->{rec}{next} // 0) || $a->{box} cmp $b->{box}
        } @{ $by{$ch} };
        my $n = @boxes;
        my $soon = $boxes[0];
        my $in = int(($soon->{rec}{next} // 0) - $now);
        $in = 0 if $in < 0;
        my $word = $n == 1 ? 'box' : 'boxes';
        push @lines, "$ch: track $n $word, next $soon->{box} in ${in}s";
        next unless $VERBOSE;
        for my $b (@boxes) {
            my $rec = $b->{rec};
            my $due = int(($rec->{next} // 0) - $now);
            $due = 0 if $due < 0;
            my $samples = scalar @{ $rec->{samples} // [] };
            my $interval = $rec->{interval} // 0;
            push @lines, "$ch: track $b->{box} interval ${interval}s samples $samples due ${due}s";
        }
    }
    return @lines;
}

sub _pulse_info_lines {
    my ($now) = @_;
    my @lines;
    for my $sec (@PULSE_SECTIONS) {
        my $name = $sec->{name} // 'pulse';
        if ($sec->{disabled}) {
            push @lines, "$name: pulse disabled";
            next;
        }
        my $sweep = $sec->{sweep} // 3600;
        my $nch = scalar @{ $sec->{channels} // [] };
        push @lines, "$name: pulse sweep ${sweep}s $nch";
        for my $acct (@{ $sec->{channels} // [] }) {
            my $acc = $accounts{$acct};
            my $ch = ($acc && ($acc->{mbsync_channel} // '') ne '')
                ? $acc->{mbsync_channel} : $acct;
            my @boxes;
            for my $id (keys %track) {
                my $rec = $track{$id} or next;
                next unless $rec->{pulse};
                my ($c, $box) = split /\0/, $id, 2;
                next if !defined $c || $c ne $ch || !defined $box;
                push @boxes, { box => $box, rec => $rec };
            }
            if (!@boxes) {
                push @lines, "$ch: pulse sweep ${sweep}s";
                next;
            }
            @boxes = sort {
                ($a->{rec}{next} // 0) <=> ($b->{rec}{next} // 0)
                    || $a->{box} cmp $b->{box}
            } @boxes;
            my $soon = $boxes[0];
            my $in = int(($soon->{rec}{next} // 0) - $now);
            $in = 0 if $in < 0;
            my $word = @boxes == 1 ? 'box' : 'boxes';
            push @lines, "$ch: pulse " . scalar(@boxes)
                . " $word, next $soon->{box} in ${in}s";
        }
    }
    return @lines;
}

sub _folder_info_line {
    my ($name, $acc, $folder, $now) = @_;
    my $channel = $acc->{mbsync_channel};
    my $id      = _box_id($channel, $folder->{name});
    my $resync  = $folder->{resync};
    $resync = default_resync() unless defined $resync && $resync >= 60;
    my $bits    = "priority $folder->{priority} gap $folder->{debounce}s resync ${resync}s";
    my $last    = $box_last_run{$id} // 0;
    if ($last) {
        my $ago = int($now - $last);
        $ago = 0 if $ago < 0;
        $bits .= " last ${ago}s ago";
    } else {
        $bits .= ' last never';
    }
    if ($box_pending{$id}) {
        my $gap = $box_gap{$id} // $folder->{debounce};
        if ($last && $now < $last + $gap) {
            my $in = int($last + $gap - $now);
            $in = 0 if $in < 0;
            $bits .= " pending ${in}s";
        } else {
            $bits .= ' pending ready';
        }
    }
    if (_in_batch($channel, $folder->{name})) {
        my $deadline = $batch{$channel}{deadline};
        if (defined $deadline) {
            my $in = int($deadline - $now);
            $in = 0 if $in < 0;
            $bits .= " combine ${in}s";
        }
    }
    return "$name: $folder->{name} $bits";
}

sub report_info {
    my ($now) = @_;
    emit_state($_) for info_lines($now);
}

sub _state_fp {
    my ($path) = @_;
    return '' if !defined $path || $path eq '';
    my @st = stat($path);
    return '' unless @st;
    # inode, size, mtime, ctime. A hand edit moves at least one.
    return join ':', @st[1, 7, 9, 10];
}

sub _state_mark {
    my ($path) = @_;
    return if !defined $path || $path eq '';
    $STATE_STAT{$path} = _state_fp($path);
}

sub _state_changed {
    my ($path) = @_;
    return 0 if !defined $path || $path eq '';
    return 0 unless exists $STATE_STAT{$path};
    return _state_fp($path) ne $STATE_STAT{$path};
}

sub _folder_paths {
    my @paths;
    return @paths unless defined $FOLDERS_DIR && -d $FOLDERS_DIR;
    opendir my $dh, $FOLDERS_DIR or return @paths;
    for my $name (readdir $dh) {
        next if $name eq '.' || $name eq '..';
        next if $name =~ m{[/\\]};
        push @paths, "$FOLDERS_DIR/$name";
    }
    closedir $dh;
    return sort @paths;
}

sub _folders_key {
    return '' unless defined $FOLDERS_DIR && $FOLDERS_DIR ne '';
    return 'folders:' . $FOLDERS_DIR;
}

sub _folders_fp {
    return '' if _folders_key() eq '';
    my @bits = (_state_fp($FOLDERS_DIR));
    for my $path (_folder_paths()) {
        push @bits, $path, _state_fp($path);
    }
    return join '|', @bits;
}

sub _mark_folders {
    my $key = _folders_key();
    return if $key eq '';
    $STATE_STAT{$key} = _folders_fp();
}

# A changed file replaces the memory table. Track keeps the fields
# the file does not store, on rows the file still names.
sub _reload_track {
    return unless defined $TRACK_FILE && exists $STATE_STAT{$TRACK_FILE};
    return unless _state_changed($TRACK_FILE);
    my %keep = %track;
    %track = ();
    %list_next = ();
    load_track_file();
    for my $id (keys %track) {
        my $old = $keep{$id} or next;
        for my $k (qw(samples fails pulse classified await_sync confirming seed messages sweep)) {
            next unless exists $old->{$k};
            next if exists $track{$id}{$k};
            $track{$id}{$k} = $old->{$k};
        }
    }
}

sub _reload_conn_limit {
    return unless defined $CONN_LIMIT_FILE && exists $STATE_STAT{$CONN_LIMIT_FILE};
    return unless _state_changed($CONN_LIMIT_FILE);
    %CONN_LIMIT = ();
    _conn_limit_load();
}

sub _reload_learned {
    return unless $LEARNED_LOADED && defined $LEARNED && exists $STATE_STAT{$LEARNED};
    return unless _state_changed($LEARNED);
    _learned_load_disk();
}

sub _reload_known {
    return unless $KNOWN_LOADED && defined $KNOWN_HOSTS && exists $STATE_STAT{$KNOWN_HOSTS};
    return unless _state_changed($KNOWN_HOSTS);
    _known_load_disk();
}

sub _reload_cert_warn {
    return unless $CERT_WARN_LOADED;
    my $path = _cert_warn_file() // '';
    return if $path eq '' || !exists $STATE_STAT{$path};
    return unless _state_changed($path);
    _cert_warn_load_disk();
}

sub _reload_pulse {
    return unless defined $PULSE_LAST_FILE && exists $STATE_STAT{$PULSE_LAST_FILE};
    return unless _state_changed($PULSE_LAST_FILE);
    _pulse_last_load();
}

sub _reload_stats {
    for my $pair (
        [ $MBSYNC_REAL_FILE, \%MBSYNC_REAL ],
        [ $CONN_TIME_FILE,   \%CONN_TIME ],
    ) {
        my ($path, $dest) = @$pair;
        next unless defined $path && exists $STATE_STAT{$path};
        next unless _state_changed($path);
        _stat_load($path, $dest);
        _state_mark($path);
    }
}

sub _reload_folders {
    my $key = _folders_key();
    return if $key eq '' || !exists $STATE_STAT{$key};
    return if ($STATE_STAT{$key} // '') eq _folders_fp();
    load_folder_files();
}

sub refresh_local_state {
    my ($now) = @_;
    $now //= time();
    return if $STATE_LOOK_AT && $now < $STATE_LOOK_AT + $STATE_LOOK_EVERY;
    $STATE_LOOK_AT = $now;
    _reload_learned();
    _reload_known();
    _reload_cert_warn();
    _reload_conn_limit();
    _reload_pulse();
    _reload_stats();
    _reload_track();
    _reload_folders();
}

sub one_iteration {
    refresh_local_state();
    _drain_fd($CHLD_R);
    reap_children();
    apply_reload();
    my $phase = shutdown_phase();
    if ($phase eq 'exit') {
        _close_for_shutdown();
        exit 0;
    }
    pump_schedule() unless $phase;
    my $wait = loop_timeout();
    # A due folder makes the timeout 0. During shutdown that busy-loops
    # while the only thing left is to notice a child exit.
    $wait = 1 if $phase eq 'wait' && (!defined $wait || $wait < 1);
    my @ready = _handles_ready($wait);
    # A HUP that arrived during select is delivered before this call.
    apply_reload();
    # Drain ready sockets before housekeeping sends DONE or NOOP.
    my $want_info = 0;
    for my $sock (@ready) {
        if (defined $CHLD_R && defined fileno($sock) && fileno($sock) == fileno($CHLD_R)) {
            _drain_fd($CHLD_R);
            reap_children();
            next;
        }
        if (defined $INFO_R && defined fileno($sock) && fileno($sock) == fileno($INFO_R)) {
            $want_info = 1;
            next;
        }
        eval { handle_ready($sock) };
        next unless $@;
        log_warn('socket handler: ' . scrub($@));
        my $key = $sock_to_key{$sock};
        if (defined $key && exists $conns{$key}) {
            drop_conn($key, 'handler error');
        } else {
            drop_socket($sock);
        }
    }
    if ($want_info) {
        _drain_info();
        report_info();
    }
    housekeeping();
    $phase = shutdown_phase();
    if ($phase eq 'exit') {
        _close_for_shutdown();
        exit 0;
    }
    pump_schedule() unless $phase;
}

# One line from the process that is leaving: "-> <pid>". The pid is the
# grandchild that remains. No colon, so the name column leaves it alone.
my $HANDOFF_SINK;

sub set_handoff_sink_for_test { $HANDOFF_SINK = $_[0]; }

sub _handoff_note {
    my ($level, $msg) = @_;
    if (defined $HANDOFF_SINK && $HANDOFF_SINK ne '') {
        open my $fh, '>>', $HANDOFF_SINK or _exit(1);
        print $fh "$$ $level $msg\n";
        close $fh;
        return;
    }
    log_info($msg)  if $level eq 'info';
    log_error($msg) if $level eq 'err';
}

sub _read_handoff {
    my ($fh) = @_;
    my $buf = '';
    while (length($buf) < 256) {
        my $n = sysread($fh, my $chunk, 256);
        if (!defined $n) {
            next if $! == EINTR;
            return (undef, 'fork failed');
        }
        last if $n == 0;
        $buf .= $chunk;
        last if index($buf, "\n") >= 0;
    }
    return ($1, '') if $buf =~ /^(\d+)\n/;
    return (undef, $1) if $buf =~ /^fail (.+)\n/;
    return (undef, 'fork failed');
}

sub _handoff_fail {
    my ($why) = @_;
    $why = 'fork failed' if !defined $why || $why eq '';
    _handoff_note('err', $why);
    _exit(1);
}

sub daemonize {
    chdir '/' or die "chdir /: $!\n";
    pipe(my $rd, my $wr) or _handoff_fail("fork failed: $!");
    my $mid = fork();
    _handoff_fail("fork failed: $!") if !defined $mid;
    if ($mid) {
        close $wr;
        my ($daemon, $why) = _read_handoff($rd);
        close $rd;
        while (waitpid($mid, 0) < 0) {
            next if $! == EINTR;
            last;
        }
        _handoff_fail($why) if !defined $daemon;
        _handoff_note('info', "-> $daemon");
        _exit(0);
    }
    close $rd;
    setsid() or do {
        syswrite($wr, "fail setsid failed: $!\n");
        close $wr;
        _exit(1);
    };
    my $pid = fork();
    if (!defined $pid) {
        syswrite($wr, "fail fork failed: $!\n");
        close $wr;
        _exit(1);
    }
    if ($pid) {
        syswrite($wr, "$pid\n");
        close $wr;
        _exit(0);
    }
    close $wr;
    umask 077;
    open STDIN,  '<', '/dev/null';
    open STDOUT, '>', '/dev/null';
    open STDERR, '>', '/dev/null';
    $FOREGROUND = 0;
}

# A dot inside a component is written twice, so the single dots stay
# the separators. INBOX.Sent is INBOX..Sent.
sub ctl_enc {
    my ($s) = @_;
    $s = '' unless defined $s;
    $s =~ s/\./../g;
    return $s;
}

sub ctl_match {
    my ($name, $query) = @_;
    return 1 if !defined $query || $query eq '' || $query eq 'all' || $query eq '-a';
    return 1 if $name eq $query;
    return 0 if length($name) <= length($query);
    return substr($name, 0, length($query)) eq $query
        && substr($name, length($query), 1) eq '.';
}

sub _ctl_put {
    my ($nodes, $name, $value) = @_;
    $value = '' unless defined $value;
    $value =~ s/[\r\n\t]/ /g;
    $nodes->{$name} = "$value";
}

sub ctl_nodes {
    my ($now) = @_;
    $now //= time();
    my %n;
    _ctl_put(\%n, 'version', $VERSION);
    _ctl_put(\%n, 'pid', $$);
    _ctl_put(\%n, 'verbose', $VERBOSE ? 1 : 0);
    _ctl_put(\%n, 'foreground', $FOREGROUND ? 1 : 0);
    _ctl_put(\%n, 'shutdown', _shutdown_wanted() ? 1 : 0);
    _ctl_put(\%n, 'pause', operations_paused() ? 1 : 0);
    _ctl_put(\%n, 'accounts', scalar keys %accounts);
    _ctl_put(\%n, 'connections', (scalar keys %conns) + $IMSG_CONNS);
    _ctl_put(\%n, 'mbsync', scalar keys %children);
    _ctl_put(\%n, 'hooks', scalar keys %hook_children);
    _ctl_put(\%n, 'sched.now', int($now));
    _ctl_put(\%n, 'sched.now_clock', _clock($now));
    _ctl_put(\%n, 'sched.pump_depth', $PUMP_DEPTH);
    _ctl_put(\%n, 'sched.hot_pump', $HOT_PUMP ? 1 : 0);
    _ctl_put(\%n, 'sched.slots_hot', $track_cfg ? slots_for_hot($now) : 0);
    _ctl_put(\%n, 'sched.slots_cold', $track_cfg ? slots_for_cold($now) : 0);
    my $loop_wait = $track_cfg ? eval { loop_timeout() } : undef;
    _ctl_put(\%n, 'sched.loop_wait', defined $loop_wait ? $loop_wait : '');
    _ctl_put(\%n, 'sched.batches', scalar keys %batch);
    my $pending_n = 0;
    $pending_n += $box_pending{$_} ? 1 : 0 for keys %box_pending;
    _ctl_put(\%n, 'sched.pending', $pending_n);
    if ($track_cfg) {
        _ctl_put(\%n, 'track.disabled', $track_cfg->{disabled} ? 1 : 0);
        _ctl_put(\%n, 'track.tunnel', $track_cfg->{tunnel} ? 1 : 0);
        _ctl_put(\%n, 'track.hook', ($track_cfg->{hook} // '') ne '' ? 1 : 0);
        for my $k (qw(connections min messages initial max list id capability empty confirm tunnel_timeout)) {
            _ctl_put(\%n, "track.$k", $track_cfg->{$k} // 0);
        }
    }
    for my $sname (sort keys %servers) {
        my $srv  = $servers{$sname} or next;
        my $base = 'server.' . ctl_enc($sname);
        _ctl_put(\%n, "$base.host", $srv->{host} // '');
        _ctl_put(\%n, "$base.port", $srv->{port} // 0);
        _ctl_put(\%n, "$base.proto", $srv->{proto} // 'tls');
    }
    for my $key (sort keys %CONN_LIMIT) {
        my ($server, $port, $user) = split /\0/, $key, 3;
        next unless defined $user && $user ne '';
        my $row = $CONN_LIMIT{$key} or next;
        my $base = 'limit.' . ctl_enc($server) . '.' . ctl_enc($port) . '.' . ctl_enc($user);
        _ctl_put(\%n, "$base.cap", $row->{cap} // 0);
        _ctl_put(\%n, "$base.probe", int($row->{probe} // 0));
        _ctl_put(\%n, "$base.server_max", $row->{server_max})
            if defined $row->{server_max};
    }
    for my $sec (@PULSE_SECTIONS) {
        my $label = $sec->{name} // 'pulse';
        my $base  = 'pulse.' . ctl_enc($label);
        _ctl_put(\%n, "$base.disabled", $sec->{disabled} ? 1 : 0);
        _ctl_put(\%n, "$base.sweep", $sec->{sweep} // 3600);
        _ctl_put(\%n, "$base.hook", ($sec->{hook} // '') ne '' ? 1 : 0);
        _ctl_put(\%n, "$base.channels", scalar @{ $sec->{channels} // [] });
        for my $acct (@{ $sec->{channels} // [] }) {
            my $acc = $accounts{$acct};
            my $ch = ($acc && ($acc->{mbsync_channel} // '') ne '')
                ? $acc->{mbsync_channel} : $acct;
            my $last = $PULSE_LAST{$ch};
            _ctl_put(\%n, "$base.channel." . ctl_enc($acct) . '.last',
                defined $last ? int($last) : 0);
        }
    }
    for my $name (sort keys %accounts) {
        my $acc  = $accounts{$name};
        my $base = 'account.' . ctl_enc($name);
        _ctl_put(\%n, "$base.server", $acc->{server});
        _ctl_put(\%n, "$base.port", $acc->{port});
        _ctl_put(\%n, "$base.proto", $acc->{proto} // 'tls');
        _ctl_put(\%n, "$base.user", $acc->{user});
        _ctl_put(\%n, "$base.channel", $acc->{mbsync_channel});
        _ctl_put(\%n, "$base.auth", $acc->{auth});
        _ctl_put(\%n, "$base.role", $acc->{role});
        _ctl_put(\%n, "$base.wait", $acc->{wait} // 0);
        _ctl_put(\%n, "$base.poll", defined $acc->{poll} ? $acc->{poll} : 60);
        _ctl_put(\%n, "$base.disabled", $acc->{disabled} ? 1 : 0);
        _ctl_put(\%n, "$base.next_try", int($acc->{next_try} // 0));
        if (($acc->{next_try} // 0) > 0) {
            _ctl_put(\%n, "$base.next_try_clock", _clock($acc->{next_try}));
        }
        _ctl_put(\%n, "$base.limit_blocked", conn_limit_blocked($acc, $now) ? 1 : 0);
        _ctl_put(\%n, "$base.fails", $acc->{fails} // 0);
        _ctl_put(\%n, "$base.auth_fails", $acc->{auth_fails} // 0);
        _ctl_put(\%n, "$base.pass_wait", int($acc->{secret_wait} // 0));
        _ctl_put(\%n, "$base.hook", ($acc->{hook} // '') ne '' ? 1 : 0);
        _ctl_put(\%n, "$base.hyperdelete", $acc->{hyperdelete} ? 1 : 0);
        _ctl_put(\%n, "$base.folders", scalar @{ $acc->{folders} // [] });
        _ctl_put(\%n, "$base.covered", account_covered($name) ? 1 : 0);
        for my $folder (@{ $acc->{folders} // [] }) {
            my $fb = "$base.folder." . ctl_enc($folder->{name});
            _ctl_put(\%n, "$fb.priority", $folder->{priority});
            _ctl_put(\%n, "$fb.debounce", $folder->{debounce});
            my $resync = $folder->{resync};
            $resync = default_resync() unless defined $resync && $resync >= 60;
            _ctl_put(\%n, "$fb.resync", $resync);
            my $sid  = _box_id($acc->{mbsync_channel} // '', $folder->{name});
            my $last = $box_last_run{$sid} // 0;
            _ctl_put(\%n, "$fb.last_sync", int($last));
            _ctl_put(\%n, "$fb.last_sync_clock", $last ? _clock($last) : '');
            my $due = $last ? $last + $resync : 0;
            _ctl_put(\%n, "$fb.next_sync", int($due));
            _ctl_put(\%n, "$fb.next_sync_clock", $due ? _clock($due) : '');
            my $late = $due && $now > $due ? int($now - $due) : 0;
            _ctl_put(\%n, "$fb.late", $late);
        }
    }
    for my $key (sort keys %conns) {
        my $conn = $conns{$key};
        my ($cname, $what) = split /:/, $key, 2;
        my $base = 'conn.' . ctl_enc($cname) . '.' . ctl_enc($what // '');
        _ctl_put(\%n, "$base.mode", $conn->{mode} // 'IDLE');
        _ctl_put(\%n, "$base.channel", $conn->{channel} // '');
        _ctl_put(\%n, "$base.idling", $conn->{idling} ? 1 : 0);
        _ctl_put(\%n, "$base.primary", $conn->{primary} ? 1 : 0);
        _ctl_put(\%n, "$base.poll_next", int($conn->{poll_next} // 0));
        _ctl_put(\%n, "$base.started", int($conn->{started} // 0));
        _ctl_put(\%n, "$base.last_success", int($conn->{last_success} // 0));
        _ctl_put(\%n, "$base.messages", $conn->{messages}) if defined $conn->{messages};
    }
    for my $id (sort keys %track) {
        my ($ch, $box) = split /\0/, $id, 2;
        next unless defined $box;
        my $rec  = $track{$id};
        my $base = 'track.box.' . ctl_enc($ch) . '.' . ctl_enc($box);
        _ctl_put(\%n, "$base.next", int($rec->{next} // 0));
        _ctl_put(\%n, "$base.interval", int($rec->{interval} // 0));
        _ctl_put(\%n, "$base.uidnext", defined $rec->{uidnext} ? $rec->{uidnext} : '');
        _ctl_put(\%n, "$base.confirm", int($rec->{confirm})) if defined $rec->{confirm};
        _ctl_put(\%n, "$base.samples", scalar @{ $rec->{samples} // [] });
        _ctl_put(\%n, "$base.fails", $rec->{fails} // 0);
        _ctl_put(\%n, "$base.pulse", 1) if $rec->{pulse};
    }
    for my $ch (sort keys %list_next) {
        _ctl_put(\%n, 'track.list.' . ctl_enc($ch), int($list_next{$ch}));
    }
    my %sched;
    $sched{$_} = 1 for keys %box_last_run;
    $sched{$_} = 1 for keys %box_gap;
    $sched{$_} = 1 for keys %box_pending;
    $sched{$_} = 1 for keys %box_wait;
    for my $id (sort keys %sched) {
        my ($ch, $box) = split /\0/, $id, 2;
        next unless defined $box;
        my $base = 'schedule.' . ctl_enc($ch) . '.folder.' . ctl_enc($box);
        _ctl_put(\%n, "$base.last", int($box_last_run{$id})) if $box_last_run{$id};
        _ctl_put(\%n, "$base.last_clock", _clock($box_last_run{$id})) if $box_last_run{$id};
        _ctl_put(\%n, "$base.gap", $box_gap{$id}) if defined $box_gap{$id};
        _ctl_put(\%n, "$base.pending", $box_pending{$id} ? 1 : 0) if $box_pending{$id};
        _ctl_put(\%n, "$base.wait", $box_wait{$id}) if defined $box_wait{$id};
    }
    for my $ch (sort keys %batch) {
        my $b    = $batch{$ch};
        my $base = 'schedule.' . ctl_enc($ch);
        _ctl_put(\%n, "$base.deadline", defined $b->{deadline} ? int($b->{deadline}) : 0);
        _ctl_put(\%n, "$base.deadline_clock", _clock($b->{deadline})) if defined $b->{deadline};
        if (defined $b->{deadline}) {
            my $late = $now > $b->{deadline} ? int($now - $b->{deadline}) : 0;
            _ctl_put(\%n, "$base.late", $late);
        }
        _ctl_put(\%n, "$base.busy", channel_busy($ch) ? 1 : 0);
        my $boxes = $b->{boxes};
        next unless ref $boxes eq 'HASH';
        for my $box (sort keys %$boxes) {
            _ctl_put(\%n, "$base.folder." . ctl_enc($box) . '.queued', 1);
        }
    }
    for my $pid (sort { $a <=> $b } keys %children) {
        my $rec  = $children{$pid};
        my $base = "mbsync.$pid";
        _ctl_put(\%n, "$base.args", join(' ', @{ $rec->{args} // [] }));
        _ctl_put(\%n, "$base.started", int($rec->{started} // 0));
        my $kind = ($rec->{pulse} // '') ne '' ? 'pulse'
            : ($rec->{track} // '') ne '' ? 'track' : 'hot';
        _ctl_put(\%n, "$base.kind", $kind);
    }
    for my $pid (sort { $a <=> $b } keys %hook_children) {
        my $rec = $hook_children{$pid};
        _ctl_put(\%n, "hook.$pid.label", (ref $rec eq 'HASH' ? $rec->{label} : '') // 'hook');
    }
    for my $key (sort keys %CONN_TIME) {
        my ($cname, $what) = split /\0/, $key, 2;
        next unless defined $what;
        my $row  = $CONN_TIME{$key};
        my $base = 'conn_time.' . ctl_enc($cname) . '.' . ctl_enc($what);
        _ctl_put(\%n, "$base.n", $row->{n} // 0);
        _ctl_put(\%n, "$base.total", sprintf('%.2f', $row->{total} // 0));
    }
    return \%n;
}

# Writes this process applies. shutdown=1 is the signal path: this
# process exits, and no file is left to hold the next start. pause=1
# is remembered here and OR'd with a pause file. pause=0 clears only
# this latch. resync is how long a watched folder may go since its
# last sync. hyperdelete is that account's removal flag. A connection
# cap and its next probe are the learned limit for one server, port,
# and user. next_try is when that account logs in again. Zero tries
# on the next loop and clears an authentication hold, including one
# the file asked for; a reload puts that hold back. disabled is the
# same pause, in memory only. The file is not rewritten. A write that
# is not applied here is refused.
sub ctl_parts {
    my ($s) = @_;
    my @parts;
    my $cur = '';
    my $i   = 0;
    my $len = length($s // '');
    while ($i < $len) {
        if (substr($s, $i, 2) eq '..') {
            $cur .= '.';
            $i += 2;
        } elsif (substr($s, $i, 1) eq '.') {
            push @parts, $cur;
            $cur = '';
            $i++;
        } else {
            $cur .= substr($s, $i, 1);
            $i++;
        }
    }
    push @parts, $cur;
    return @parts;
}

sub ctl_set {
    my ($name, $value) = @_;
    if ($name eq 'shutdown') {
        return 'bad value' unless defined $value && $value eq '1';
        $SHUTDOWN = 'TERM' unless $SHUTDOWN;
        return;
    }
    if ($name eq 'pause') {
        return 'bad value' unless defined $value && ($value eq '0' || $value eq '1');
        $CTL_PAUSE = $value eq '1' ? 1 : 0;
        return;
    }
    my @part = ctl_parts($name);
    if (@part == 5 && $part[0] eq 'account' && $part[2] eq 'folder' && $part[4] eq 'resync') {
        return 'bad value' unless defined $value && $value =~ /^\d+$/ && $value >= 60;
        my $acc = $accounts{ $part[1] } or return "unknown oid $name";
        my $found;
        for my $folder (@{ $acc->{folders} // [] }) {
            next unless ($folder->{name} // '') eq $part[3];
            $folder->{resync} = $value + 0;
            $found = 1;
            last;
        }
        return "unknown oid $name" unless $found;
        return;
    }
    if (@part == 3 && $part[0] eq 'account' && $part[2] eq 'hyperdelete') {
        return 'bad value' unless defined $value && ($value eq '0' || $value eq '1');
        my $acc = $accounts{ $part[1] } or return "unknown oid $name";
        $acc->{hyperdelete} = $value eq '1' ? 1 : 0;
        return;
    }
    if (@part == 3 && $part[0] eq 'account' && $part[2] eq 'next_try') {
        return 'bad value' unless defined $value && $value =~ /^\d+$/;
        my $acc = $accounts{ $part[1] } or return "unknown oid $name";
        $acc->{next_try}   = $value + 0;
        $acc->{backoff}    = 5;
        $acc->{auth_fails} = 0;
        if ($value + 0 <= time()) {
            $acc->{disabled} = 0;
            delete $acc->{disable_for};
        }
        return;
    }
    if (@part == 3 && $part[0] eq 'account' && $part[2] eq 'disabled') {
        return 'bad value' unless defined $value && ($value eq '0' || $value eq '1');
        my $acct = $part[1];
        my $acc = $accounts{$acct} or return "unknown oid $name";
        if ($value eq '1') {
            $acc->{disabled} = 1;
            _drop_account_conns($acct, 'disabled');
            return;
        }
        $acc->{disabled}    = 0;
        $acc->{next_try}    = 0;
        $acc->{backoff}     = 5;
        $acc->{fails}       = 0;
        delete $acc->{disable_for};
        return;
    }
    if (@part == 5 && $part[0] eq 'limit'
        && ($part[4] eq 'cap' || $part[4] eq 'probe')) {
        return 'bad value' unless defined $part[2] && $part[2] =~ /^\d+$/;
        return 'bad value' unless defined $value && $value =~ /^\d+$/;
        return 'unknown oid ' . $name if $part[1] eq '' || $part[3] eq '';
        my $key = join("\0", $part[1], $part[2] + 0, $part[3]);
        my $row = $CONN_LIMIT{$key} or return "unknown oid $name";
        $row->{$part[4]} = $value + 0;
        _conn_limit_save();
        return;
    }
    return 'read-only';
}

sub ctl_reply {
    my ($line) = @_;
    $line //= '';
    $line =~ s/\r?\n\z//;
    $line =~ s/^\s+|\s+$//g;
    my $query = $line;
    if ($line =~ /^([^=]+)=(.*)$/) {
        $query = $1;
        $query =~ s/\s+\z//;
        my $err = ctl_set($query, $2);
        return "error $err\n" if $err;
        my $nodes = ctl_nodes();
        return "error unknown oid $query\n" unless exists $nodes->{$query};
        return "$query=$nodes->{$query}\n";
    }
    my $nodes = ctl_nodes();
    my @names = sort grep { ctl_match($_, $query) } keys %$nodes;
    return "error unknown oid $query\n" unless @names;
    return join('', map { "$_=$nodes->{$_}\n" } @names);
}

sub ctl_socket_path {
    return $CTL_PATH if defined $CTL_PATH && $CTL_PATH ne '';
    return unless defined $ENV{HOME} && $ENV{HOME} ne '';
    return "$ENV{HOME}/var/run/imapidle.sock";
}


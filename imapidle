sub _ctl_is {
    my ($fh) = @_;
    return 0 unless defined $fh && defined fileno($fh);
    my $fd = fileno($fh);
    return 1 if $CTL_LISTEN && defined fileno($CTL_LISTEN) && $fd == fileno($CTL_LISTEN);
    return 1 if $CTL_CLIENT{$fd};
    return 0;
}

sub _ctl_note {
    if ($CTL_LISTEN && defined fileno($CTL_LISTEN)) {
        vec($_[0], fileno($CTL_LISTEN), 1) = 1;
    }
    for my $c (values %CTL_CLIENT) {
        next unless $c->{fh};
        my $fd = fileno($c->{fh});
        next unless defined $fd;
        vec($_[0], $fd, 1) = 1;
        vec($_[1], $fd, 1) = 1 if length($c->{out} // '');
    }
}

sub ctl_drop {
    my ($c) = @_;
    return unless $c && $c->{fh};
    my $fd = fileno($c->{fh});
    $select->remove($c->{fh});
    delete $CTL_CLIENT{$fd} if defined $fd;
    close $c->{fh};
    $c->{fh}  = undef;
    $c->{out} = '';
}

sub ctl_flush {
    my ($c) = @_;
    return unless $c && $c->{fh} && length($c->{out} // '');
    while (length $c->{out}) {
        my $n = syswrite($c->{fh}, $c->{out});
        if (!defined $n) {
            return if $! == EAGAIN || $! == EWOULDBLOCK;
            ctl_drop($c);
            return;
        }
        last if $n == 0;
        substr($c->{out}, 0, $n, '');
    }
    ctl_drop($c) if $c->{fh} && !length($c->{out} // '');
}

sub ctl_read {
    my ($c) = @_;
    return unless $c && $c->{fh};
    my $n = sysread($c->{fh}, my $buf, 1024);
    if (!defined $n) {
        return if $! == EAGAIN || $! == EWOULDBLOCK;
        ctl_drop($c);
        return;
    }
    if ($n == 0) {
        ctl_drop($c) unless length($c->{out} // '');
        return;
    }
    $c->{in} .= $buf;
    if (length($c->{in}) > 1024 && index($c->{in}, "\n") < 0) {
        $c->{out} = "error bad value\n";
        $c->{in}  = '';
        ctl_flush($c);
        return;
    }
    my $at = index($c->{in}, "\n");
    return if $at < 0;
    my $line = substr($c->{in}, 0, $at + 1);
    $c->{in}  = '';
    $c->{out} = ctl_reply($line);
    ctl_flush($c);
}

sub ctl_accept {
    return unless $CTL_LISTEN;
    while (1) {
        my $fh = $CTL_LISTEN->accept();
        last unless $fh;
        $fh->blocking(0);
        if (scalar(keys %CTL_CLIENT) >= 4) {
            syswrite($fh, "error busy\n");
            close $fh;
            next;
        }
        $select->add($fh);
        my $fd = fileno($fh);
        next unless defined $fd;
        $CTL_CLIENT{$fd} = { fh => $fh, in => '', out => '' };
    }
}

sub _ctl_dispatch {
    my ($rin, $win) = @_;
    if ($CTL_LISTEN && defined fileno($CTL_LISTEN) && vec($rin, fileno($CTL_LISTEN), 1)) {
        ctl_accept();
    }
    for my $id (keys %CTL_CLIENT) {
        my $c = $CTL_CLIENT{$id} or next;
        my $fd = fileno($c->{fh});
        next unless defined $fd;
        ctl_read($c) if vec($rin, $fd, 1);
        $c = $CTL_CLIENT{$id} or next;
        ctl_flush($c) if length($c->{out} // '') && $win && vec($win, $fd, 1);
    }
}

sub service_fds {
    my @fh;
    push @fh, $CTL_LISTEN if $CTL_LISTEN && defined fileno($CTL_LISTEN);
    for my $c (values %CTL_CLIENT) {
        push @fh, $c->{fh} if $c->{fh} && defined fileno($c->{fh});
    }
    push @fh, $CHLD_R if $CHLD_R && defined fileno($CHLD_R);
    push @fh, $INFO_R if $INFO_R && defined fileno($INFO_R);
    return @fh;
}

# CHLD and INFO stay blocked except inside this pselect. A Perl
# handler during malloc aborts the process on OpenBSD.
sub service_wait {
    my ($sel, $timeout) = @_;
    my @handles = $sel->handles;
    my $rin = '';
    for my $fh (@handles) {
        my $fd = fileno($fh);
        next unless defined $fd;
        vec($rin, $fd, 1) = 1;
    }
    my $win = '';
    my $ein = '';
    my $n = _pselect($rin, $win, $ein, $timeout);
    return if !defined $n || $n <= 0;
    my @ready;
    for my $fh (@handles) {
        my $fd = fileno($fh);
        next unless defined $fd && vec($rin, $fd, 1);
        push @ready, $fh;
    }
    return @ready;
}

sub service_ready {
    my ($fh) = @_;
    return 0 unless defined $fh && defined fileno($fh);
    my $fd = fileno($fh);
    if ($CHLD_R && defined fileno($CHLD_R) && $fd == fileno($CHLD_R)) {
        _drain_fd($CHLD_R);
        reap_children();
        return 1;
    }
    if ($INFO_R && defined fileno($INFO_R) && $fd == fileno($INFO_R)) {
        _drain_info();
        report_info();
        return 1;
    }
    if ($CTL_LISTEN && defined fileno($CTL_LISTEN) && $fd == fileno($CTL_LISTEN)) {
        ctl_accept();
        return 1;
    }
    if (my $c = $CTL_CLIENT{$fd}) {
        ctl_read($c);
        $c = $CTL_CLIENT{$fd} or return 1;
        ctl_flush($c) if length($c->{out} // '');
        return 1;
    }
    return 0;
}

sub ctl_listen {
    return if $DRY_RUN;
    my $path = ctl_socket_path();
    return unless defined $path && $path ne '';
    return if $CTL_LISTEN;
    my $dir = dirname($path);
    if ($dir ne '' && !-d $dir) {
        my $made = eval { make_path($dir, { mode => 0700 }); 1 };
        if (!$made || !-d $dir) {
            log_warn('ctl: directory not created');
            return;
        }
    }
    if (-e $path) {
        my $probe = IO::Socket::UNIX->new(Type => SOCK_STREAM, Peer => $path);
        if ($probe) {
            close $probe;
            log_warn('ctl socket in use');
            return;
        }
        unlink $path;
    }
    my $old = umask 0177;
    my $srv = IO::Socket::UNIX->new(
        Type   => SOCK_STREAM,
        Local  => $path,
        Listen => 4,
    );
    umask $old;
    unless ($srv) {
        log_warn("ctl listen: $!");
        return;
    }
    $srv->blocking(0);
    $CTL_LISTEN = $srv;
    $select->add($srv);
    log_info("ctl $path");
}

sub ctl_close {
    for my $id (keys %CTL_CLIENT) {
        ctl_drop($CTL_CLIENT{$id});
    }
    if ($CTL_LISTEN) {
        $select->remove($CTL_LISTEN);
        close $CTL_LISTEN;
        $CTL_LISTEN = undef;
    }
    my $path = ctl_socket_path();
    unlink $path if defined $path && $path ne '' && -S $path;
}

sub graceful_shutdown {
    my ($sig) = @_;
    request_shutdown($sig);
}

sub main_loop {
    ctl_listen();
    log_info('entering main loop (' . scalar(keys %conns) . ' connection(s))');
    my $failures = 0;
    while (1) {
        my $ok = eval { one_iteration(); 1 };
        if ($ok) {
            $failures = 0;
            next;
        }
        $failures++;
        log_error('loop error: ' . scrub($@));
        sleep 1;
        log_error("loop error persisted $failures times") if $failures == 10 || $failures % 100 == 0;
    }
}


# ================== CERTIFICATE TOFU ==================
sub load_known_hosts {
    my %known_fingerprints;
    return %known_fingerprints unless -f $KNOWN_HOSTS;
    open my $fh, '<', $KNOWN_HOSTS or return;
    while (<$fh>) {
        chomp;
        next if /^\s*#/ or /^\s*$/;
        my ($hostkey, $fp) = split /\s+/, $_, 2;
        $known_fingerprints{$hostkey} = $fp if $hostkey && $fp;
    }
    close $fh;
    return %known_fingerprints;
}

sub save_known_hosts {
    my %known_fingerprints = @_;
    open my $fh, '>', $KNOWN_HOSTS or do { log_error("Cannot write $KNOWN_HOSTS: $!"); return; };
    print $fh "# imap-idle-notify known_hosts (TOFU)\n# format: server:port\tSHA256:fingerprint\n\n";
    for my $k (sort keys %known_fingerprints) {
        print $fh "$k\t$known_fingerprints{$k}\n";
    }
    close $fh;
}

sub approve_fingerprint {
    my ($server, $port, $fingerprint) = @_;
    my $hostkey = "$server:$port";
    my %known = load_known_hosts();
    my $old = $known{$hostkey};
    return 1 if $old && $old eq $fingerprint;

    if (! -t STDIN) {
        log_error("Certificate unknown or changed for $hostkey — run interactively once to approve");
        return 0;
    }

    print STDERR "\n";
    if ($old) {
        print STDERR "WARNING: Certificate CHANGED for $hostkey!\n  Old: $old\n  New: $fingerprint\n\n";
    } else {
        print STDERR "New SSL certificate for $hostkey\nFingerprint: $fingerprint\n\n";
    }

    print STDERR "Accept this certificate? (y/N) ";
    my $ans = <STDIN>;
    chomp $ans;
    if ($ans =~ /^y/i) {
        $known{$hostkey} = $fingerprint;
        save_known_hosts(%known);
        log_info("Certificate accepted for $hostkey");
        return 1;
    }
    log_error("Certificate rejected for $hostkey");
    return 0;
}

# ================== CONFIG (multi-folder support) ==================
sub load_config {
    my $cfg = Config::Tiny->read($CONFIG_FILE)
        or die "Cannot read $CONFIG_FILE: " . Config::Tiny->errstr;

    %accounts = ();
    for my $section (keys %{$cfg}) {
        $cfg->{$section}->{port} //= 993;

        my @folders;
        my $i = 0;
        while (exists $cfg->{$section}{"folder$i"}) {
            my $val = $cfg->{$section}{"folder$i"};
            my ($name, $fvars) = split /;/, $val, 2;

           my $priority = 5; # default
           if (defined $fvars) {
               my ($v2,$v3)= split(/\s*=\s*/,$fvars,2);
               $priority = $v3 if $v2 && $v2 eq "priority" && defined $v3;
           }

           push @folders, {
               name    => $name,
               priority => $priority,
               debounce => calculate_debounce($priority)
           };

           $i++;
       }

       # backward compatibility with old single-folder config
        if (@folders == 0) {
            my $f = $cfg->{$section}->{folder} // 'INBOX';
            my $p = $cfg->{$section}->{priority} // 5;
            push @folders, { name => $f, priority => $p, debounce => calculate_debounce($p) };
        }

        die "[$section] missing server/user/password/mbsync_channel" unless
            defined $cfg->{$section}->{server} &&
            defined $cfg->{$section}->{user} &&
            defined $cfg->{$section}->{password} &&
            defined $cfg->{$section}->{mbsync_channel};

        $accounts{$section} = {
            server         => $cfg->{$section}->{server},
            port           => $cfg->{$section}->{port},
            user           => $cfg->{$section}->{user},
            password       => $cfg->{$section}->{password},
            mbsync_channel => $cfg->{$section}->{mbsync_channel},
            folders        => \@folders,
            wait           => $cfg->{$section}->{wait} // 0,
        };

        log_info("OK [$section] - mbsync://$cfg->{$section}->{mbsync_channel}?listen=" .
                 scalar(@folders));
    }
}
sub calculate_debounce {
    my $p = shift;
    return 8    if $p <= 2;
    return 3600 if $p >= 9;
    return 180 + ($p - 3) * 120;
}


# ================== CONNECTION HELPER (removes all duplication) ==================
sub create_imap_connection {
    my ($name, $acc, $folder) = @_;

    my $socket = IO::Socket::SSL->new(
        PeerAddr        => $acc->{server},
        PeerPort        => $acc->{port},
        SSL_verify_mode => SSL_VERIFY_NONE,
        SSL_hostname    => $acc->{server},
    ) or die "SSL socket: $! $@";


    my $fingerprint = $socket->get_fingerprint('SHA256');
    syslog(LOG_INFO, "[%s] -> SSL Connect %s port %s", $name, $acc->{server}, $acc->{port});
    syslog(LOG_INFO, "[%s] fingerprint %s", $name, $fingerprint);
    approve_fingerprint($acc->{server}, $acc->{port}, $fingerprint)
        or die "Certificate not approved";

    my $imap = Mail::IMAPClient->new(
        Socket   => $socket,
        User     => $acc->{user},
        Password => $acc->{password},
    ) or die "IMAP login: $@";

    $imap->select($folder) or die "SELECT $folder: " . $imap->LastError;

    return ($socket, $imap);
}

# ================== NOTIFY / IDLE SETUP ==================
sub setup_notification {
    my ($name, $imap, $folder_list) = @_;

    my @caps = $imap->capability or return (0, undef);
    my $has_notify = grep { uc($_) eq 'NOTIFY' } @caps;

    if (!$has_notify) {
        log_info("[$name] Server does not advertise NOTIFY -> using IDLE");
        return (0, undef);
    }

    my $server_id = detect_server_version($imap);
    log_info("[$name] Server identified as: $server_id");

    # Known broken implementation: Dovecot 2.2.x series
    #if ($server_id =~ /dovecot-2\.2\./) {
    #    log_info("[$name] Dovecot 2.2.x detected -> NOTIFY is broken, using stable IDLE mode");
    #    return (0, undef);
    #}

    my $folders_str = join ' ', map { $_->{name} } @$folder_list;
    my $cmd = "NOTIFY SET (personal (MessageNew MessageExpunge MessageFlags))";
    log_info("[$name] -> Trying NOTIFY: $cmd");

    log_info("[$name] -> NOTIFY command: $cmd");

    my @resp = $imap->tag_and_run($cmd);
    my $last = $resp[-1] // '';

    my $res = "";
    $res = join(" | ", @resp) if defined $resp[0];
    log_info("[$name] --> NOTIFY raw response: [" . $res . "]");
    log_info("[$name] --> LastError: " . ($imap->LastError || "none"));


    if ($last =~ /OK/i) {
        log_info("[$name] -> NOTIFY activated (single connection for all folders)");
        return (1, undef);
    }
    log_warn("[$name] -> NOTIFY rejected by server, falling back to IDLE");
    return (0, undef);
}

# ================== SERVER VERSION DETECTION ==================
sub detect_server_version {
    my ($imap) = @_;

    # Ask the server for identification (RFC 2971)
    my @resp = $imap->tag_and_run("ID NIL");
    return "unknown" unless @resp;

    my $line = join(" ", @resp);
    # Look for Dovecot version string
    if ($line =~ /dovecot/i) {
        if ($line =~ /dovecot.*?(\d+\.\d+)/i) {
            return "dovecot-$1";
        }
        return "dovecot-unknown";
    }

    # Generic fallback
    return $line =~ /cyrus/i ? "cyrus" : "other";
}
# ================== CONNECTION (multi-folder with backoff) ==================
sub connect_account {
    my ($name) = @_;
    my $acc = $accounts{$name} or return;

    log_info("=== Connecting account [$name] ===");

    my $success = eval {
	# temp connection just to check capabilities
	my ($tmp_socket, $tmp_imap) = create_imap_connection($name, $acc, $acc->{folders}[0]{name});
        my ($using_notify) = setup_notification($name, $tmp_imap, $acc->{folders});

	# Close the temporary objects (we will create fresh ones below)
	$tmp_imap->logout if $tmp_imap;
	$select->remove($tmp_socket) if $tmp_socket; # just in case

        if ($using_notify) {
            my $key = "$name:NOTIFY";
            my ($socket, $imap) = create_imap_connection($name, $acc, $acc->{folders}[0]{name});  # dummy select just to get objects
            my $conn = {
                key            => $key,
                name           => $name,
                imap           => $imap,
                mode           => 'NOTIFY',
                socket         => $socket,
                channel        => $acc->{mbsync_channel},
                wait           => $acc->{wait},
                last_event     => 0,
                folders        => $acc->{folders},
                backoff        => 5,          # seconds
                last_success   => time(),
            };
            $conns{$key} = $conn;
            $sock_to_key{$socket} = $key;
            $select->add($socket);
            log_info("[$name] -> NOTIFY mode (1 connection, " . scalar(@{$acc->{folders}}) . " folders)");
        } else {
            # IDLE fallback -> one independent connection per folder
            for my $f (@{$acc->{folders}}) {
                my ($socket, $imap) = create_imap_connection($name, $acc, $f->{name});
                my $tag = $imap->idle() or die "IDLE on $f->{name}: " . $imap->LastError;

                my $key = "$name:$f->{name}";
                my $conn = {
                    key            => $key,
                    name           => $name,
                    folder         => $f->{name},
                    imap           => $imap,
                    tag            => $tag,
                    mode           => 'IDLE',
                    debounce       => $f->{debounce},
                    last_event     => 0,
                    socket         => $socket,
                    channel        => $acc->{mbsync_channel},
                    wait           => $acc->{wait},
                    backoff        => 5,
                    last_success   => time(),
                };
                $conns{$key} = $conn;
                $sock_to_key{$socket} = $key;
                $select->add($socket);
                log_info("[$name] -> IDLE mode for folder $f->{name} (priority $f->{priority})");
            }
        }
        return 1;
    };

    if ($@) {
        my $err = $@; chomp $err;
        log_error("Connect failed [$name]: $err");
        return undef;
    }

    log_info("Monitoring active [$name] ($acc->{mbsync_channel})");
    return 1;
}

# ================== RESTART & PROCESS NOTIFICATION (already robust) ==================

# ================== RESTART (only for IDLE) ==================
sub restart_idle {
    my ($conn) = @_;
    return if $conn->{mode} eq 'NOTIFY';   # NOTIFY does not need re-arming

    eval {
        $conn->{imap}->done($conn->{tag}) if $conn->{tag};
        $conn->{tag} = $conn->{imap}->idle() or die $conn->{imap}->LastError;
        log_info("[$conn->{name}] IDLE successfully re-armed");
    };
    if ($@) {
        log_warn("restart_idle failed [$conn->{name}]: $@");
        # force reconnect on next housekeeping cycle
    }
}

sub reap_children { 1 while waitpid(-1, WNOHANG) > 0; }

# ================== MBSYNC ==================
sub trigger_mbsync {
    my ($channel) = @_;
    my $pid = fork();
    if ($pid == 0) {
        open STDIN,  '<', '/dev/null';
        open STDOUT, '>', '/dev/null';
        open STDERR, '>', '/dev/null';
        exec('/usr/local/bin/mbsync', $channel) or exit 1;
    } elsif ($pid > 0) {
        log_info("Forked mbsync '$channel' (pid $pid)");
    } else {
        log_error("fork failed: $!");
    }
}



sub process_notification {
    my ($conn) = @_;
    my $now = time();

    eval {
        my $any_data = 0;

        # Drain ALL pending IDLE/NOTIFY lines (critical fix)
        while (1) {
            my @data = $conn->{imap}->idle_data(2);   # short timeout per call
            last unless @data;                        # nothing left

            $any_data = 1;
            for my $line (@data) {
                chomp $line;
                log_info("[$conn->{name}] $line");
            }
        }

        if ($any_data) {
            # Your existing debounce + mbsync logic
            if ($now - $conn->{last_event} > ($conn->{debounce} // 180)) {
                if ($conn->{wait} > 0) {
                    log_info("[$conn->{name}] waiting $conn->{wait}s before mbsync");
                    sleep $conn->{wait};
                }
                log_info("[$conn->{name}] debounce passed → triggering mbsync $conn->{channel}");
                trigger_mbsync($conn->{channel});
                $conn->{last_event} = $now;
            } else {
                log_info("[$conn->{name}] notification grouped (debounce active)");
            }
        }

        # Re-arm IDLE (only needed for classic IDLE mode)
        restart_idle($conn) if $conn->{mode} eq 'IDLE';
    };

    if ($@) {
        log_warn("process_notification error [$conn->{name}]: $@");
    }
 }


# ================== DAEMONIZE ==================
sub daemonize {
    log_info("Daemonizing (double-fork + setsid)...");
    chdir '/' or die "chdir /: $!";
    umask 0;

    my $pid = fork(); exit if $pid;
    die "first fork failed: $!" unless defined $pid;

    setsid() or die "setsid: $!";

    $pid = fork(); exit if $pid;
    die "second fork failed: $!" unless defined $pid;

    close STDIN; close STDOUT; close STDERR;
    open STDIN,  '<', '/dev/null';
    open STDOUT, '>', '/dev/null';
    open STDERR, '>', '/dev/null';

    log_info("Daemonized successfully (pid $$)");
}

# ================== GRACEFUL SHUTDOWN ==================
sub graceful_shutdown {
    log_info("SIGTERM/INT received – shutting down gracefully...");
    for my $key (keys %conns) {
        my $conn = $conns{$key};
        next unless $conn && $conn->{tag};
        eval { $conn->{imap}->done($conn->{tag}); };
    }
    closelog();
    exit 0;
}

# ================== HOUSEKEEPING (with exponential backoff) ==================
sub housekeeping {
    my $now = time();
    for my $key (keys %conns) {
        my $conn = $conns{$key};
        next unless $conn;

        # detect dead connection
        if (!$conn->{imap}->IsConnected || !$conn->{imap}->noop) {
            log_warn("[$conn->{name}] connection lost – reconnecting in $conn->{backoff}s");
            $select->remove($conn->{socket});
            delete $sock_to_key{$conn->{socket}};
            delete $conns{$key};

            sleep $conn->{backoff};
            $conn->{backoff} = int($conn->{backoff} * 1.5 + 0.5);  # exponential backoff
            connect_account($conn->{name});   # will recreate with fresh backoff on success
            next;
        }

        # reset backoff on healthy connection
        if ($now - $conn->{last_success} > 300) {   # every 5 min
            $conn->{backoff} = 5;
            $conn->{last_success} = $now;
        }

        # periodic IDLE refresh for classic mode
        restart_idle($conn) if $conn->{mode} eq 'IDLE';
    }
}

# ================== MAIN LOOP ==================
sub main_loop {
    log_info("Entering main IO::Select loop");
    while (1) {
        my @ready = $select->can_read(30);
        housekeeping();   # every 30 s

        for my $sock (@ready) {
            my $key = $sock_to_key{$sock};
            process_notification($conns{$key}) if $key;
        }
    }
}

# ================== STARTUP ==================
$SIG{CHLD} = \&reap_children;
$SIG{TERM} = \&graceful_shutdown;
$SIG{INT}  = \&graceful_shutdown;

load_config();

for my $name (keys %accounts) {
    connect_account($name) or die "Aborting — could not connect to [$name]";
}

daemonize();          # ← now enabled
main_loop();

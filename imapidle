    return unless $accounts{$name};
    $accounts{$name}{next_try} = $when;
}

sub plant_idle_for_test {
    my ($name, $folder, $debounce, $channel) = @_;
    my $key = "$name:$folder";
    $conns{$key} = {
        key      => $key,
        name     => $name,
        folder   => $folder,
        mode     => 'IDLE',
        debounce => $debounce,
        channel  => $channel,
        wait     => 0,
    };

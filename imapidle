# not treated as stale. The log keeps the channel name. The account
# is named for the channel so the log column stays that width.
sub claim_channel_for_test {
    my ($channel) = @_;
    return 0 unless defined $channel && $channel ne '';
    return 1 if channel_claimed($channel);
    my $name = $channel;
    $name =~ s/[^A-Za-z0-9_.-]/_/g;
    $name = 'ch' if $name eq '';
    my $base = $name;
    my $n = 2;
    while (exists $accounts{$name}) {
        $name = "$base-$n";
        $n++;
    }
    $accounts{$name} = {
        server          => '',
        port            => 993,
        proto           => 'tls',
        user            => '',
        mbsync_channel  => $channel,
        auth            => 'login',
        role            => 'account',
        folders         => [],
        wait            => 0,
        poll            => 60,
        hook            => '',
        backoff         => 5,
        next_try        => 0,
        fails           => 0,
        up              => 0,
        disabled        => 1,
        config_disabled => 1,
    };
    return 1;
}
